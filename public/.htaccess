Options -MultiViews

# Allow long-term caching for versioned assets (they have content hashes in filenames)
<FilesMatch "\.(js|css|png|svg|woff2|jpg|jpeg|gif|ico|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# Never cache the PWA critical files or version.json (the "new version available" check), so updates show up
# immediately. This MUST stay after the generic rule above: Apache applies <FilesMatch> sections in order and
# the later "Header set" wins, so here sw.js / registerSW.js / workbox-*.js lose the "immutable" .js rule.
<FilesMatch "^(sw\.js|index\.html|manifest\.webmanifest|registerSW\.js|workbox-.+\.js|version\.json)$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
</FilesMatch>

# Contact Us widget files are embedded on customers' sites. The generic .js rule above marks every
# .js file immutable for a year, which would strand customers on a stale loader — keep these short.
<FilesMatch "^(widget-loader\.js|widget-embed\.js|widget-core\.js|widget-embed\.html)$">
    Header set Cache-Control "public, max-age=300"
</FilesMatch>

# The embed page is loaded inside an iframe on other companies' websites.
<FilesMatch "^widget-embed\.html$">
    Header always unset X-Frame-Options
    Header set Content-Security-Policy "frame-ancestors *"
</FilesMatch>

# Deep-link verification files must serve as application/json.
# The Apple file has no extension, so force its Content-Type explicitly.
<Files "apple-app-site-association">
    ForceType application/json
    Header set Content-Type "application/json"
</Files>

RewriteEngine On

# Never route the .well-known deep-link files through the SPA fallback
RewriteRule ^\.well-known/ - [L]

# Proxy /s3-proxy/* to S3 so image cropping works (canvas CORS fix)
RewriteCond %{REQUEST_URI} ^/s3-proxy/
RewriteRule ^s3-proxy/(.*)$ https://stasht-data.s3.us-east-2.amazonaws.com/$1 [P,L]

# SPA fallback — send all non-file requests to index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]
