        }
      } else {
        // For regular user collaborators
        const userIdToUpdate = collaborator?.userId || collaboratorId;
        console.log(`User ID to update: ${userIdToUpdate}`);
        console.log(`API URL: /memories/${memoryId}/edit-collaborator-role`);

        // Use the existing editCollaboratorRole API
        response = await dashboardAPI.editCollaboratorRole(memoryId, userIdToUpdate, newRole);
      }

      // Check if the API call was successful
      console.log(`✅ Role update API response:`, response);

      // Handle response - check for success
      if (response && (response.success === true || response.status === 1)) {
        toast.success("Collaborator role updated!");

        // Wait 1 second for backend to process
        await new Promise(resolve => setTimeout(resolve, 1000));

        // Reload only the memory data
        await fetchMemoryDetails();
        await fetchMemoryActivity();

        // Force re-render
        setRefreshTrigger(prev => prev + 1);
      } else {
        // Handle error response
        const errorMessage = response?.message || response?.error || "Failed to update collaborator role";
        console.error(`❌ Role update failed:`, errorMessage);
        toast.error(errorMessage);
      }
    } catch (error) {
      console.error('🔥 Error updating collaborator role:', error);
      toast.error("Failed to update collaborator role");
    }

    console.log(`=== END UPDATING COLLABORATOR ROLE ===`);
  };

  // Media section handlers
  const handleMediaItemToggle = (id: string) => {
    setSelectedItems(prev => 
      prev.includes(id) 
        ? prev.filter(item => item !== id)
        : [...prev, id]
    );
  };

  const handleMediaItemView = (item: any) => {
    console.log('Viewing media item:', item);
    // Implement view logic
  };

  const handleTimelineImageView = (src: string, alt: string, title?: string, subtitle?: string, imageId?: string) => {
    console.log(`🖼️ handleTimelineImageView called with imageId: ${imageId}`);

    // Find the clicked post first to check if it's a sub-image
    const clickedPost = sortedTimelinePosts.find(post => post.id === imageId || post.image === src);
    console.log(`🔍 Found clicked post:`, clickedPost);
    console.log(`🔍 Clicked post has parent_id:`, clickedPost?.parent_id);

    // Check if this is a sub-image (has parent_id)
    let actualImageId = imageId;
    let subImageId: string | undefined;
    let parentPost: any = null;

    if (clickedPost && clickedPost.parent_id) {
      console.log(`🔗 Sub-image clicked: ${clickedPost.id}, parent: ${clickedPost.parent_id}`);
      subImageId = clickedPost.id; // Remember the sub-image that was clicked
      actualImageId = clickedPost.parent_id; // Use parent ID to open viewer

      // Find the parent post - try sortedTimelinePosts first, then fall back to rawApiPosts
      parentPost = sortedTimelinePosts.find(post => post.id === clickedPost.parent_id);

      if (!parentPost && rawApiPosts) {
        // Parent might not be in sortedTimelinePosts, search in rawApiPosts
        const rawParent = rawApiPosts.find((post: any) => post.id === clickedPost.parent_id);
        if (rawParent) {
          // Transform raw API post to match the structure expected
          parentPost = {
            id: rawParent.id,
            image: rawParent.image_link ? rawParent.image_link.replace(/\\\//g, '/') : (rawParent.image || rawParent.image_url || ''),
            name: rawParent.name || rawParent.title,
            title: rawParent.name || rawParent.title,
            author: rawParent.author || { name: 'Unknown' },
            date: rawParent.capture_date || rawParent.created_at,
            location: rawParent.location,
            description: rawParent.description,
            rotation_angle: rawParent.rotation_angle
          };
          console.log(`📌 Found parent post in rawApiPosts:`, parentPost);
        }
      } else if (parentPost) {
        console.log(`📌 Found parent post in sortedTimelinePosts:`, parentPost);
      }

      if (!parentPost) {
        console.error(`❌ Could not find parent post with id ${clickedPost.parent_id}`);
        console.log(`📋 Available post IDs in sortedTimelinePosts:`, sortedTimelinePosts.map(p => p.id));
        console.log(`📋 Available post IDs in rawApiPosts:`, rawApiPosts?.map((p: any) => p.id));
      }
    } else {
      console.log(`✅ Regular image clicked (no parent_id): ${imageId}`);
    }

    // Build the images array from current timeline posts for carousel functionality
    // Filter out sub-images (posts with parent_id) to only show parent images in the timeline carousel
    const allImages = sortedTimelinePosts
      .filter(post => post.image && !post.parent_id) // Only include parent images, not sub-images
      .map((post: any) => ({
        src: post.image,
        alt: post.name || post.title || 'Image',
        title: post.name || post.title || 'Image',
        subtitle: `${post.author.name} • ${formatDate(post.date)}`,
        id: post.id
      }));

    // Find the current image index by actualImageId or src
    const currentIndex = actualImageId
      ? allImages.findIndex((img: any) => img.id === actualImageId)
      : allImages.findIndex((img: any) => img.src === src);

    const finalImageId = actualImageId || allImages[Math.max(0, currentIndex)]?.id;

    // Find the current post to extract metadata (use parent post if it's a sub-image)
    const currentPost = parentPost || sortedTimelinePosts.find(post => post.id === finalImageId || post.image === src);
    
    // Extract filename from src URL or use title
    const extractFilename = (url: string, postTitle?: string) => {
      if (postTitle && postTitle !== 'Post content') return postTitle;
      const urlParts = url.split('/');
      const filename = urlParts[urlParts.length - 1];
      return filename.includes('.') ? filename : 'Timeline Image';
    };

    // Format location display similar to media section
    const getLocationDisplay = (location?: string) => {
      if (!location) return '';
      return location;
    };

    // Format date similar to media section  
    const getFormattedDate = (date?: string) => {
      if (!date) return '';
      try {
        return formatDate(date);
      } catch {
        return date;
      }
    };
    
    // Extract the current image data
    const currentImage = allImages[Math.max(0, currentIndex)];

    // If a sub-image was clicked, use the parent post's data
    const displaySrc = parentPost ? parentPost.image : (currentImage?.src || src);
    const displayAlt = parentPost ? (parentPost.name || parentPost.title || 'Image') : (currentImage?.alt || alt);
    const displayTitle = parentPost ? (parentPost.name || parentPost.title) : (currentImage?.title || title || currentPost?.title);

    // Check if parent image is featured
    const parentIsFeatured = currentPost?.is_featured === 1 || currentPost?.is_featured === true;
    console.log('🌟 Parent image is_featured:', parentIsFeatured, 'currentPost.is_featured:', currentPost?.is_featured);

    // Open the ImageViewer modal with proper timeline metadata
    console.log('🔍 handleTimelineImageView - finalImageId:', finalImageId, 'memoryId:', memoryId);
    const viewerData = {
      isOpen: true,
      src: displaySrc,
      alt: displayAlt,
      title: displayTitle,
      subtitle: `${currentPost?.author?.name || 'Unknown'} • ${getFormattedDate(currentPost?.date)}`,
      filename: extractFilename(displaySrc, currentPost?.title),
      dateTaken: getFormattedDate(currentPost?.date),
      location: getLocationDisplay(currentPost?.location),
      images: allImages,
      currentIndex: Math.max(0, currentIndex),
      imageId: finalImageId,
      memoryId: memoryId, // CRITICAL FIX: Include memoryId in the viewer state
      rotation_angle: currentPost?.rotation_angle || 0,
      initialSubImageId: subImageId, // Pass the sub-image ID if a sub-image was clicked
      parentImageIsFeatured: parentIsFeatured // Pass parent's featured status
    };

    console.log('🎯 VIEWER DATA BEFORE SET:', JSON.stringify({ imageId: viewerData.imageId, memoryId: viewerData.memoryId }));

    if (subImageId) {
      console.log(`📸 Opening viewer with parent ${finalImageId}, will select sub-image ${subImageId}`);
      console.log(`📸 Parent image src: ${displaySrc}`);
    }

    setImageViewer(viewerData);
  };

  const handleImageView = (src: string, alt: string, title?: string, subtitle?: string, imageId?: string) => {
    console.log(`🖼️ handleImageView called with imageId: ${imageId}`);

    // Find the clicked media item first to check if it's a sub-image
    const clickedItem = filteredAndSortedMediaItems.find(item =>
      item.id === imageId || item.image === src || item.thumbnail === src
    );
    console.log(`🔍 Found clicked item:`, clickedItem);
    console.log(`🔍 Clicked item has parent_id:`, clickedItem?.parent_id);

    // Check if this is a sub-image (has parent_id)
    let actualImageId = imageId;
    let subImageId: string | undefined;
    let parentItem: any = null;

    if (clickedItem && clickedItem.parent_id) {
      console.log(`🔗 Sub-image clicked in media: ${clickedItem.id}, parent: ${clickedItem.parent_id}`);
      subImageId = clickedItem.id; // Remember the sub-image that was clicked
      actualImageId = clickedItem.parent_id; // Use parent ID to open viewer

      // Find the parent item - try filteredAndSortedMediaItems first, then fall back to rawApiPosts
      parentItem = filteredAndSortedMediaItems.find(item => item.id === clickedItem.parent_id);

      if (!parentItem && rawApiPosts) {
        // Parent might not be in filteredAndSortedMediaItems, search in rawApiPosts
        const rawParent = rawApiPosts.find((post: any) => post.id === clickedItem.parent_id);
        if (rawParent) {
          // Transform raw API post to match the structure expected
          parentItem = {
            id: rawParent.id,
            image: rawParent.image_link ? rawParent.image_link.replace(/\\\//g, '/') : (rawParent.image || rawParent.image_url || ''),
            thumbnail: rawParent.image_link ? rawParent.image_link.replace(/\\\//g, '/') : (rawParent.image || rawParent.image_url || ''),
            name: rawParent.name || rawParent.title,
            title: rawParent.name || rawParent.title,
            date: rawParent.capture_date || rawParent.created_at,
            location: rawParent.location,
            size: rawParent.size || 'Unknown size',
            rotation_angle: rawParent.rotation_angle
          };
          console.log(`📌 Found parent item in rawApiPosts:`, parentItem);
        }
      } else if (parentItem) {
        console.log(`📌 Found parent item in filteredAndSortedMediaItems:`, parentItem);
      }

      if (!parentItem) {
        console.error(`❌ Could not find parent item with id ${clickedItem.parent_id}`);
        console.log(`📋 Available item IDs in filteredAndSortedMediaItems:`, filteredAndSortedMediaItems.map(i => i.id));
        console.log(`📋 Available post IDs in rawApiPosts:`, rawApiPosts?.map((p: any) => p.id));
      }
    } else {
      console.log(`✅ Regular image clicked (no parent_id): ${imageId}`);
    }

    // Build the images array from current media items for carousel functionality
    // Filter out sub-images (items with parent_id) to only show parent images in the media carousel
    const allImages = filteredAndSortedMediaItems
      .filter(item => (item.image || item.thumbnail) && !item.parent_id) // Only include parent images, not sub-images
      .map((item: any) => ({
        src: item.image || item.thumbnail,
        alt: item.name || 'Image',
        title: item.name || 'Image',
        subtitle: `${item.size || 'Unknown size'} • ${formatDate(item.date)}`,
        id: item.id
      }));

    // Find the current image index by actualImageId or src
    const currentIndex = actualImageId
      ? allImages.findIndex((img: any) => img.id === actualImageId)
      : allImages.findIndex((img: any) => img.src === src);

    const finalImageId = actualImageId || allImages[Math.max(0, currentIndex)]?.id;

    // Find the current media item to extract metadata (use parent item if it's a sub-image)
    const currentMediaItem = parentItem || filteredAndSortedMediaItems.find(item =>
      item.id === finalImageId || item.image === src || item.thumbnail === src
    );

    // Extract filename from src URL or use title
    const extractFilename = (url: string, itemTitle?: string) => {
      if (itemTitle && itemTitle !== 'Memory Image') return itemTitle;
      const urlParts = url.split('/');
      const filename = urlParts[urlParts.length - 1];
      return filename.includes('.') ? filename : 'Image';
    };

    // Format location display for media items
    const getLocationDisplay = (location?: any) => {
      if (!location) return '';

      if (typeof location === 'string') {
        return location;
      }

      if (typeof location === 'object') {
        const loc = location;
        if (loc.city && loc.country) return `${loc.city}, ${loc.country}`;
        if (loc.displayName) return loc.displayName;
        if (loc.city) return loc.city;
        if (loc.country) return loc.country;
      }

      return '';
    };

    // Format date for media items
    const getFormattedDate = (date?: string) => {
      if (!date) return '';
      try {
        return formatDate(date);
      } catch {
        return date;
      }
    };

    // Extract the current image data
    const currentImage = allImages[Math.max(0, currentIndex)];

    // If a sub-image was clicked, use the parent item's data
    const displaySrc = parentItem ? (parentItem.image || parentItem.thumbnail) : (currentImage?.src || src);
    const displayAlt = parentItem ? (parentItem.name || parentItem.title || 'Image') : (currentImage?.alt || alt);
    const displayTitle = parentItem ? (parentItem.name || parentItem.title) : (currentImage?.title || title || currentMediaItem?.name);

    // Check if parent image is featured
    const parentIsFeatured = currentMediaItem?.is_featured === 1 || currentMediaItem?.is_featured === true;
    console.log('🌟 Parent image is_featured:', parentIsFeatured, 'currentMediaItem.is_featured:', currentMediaItem?.is_featured);

    // Open the ImageViewer modal with proper media metadata
    console.log('🔍 handleImageView - finalImageId:', finalImageId, 'memoryId:', memoryId);
    const viewerData = {
      isOpen: true,
      src: displaySrc,
      alt: displayAlt,
      title: displayTitle,
      subtitle: `${currentMediaItem?.size || 'Unknown size'} • ${getFormattedDate(currentMediaItem?.date)}`,
      filename: extractFilename(displaySrc, currentMediaItem?.name),
      dateTaken: getFormattedDate(currentMediaItem?.date),
      location: getLocationDisplay(currentMediaItem?.location),
      images: allImages,
      currentIndex: Math.max(0, currentIndex),
      imageId: finalImageId,
      memoryId: memoryId, // CRITICAL: Include memoryId in the viewer state
      rotation_angle: currentMediaItem?.rotation_angle || 0,
      initialSubImageId: subImageId, // Pass the sub-image ID if a sub-image was clicked
      parentImageIsFeatured: parentIsFeatured // Pass parent's featured status
    };

    console.log('🎯 VIEWER DATA BEFORE SET:', JSON.stringify({ imageId: viewerData.imageId, memoryId: viewerData.memoryId }));

    if (subImageId) {
      console.log(`📸 Opening viewer with parent ${finalImageId}, will select sub-image ${subImageId}`);
      console.log(`📸 Parent image src: ${displaySrc}`);
    }

    setImageViewer(viewerData);
  };

  const handleCloseImageViewer = () => {
    setImageViewer({
      isOpen: false,
      src: '',
      alt: '',
      title: '',
      subtitle: '',
      filename: '',
      dateTaken: '',
      location: '',
      images: [],
      currentIndex: 0,
      imageId: '',
      memoryId: undefined,
      rotation_angle: 0
    });

    // If modal was opened from a post link, navigate back to memories list
    const openedFromPostLink = sessionStorage.getItem('openedFromPostLink');
    if (openedFromPostLink === 'true') {
      console.log('🔙 Modal was opened from POST LINK - navigating to memories list');
      sessionStorage.removeItem('openedFromPostLink');
      sessionStorage.removeItem('globalProtectedUrl'); // Clear global URL protection
      sessionStorage.removeItem('preservePostUrl'); // Clear URL preservation
      sessionStorage.removeItem('pendingPostView'); // Clear pending post data
      console.log('🧹 Cleared all post link data');

      // Set flag to indicate this is a post link close (so handleBackFromMemory knows to navigate)
      sessionStorage.setItem('closeFromPostLink', 'true');

      // Navigate back to memories list
      if (onBack) {
        onBack();
      }
    } else {
      console.log('ℹ️ Modal opened NORMALLY - just closing, staying on current page');
    }
  };

  const handleNextImage = () => {
    if (imageViewer.currentIndex < imageViewer.images.length - 1) {
      const nextIndex = imageViewer.currentIndex + 1;
      const nextImage = imageViewer.images[nextIndex];

      // Find the corresponding media item to get rotation_angle
      const nextMediaItem = filteredAndSortedMediaItems.find(item =>
        item.id === nextImage.id || item.image === nextImage.src || item.thumbnail === nextImage.src
      );

      // Extract filename from next image
      const extractFilename = (url: string, altText?: string) => {
        if (altText && altText !== 'Memory Image') return altText;
        const urlParts = url.split('/');
        const filename = urlParts[urlParts.length - 1];
        return filename.includes('.') ? filename : 'Image';
      };

      setImageViewer(prev => ({
        ...prev,
        src: nextImage.src,
        alt: nextImage.alt,
        title: nextImage.title,
        subtitle: nextImage.subtitle,
        filename: extractFilename(nextImage.src, nextImage.alt),
        currentIndex: nextIndex,
        imageId: nextImage.id,
        rotation_angle: nextMediaItem?.rotation_angle || 0
      }));
    }
  };

  const handlePrevImage = () => {
    if (imageViewer.currentIndex > 0) {
      const prevIndex = imageViewer.currentIndex - 1;
      const prevImage = imageViewer.images[prevIndex];

      // Find the corresponding media item to get rotation_angle
      const prevMediaItem = filteredAndSortedMediaItems.find(item =>
        item.id === prevImage.id || item.image === prevImage.src || item.thumbnail === prevImage.src
      );

      // Extract filename from previous image
      const extractFilename = (url: string, altText?: string) => {
        if (altText && altText !== 'Memory Image') return altText;
        const urlParts = url.split('/');
        const filename = urlParts[urlParts.length - 1];
        return filename.includes('.') ? filename : 'Image';
      };

      setImageViewer(prev => ({
        ...prev,
        src: prevImage.src,
        alt: prevImage.alt,
        title: prevImage.title,
        subtitle: prevImage.subtitle,
        filename: extractFilename(prevImage.src, prevImage.alt),
        currentIndex: prevIndex,
        imageId: prevImage.id,
        rotation_angle: prevMediaItem?.rotation_angle || 0
      }));
    }
  };

  const handleToggleImageSelection = () => {
    if (imageViewer.imageId) {
      handleMediaItemToggle(imageViewer.imageId);
    }
  };

  // Handle custom prompt generation
  const handleCustomPromptGeneration = async () => {
    try {
      console.log('Custom Prompt Generation: Starting...');
      setIsGeneratingFromPrompt(true);

      console.log('🔍 === ANALYZING aiAnalysisData STRUCTURE ===');
      console.log('Custom Prompt Generation: aiAnalysisData available:', !!aiAnalysisData);

      if (aiAnalysisData) {
        console.log('📦 Full aiAnalysisData structure:', JSON.stringify(aiAnalysisData, null, 2));
        console.log('🔑 aiAnalysisData keys:', Object.keys(aiAnalysisData));
        console.log('📊 aiAnalysisData.results exists:', !!aiAnalysisData.results);
        console.log('📊 aiAnalysisData.results type:', Array.isArray(aiAnalysisData.results) ? 'array' : typeof aiAnalysisData.results);

        if (aiAnalysisData.results) {
          console.log('📊 aiAnalysisData.results length:', aiAnalysisData.results.length);
          if (Array.isArray(aiAnalysisData.results) && aiAnalysisData.results.length > 0) {
            console.log('📊 First results item structure:', JSON.stringify(aiAnalysisData.results[0], null, 2));
            console.log('📊 First results item keys:', Object.keys(aiAnalysisData.results[0]));
          }
        }
      }

      // Prepare memory data from filtered media items
      const memoryData = filteredAndSortedMediaItems.map((item, index) => {
        const fileUrl = item.image || item.thumbnail;
        console.log(`\n📸 Processing photo ${index + 1}/${filteredAndSortedMediaItems.length}: ${fileUrl}`);

        // Default to empty labels
        let labels: string[] = [];

        // Get labels from aiAnalysisData.results if available (NOTE: it's "results" not "result")
        if (aiAnalysisData && aiAnalysisData.results && Array.isArray(aiAnalysisData.results)) {
          console.log(`  🔍 Searching for labels in aiAnalysisData.results (${aiAnalysisData.results.length} items)`);

          // Log all result items to help debug
          aiAnalysisData.results.forEach((r: any, idx: number) => {
            console.log(`    ${idx + 1}. Result item file: "${r.file}"`);
            console.log(`       Has labels: ${!!r.labels}, Labels count: ${r.labels?.length || 0}`);
            if (r.labels && r.labels.length > 0) {
              console.log(`       Labels: ${JSON.stringify(r.labels.slice(0, 5))}...`); // Show first 5 labels
            }
          });

          // Find matching photo in results array
          const photoResult = aiAnalysisData.results.find((r: any) => {
            // The API response uses "file" field with escaped slashes
            const resultFile = r.file.replace(/\\\//g, '/'); // Remove escaped slashes

            // Try exact match first
            if (resultFile === fileUrl) {
              console.log(`  ✅ Exact URL match found for: ${fileUrl}`);
              return true;
            }

            // Try matching just the filename
            const fileUrlName = fileUrl.split('/').pop();
            const resultFileName = resultFile.split('/').pop();
            if (fileUrlName === resultFileName) {
              console.log(`  ✅ Filename match found: ${fileUrlName}`);
              return true;
            }

            return false;
          });

          if (photoResult) {
            console.log(`  ✅ Found matching result item for ${fileUrl}`);
            console.log(`     Result has ${photoResult.labels?.length || 0} labels`);
            if (photoResult.labels && Array.isArray(photoResult.labels)) {
              labels = photoResult.labels;
              console.log(`  ✅ Extracted ${labels.length} labels:`, labels);
            } else {
              console.warn(`  ⚠️ Result item has no labels or labels is not an array`);
              console.log(`     Result item keys:`, Object.keys(photoResult));
            }
          } else {
            console.warn(`  ⚠️ No matching result found for file: ${fileUrl}`);
            console.warn(`     Searched in ${aiAnalysisData.results.length} results`);
          }
        } else {
          console.warn(`  ⚠️ aiAnalysisData.results not available or not an array`);
          if (aiAnalysisData) {
            console.warn(`     Available keys in aiAnalysisData:`, Object.keys(aiAnalysisData));
          }
        }

        console.log(`  📋 Final labels for this photo: ${labels.length} labels -`, labels.length > 0 ? JSON.stringify(labels.slice(0, 3)) + '...' : '[]');

        return {
          file: fileUrl,
          labels: labels
        };
      });

      console.log('Custom Prompt Generation: Memory data prepared:', memoryData);
      console.log('Custom Prompt Generation: Total photos:', memoryData.length);
      console.log('Custom Prompt Generation: Photos with labels:', memoryData.filter(m => m.labels.length > 0).length);
      console.log('Custom Prompt Generation: Prompt:', customPrompt.trim());

      // Step 1: Call the first API to get AI response
      const response = await dashboardAPI.createMemoryFromSentence(customPrompt.trim(), memoryData);
      console.log('Custom Prompt Generation: API response:', response);

      if (response.success) {
        // Store the AI response data
        setAiResponseData(response.data);
        console.log('AI Response received, showing matches...', response.data);

        // Here you would typically show the matches/results to the user
        // For now, we'll automatically proceed to step 2 after showing success
        toast.success("AI analysis completed! Creating memory...");

        // Step 2: Call the second API to create memory from AI response
        // Pass the entire response.data object as ai_response
        const createResponse = await dashboardAPI.createMemoryFromAIResponse(response.data);
        console.log('Create Memory from AI Response: API response:', createResponse);

        if (createResponse.success) {
          toast.success("Custom memory organization created successfully!");
          setIsAIResultsModalOpen(false);
          setCustomPrompt('');
          setSelectedAnalysisOption(null);
          setAiResponseData(null);

          // Refresh the memory details to show updated organization
          await fetchMemoryDetails();
        } else {
          toast.error(createResponse.error || "Failed to create memory from AI response");
        }
      } else {
        toast.error(response.error || "Failed to create custom memory organization");
      }
    } catch (error) {
      console.error('Custom Prompt Generation error:', error);
      toast.error("Failed to process custom prompt. Please try again.");
    } finally {
      setIsGeneratingFromPrompt(false);
    }
  };

  const handleUpdateItem = async (id: string, updates: any) => {
    console.log('🟢 ===  handleUpdateItem CALLED ===');
    console.log('🟢 Item ID:', id);
    console.log('🟢 Updates received:', JSON.stringify(updates, null, 2));
    
    try {
      // Prepare the update data for API
      const updateData: any = {};
      
      // Add metadata fields only if they have values
      if (updates.name !== undefined && updates.name.trim() !== '') {
        updateData.name = updates.name;
      }

      // Handle title - send it even if empty to allow clearing the title
      if (updates.title !== undefined) {
        updateData.title = updates.title;
      }

      if (updates.description !== undefined && updates.description.trim() !== '') {
        updateData.description = updates.description;
      }

      if (updates.capture_date !== undefined && updates.capture_date.trim() !== '') {
        updateData.capture_date = updates.capture_date;
      }

      if (updates.location?.displayName !== undefined && updates.location.displayName.trim() !== '') {
        updateData.location = updates.location.displayName;
      }

      if (updates.labels !== undefined && updates.labels.length > 0) {
        updateData.tags = updates.labels;
      }

      // Add parent_image_id if provided (can be string or null to remove parent)
      if (updates.parent_image_id !== undefined) {
        updateData.parent_image_id = updates.parent_image_id;
        console.log('🔵 MemoryDetailsPage: Including parent_image_id in API call:', {
          receivedValue: updates.parent_image_id,
          willSendToAPI: updateData.parent_image_id,
          type: typeof updates.parent_image_id
        });
      } else {
        console.log('⚠️ MemoryDetailsPage: parent_image_id is undefined, NOT including in API call');
      }

      // Add photo if provided
      if (updates.newPhoto) {
        console.log('Including photo in update:', updates.newPhoto.name);
        updateData.image = updates.newPhoto;
      }
      
      console.log('Sending API update with data:', updateData);
      
      // Only call API if there's something to update
      if (Object.keys(updateData).length === 0) {
        console.log('No changes to save');
        toast.info("No changes to save");
        return;
      }
      
      // Call the API to update memory images - use the post/item ID, not memory ID
      console.log('🔵 Calling API updateMemoryImages...');
      const response = await dashboardAPI.updateMemoryImages(id, updateData);
      console.log('🔵 API Response:', response);

      if (response.success) {
        console.log('✅ Item updated successfully:', response.data);
        toast.success("Photo updated successfully!");

        // Force re-fetch memory details to get updated data
        setApiMemoryData(null); // Clear current data to force re-render
        await fetchMemoryDetails(false); // Fetch fresh data with loading state
      } else {
        console.error('❌ Failed to update item:', response.error);
        toast.error(response.error || "Failed to update photo");
      }
    } catch (error) {
      console.error('🔥 Error updating item:', error);
      toast.error("Network error. Please try again.");
    }
    
    console.log('=== END UPDATING MEDIA ITEM ===');
  };

  const handleDeleteItem = (id: string) => {
    console.log('Delete item requested:', id);
    setItemToDelete(id);
    setShowDeleteItemDialog(true);
  };

  const handleDeleteItemConfirm = async () => {
    if (!itemToDelete) return;
    
    setIsDeletingItem(true);
    try {
      console.log(`Deleting media item ${itemToDelete}...`);
      
      // Call the single image delete API
      const response = await mediaAPI.deleteImage(itemToDelete);
      
      if (response.success) {
        console.log('Media item deleted successfully');
        setShowDeleteItemDialog(false);
        setItemToDelete(null);
        toast.success("Image deleted successfully!");

        // Trigger memory counts refresh since we deleted media
        await triggerMemoryCountsRefresh();

        // Refresh memory details to update the media list (local refresh only, no full page reload)
        await fetchMemoryDetails();
        await fetchMemoryActivity();

        // NOTE: We intentionally do NOT call onRefresh() or onRefreshMedia() here
        // Deleting a single image is a minor action and should not trigger a full reload
        // of all memories data. Only the current memory details are refreshed.
      } else {
        console.error('Failed to delete media item:', response.error);
        toast.error(`Failed to delete image: ${response.error || 'Unknown error'}`);
      }
    } catch (error) {
      console.error('Error deleting media item:', error);
      toast.error('An error occurred while deleting the image');
    } finally {
      setIsDeletingItem(false);
    }
  };

  const handlePhotoChange = async (id: string, newPhoto: File): Promise<void> => {
    console.log('=== CHANGING PHOTO ===');
    console.log('Item ID:', id);
    console.log('New Photo:', newPhoto.name, newPhoto.size, newPhoto.type);
    
    try {
      // Call the API to update the memory with new photo - use the post/item ID, not memory ID
      const response = await dashboardAPI.updateMemoryImages(id, {
        image: newPhoto
      });
      
      if (response.success) {
        console.log('✅ Photo changed successfully:', response.data);
        toast.success("Photo updated successfully!");

        // Don't immediately refresh to avoid jarring UI changes
        // Refresh data in background after a short delay
        setTimeout(() => {
          fetchMemoryDetails();
          fetchMemoryActivity();

          // Refresh memories list on parent page
          if (onRefresh) {
            onRefresh();
          }
        }, 300);
      } else {
        console.error('❌ Failed to change photo:', response.error);
        toast.error(response.error || "Failed to update photo");
        throw new Error(response.error || "Failed to update photo");
      }
    } catch (error) {
      console.error('🔥 Error changing photo:', error);
      toast.error("Network error. Please try again.");
      throw error;
    }
    
    console.log('=== END CHANGING PHOTO ===');
  };

  const handleUploadPhotos = () => {
    setIsAddMomentModalOpen(true);
  };

  const handleDeleteItems = async (items: string[]) => {
    setIsDeletingItems(true);
    setDeleteProgress(0);

    try {
      console.log('Deleting items:', items);

      // Simulate progress
      const progressInterval = setInterval(() => {
        setDeleteProgress(prev => {
          if (prev >= 90) return 90; // Stop at 90% until API completes
          return prev + 10;
        });
      }, 100);

      // Call the delete multiple API
      const response = await dashboardAPI.deleteMultiplePosts(items);

      // Clear interval and set to 100%
      clearInterval(progressInterval);
      setDeleteProgress(100);

      if (response.success) {
        // Add deleted items to the deletedPosts set
        setDeletedPosts(prev => {
          const newSet = new Set(prev);
          items.forEach(id => newSet.add(id));
          return newSet;
        });

        // Clear selection
        setSelectedItems([]);

        toast.success(`${items.length} ${items.length === 1 ? 'item' : 'items'} deleted successfully`);

        // Wait a moment to show 100% progress, then reload
        setTimeout(async () => {
          // Refresh memory details to update the display
          await fetchMemoryDetails();
          await fetchMemoryActivity();

          // Reset deletion state
          setIsDeletingItems(false);
          setDeleteProgress(0);
        }, 500);
      } else {
        setIsDeletingItems(false);
        setDeleteProgress(0);
        toast.error(response.error || "Failed to delete items");
      }
    } catch (error) {
      console.error('Error deleting items:', error);
      setIsDeletingItems(false);
      setDeleteProgress(0);
      toast.error("Failed to delete items");
    }
  };

  const handleAddToMemory = (items: string[], memoryId?: string, memoryTitle?: string, category?: string) => {
    console.log('Adding items to memory:', items, memoryId, memoryTitle, category);
    toast.success(`${items.length} items added to memory`);
  };

  const handleMoveItems = (items: string[], category: string) => {
    console.log('Moving items to category:', items, category);
    toast.success(`${items.length} items moved to ${category}`);
  };

  const getRoleColor = (role: string) => {
    switch (role) {
      case 'admin': return 'bg-red-100 text-red-700 border-red-200';
      case 'edit':
      case 'contributor': return 'bg-blue-100 text-blue-700 border-blue-200';
      case 'view':
      case 'viewer': return 'bg-gray-100 text-gray-700 border-gray-200';
      default: return 'bg-gray-100 text-gray-700 border-gray-200';
    }
  };

  const getRoleIcon = (role: string) => {
    switch (role) {
      case 'admin': return <Shield className="w-3 h-3" />;
      case 'edit':
      case 'contributor': return <Edit className="w-3 h-3" />;
      case 'view':
      case 'viewer': return <Eye className="w-3 h-3" />;
      default: return null;
    }
  };

  const getRoleDisplayName = (role: string) => {
    switch (role) {
      case 'admin': return 'Admin';
      case 'edit':
      case 'contributor': return 'Contributor';
      case 'view':
      case 'viewer': return 'Viewer';
      default: return role.charAt(0).toUpperCase() + role.slice(1);
    }
  };

  const getStatusColor = (status: string) => {
    switch (status) {
      case 'active': return 'bg-green-100 text-green-700 border-green-200';
      case 'pending': return 'bg-yellow-100 text-yellow-700 border-yellow-200';
      case 'invited': return 'bg-blue-100 text-blue-700 border-blue-200';
      default: return 'bg-gray-100 text-gray-700 border-gray-200';
    }
  };

  // If user is a collaborator (contributor/edit or viewer), show simplified collaborator view
  // Admin role shows the full page with more controls
  if (currentUserRole === 'contributor' || currentUserRole === 'viewer' || currentUserRole === 'edit' || currentUserRole === 'view') {
    return (
      <div
        className="relative w-full min-h-screen bg-gray-50 -my-8 pb-20 lg:pb-0"
        onTouchStart={handleTouchStart}
        onTouchMove={handleTouchMove}
        onTouchEnd={handleTouchEnd}
      >
        {/* Pull-to-refresh indicator - for collaborator view */}
        {(isPulling || isRefreshing) && (
          <div
            className="fixed top-20 left-0 right-0 flex justify-center items-center transition-all duration-200 z-[60]"
            style={{
              transform: `translateY(${isPulling ? Math.min(pullDistance, 60) : 0}px)`,
              opacity: isPulling ? Math.min(pullDistance / pullThreshold, 1) : 1
            }}
          >
            <div className="bg-white rounded-full p-3 shadow-lg flex items-center gap-2">
              <svg
                className={`w-5 h-5 text-[#6C60FF] ${isRefreshing ? 'animate-spin' : ''}`}
                style={{
                  transform: isPulling && !isRefreshing ? `rotate(${pullDistance * 2}deg)` : undefined
                }}
                fill="none"
                viewBox="0 0 24 24"
              >
                <circle className="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" strokeWidth="4"></circle>
                <path className="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
              {isRefreshing && <span className="text-sm text-gray-700">Refreshing...</span>}
              {isPulling && !isRefreshing && pullDistance >= pullThreshold && (
                <span className="text-sm text-gray-700">Release to refresh</span>
              )}
            </div>
          </div>
        )}

        {/* Collaborator View - Simplified Design */}
        <div className="w-full">
          {/* Hero Section with Image and Overlays - Full Width - Sticky */}
          <div className={`sticky top-16 z-10 w-screen -mx-4 md:w-full md:mx-0  transition-all duration-300 ease-in-out ${isHeaderShrunk ? 'h-[99px]' : 'h-[196px] sm:h-56 md:h-80'}`}>
            {(() => {
              const rawColor = apiMemoryData?.user?.profile_color || (user as any)?.profile_color;
              const profileColor = rawColor
                ? (rawColor.startsWith('#') ? rawColor : `#${rawColor}`)
                : '#6C60FF';
              const userInitial = apiMemoryData?.user?.name?.charAt(0) || apiMemoryData?.user?.username?.charAt(0) || (user as any)?.name?.charAt(0) || 'U';
              return apiMemoryData?.last_update_img || apiMemoryData?.user?.profile_image ? (
                <img
                  src={apiMemoryData?.last_update_img || apiMemoryData?.user?.profile_image}
                  alt={apiMemoryData?.title || 'Memory'}
                  className="w-full h-full object-cover"
                />
              ) : (
                <div
                  className="w-full h-full flex items-center justify-center"
                  style={{ backgroundColor: profileColor }}
                >
                  <span className="text-white font-bold text-6xl md:text-8xl uppercase">
                    {userInitial}
                  </span>
                </div>
              );
            })()}
            {/* Dark gradient overlay */}
            <div className={`absolute inset-0 transition-all duration-300 ease-in-out ${isHeaderShrunk ? 'bg-black/60' : 'bg-gradient-to-t from-black/70 via-black/20 to-transparent'}`} />

            {/* Shrunk Header - Two Line Layout */}
            {isHeaderShrunk && (
              <div className="absolute inset-0 z-10 flex items-center">
                {/* Close Button - Absolutely positioned */}
                <Button
                  variant="ghost"
                  size="sm"
                  onClick={onBack}
                  className="absolute left-2 md:left-25 top-1/2 -translate-y-1/2 z-20 w-7 h-7 md:w-9 md:h-9 p-0 bg-white/10 hover:bg-white/20 text-white rounded-full"
                >
                  <X className="w-3.5 h-3.5 md:w-4 md:h-4" />
                </Button>

                <div className="w-full pl-10 md:pl-0">
                  <div className="max-w-7xl mx-auto px-3 md:px-4">
                    <div className="flex items-center justify-between gap-2 md:gap-3">
                      {/* Title and Info Stack - Aligned with cards */}
                      <div className="flex flex-col min-w-0 flex-1 gap-2">
                        {/* First Line - Title */}
                        <h1 className="text-white text-[22px] md:text-[28px] font-bold truncate leading-tight mt-4 mb-0.5">
                          {apiMemoryData?.title || 'Memory Title'}
                        </h1>

                        {/* Second Line - Author, Date, Location */}
                        <div className="flex flex-col md:flex-row md:items-center gap-0 md:gap-2 text-white/90 text-[10px] md:text-sm font-normal">
                          {/* Author */}
                          <div className="flex items-center gap-1 shrink-0">
                            <Avatar className="w-3.5 h-3.5 md:w-4 md:h-4 border border-white/50">
                              <AvatarImage src={apiMemoryData?.user?.profile_image} />
                              <AvatarFallback className="bg-[#6C60FF] text-white text-[7px] md:text-[8px]">
                                {apiMemoryData?.user?.name?.charAt(0) || 'U'}
                              </AvatarFallback>
                            </Avatar>
                            <span className="whitespace-nowrap text-[13px] md:text-[14px]">Shared by <span className="font-bold">{apiMemoryData?.user?.name || 'Unknown'}</span></span>
                          </div>

                          {/* Date and Location - on new line on mobile, same line on desktop */}
                          <div className="flex items-center gap-1.5 md:gap-2 overflow-x-auto scrollbar-none">
                            {apiMemoryData?.dates?.formatted_range && (
                              <>
                                <span className="shrink-0 text-white/50 hidden md:inline">•</span>
                                <div className="flex items-center gap-0.5 shrink-0">
                                  <Calendar className="w-2.5 h-2.5 md:w-3 md:h-3" />
                                  <span className="whitespace-nowrap text-[13px] md:text-[14px]">{apiMemoryData.dates.formatted_range}</span>
                                </div>
                              </>
                            )}

                            {apiMemoryData?.location && (
                              <>
                                <span className="shrink-0 text-white/50">•</span>
                                <div className="flex items-center gap-0.5 shrink-0">
                                  <MapPin className="w-2.5 h-2.5 md:w-3 md:h-3" />
                                  <span className="whitespace-nowrap text-[13px] md:text-[14px]">{apiMemoryData.location}</span>
                                </div>
                              </>
                            )}
                          </div>
                        </div>
                      </div>

                      {/* Right: Add Moment Button - Desktop only after scrolling */}
                      {currentUserRole === 'contributor' && (
                        <Button
                          onClick={() => setIsAddMomentModalOpen(true)}
                          size="sm"
                          className="shrink-0 bg-[#6C60FF] hover:bg-[#5B4FE8] text-white rounded-lg hidden lg:flex items-center gap-1 w-auto px-4 py-2"
                        >
                          <Plus className="w-4 h-4" />
                          <span className="text-sm">Add a Moment</span>
                        </Button>
                      )}
                    </div>
                  </div>
                </div>
              </div>
            )}

            {/* Normal Header - Full Layout */}
            {!isHeaderShrunk && (
              <>
                {/* Back Button and Add Moment Button - Top of Hero */}
                <div className="absolute top-0 left-0 right-0 z-20">
                  <div className="max-w-7xl mx-auto px-0 sm:px-4 py-3 sm:py-4">
                    <div className="flex items-center justify-between mx-4 md:mx-0 my-4">
                      <Button
                        variant="ghost"
                        size="sm"
                        onClick={onBack}
                        className="bg-gray-200/80 hover:bg-gray-300/80 text-gray-700 text-xs sm:text-sm px-2 sm:px-3 py-1.5 sm:py-2 rounded-lg backdrop-blur-sm"
                      >
                        <ArrowLeft className="w-6 h-6 sm:w-4 sm:h-4 mr-1 sm:mr-2" />
                        <span className="hidden sm:inline">Back to Memories</span>
                        <span className="sm:hidden">Back</span>
                      </Button>

                      {/* Add a Moment button - only for contributors - Desktop only */}
                      {currentUserRole === 'contributor' && (
                        <Button
                          onClick={() => setIsAddMomentModalOpen(true)}
                          size="sm"
                          className="bg-[#6C60FF] hover:bg-[#5B4FE8] text-white px-4 py-2 rounded-lg shadow-sm text-sm hidden lg:flex"
                        >
                          <Plus className="w-4 h-4" />
                          <span>Add a Moment</span>
                        </Button>
                      )}
                    </div>
                  </div>
                </div>

                {/* Memory Title and Author at bottom with Badges */}

                <div className="absolute bottom-0 left-0 right-0 z-10 pb-3 sm:pb-4 md:pb-6 pt-20 md:pt-0">
                  <div className="max-w-7xl mx-auto px-3 sm:px-4">
                    {/* Badges above title */}
                    <div className="flex items-center gap-1.5 sm:gap-2 md:mb-3">
                      <Badge className="bg-red-500 text-white font-medium px-3 py-1 sm:px-3 sm:py-1.5 md:px-4 md:py-2 text-[12px] sm:text-xs md:text-sm">
                        Shared with
                      </Badge>
                      {(currentUserRole === 'admin' || currentUserRole?.toLowerCase() === 'admin') && (
                        <Badge className="bg-white/90 text-red-600 font-medium px-2 py-1 sm:px-2.5 sm:py-1 md:px-3 md:py-1 flex items-center gap-1 sm:gap-1.5 text-[10px] sm:text-xs md:text-sm">
                          <Shield className="w-2.5 h-2.5 sm:w-3 sm:h-3" />
                          Admin
                        </Badge>
                      )}
                      {apiMemoryData?.published === 3 && (
                        <Badge className="bg-white/90 text-gray-700 font-medium px-2 py-1 sm:px-2.5 sm:py-1 md:px-3 md:py-1 flex items-center gap-1 sm:gap-1.5 text-[10px] sm:text-xs md:text-sm">
                          <Lock className="w-2.5 h-2.5 sm:w-3 sm:h-3" />
                          Private
                        </Badge>
                      )}
                    </div>

                    <h1 className="font-bold text-white mb-2 md:mb-4 text-2xl sm:text-3xl md:text-[42px] leading-[30px] md:leading-[52px]">
                      {apiMemoryData?.title || 'Memory Title'}
                    </h1>
                    <div className="flex flex-col md:flex-row md:items-center gap-2 sm:gap-3 md:gap-4 text-white/90 text-xs sm:text-sm">
                      {/* Author */}
                      <HoverCard>
                        <HoverCardTrigger asChild>
                          <div className="flex items-center gap-1.5 sm:gap-2 cursor-pointer hover:text-white transition-colors">
                            <Avatar className="w-6 h-6 sm:w-7 sm:h-7 border-2 border-white/50">
                              <AvatarImage src={apiMemoryData?.user?.profile_image} />
                              <AvatarFallback className="bg-[#6C60FF] text-white text-[10px] sm:text-xs">
                                {apiMemoryData?.user?.name?.charAt(0) || 'U'}
                              </AvatarFallback>
                            </Avatar>
                            <span className="text-[13px] md:text-[14px]">Author: <strong>{apiMemoryData?.user?.name || 'Unknown'}</strong></span>
                          </div>
                        </HoverCardTrigger>
                        <HoverCardContent className="w-80 bg-white rounded-xl shadow-2xl border border-gray-100 p-0 overflow-hidden">
                          <div className="p-5">
                            {/* User Profile Header */}
                            <div className="flex items-start gap-4 mb-4">
                              <Avatar className="w-16 h-16 border-2 border-gray-100">
                                <AvatarImage src={apiMemoryData?.user?.profile_image} />
                                <AvatarFallback className="bg-[#6C60FF] text-white text-xl font-semibold">
                                  {apiMemoryData?.user?.name?.charAt(0) || 'U'}
                                </AvatarFallback>
                              </Avatar>
                              <div className="flex-1 min-w-0">
                                <h3 className="text-lg font-semibold text-gray-900 truncate">
                                  {apiMemoryData?.user?.name || 'Unknown User'}
                                </h3>
                                {apiMemoryData?.location && (
                                  <p className="text-sm text-gray-600">
                                    {apiMemoryData.location}
                                  </p>
                                )}
                              </div>
                            </div>

                            {/* Total Memories */}
                            <div className="flex items-center justify-between py-3 border-t border-gray-100">
                              <span className="text-sm text-gray-600">Total Memories</span>
                              <span className="text-lg font-semibold text-gray-900">
                                {apiMemoryData?.user?.memory_count || 12}
                              </span>
                            </div>

                            {/* Connect Section */}
                            <div className="border-t border-gray-100 pt-4 mt-2">
                              <p className="text-xs text-gray-500 mb-3">Connect</p>

                              {/* Email and Social media icons inline */}
                              <div className="flex items-center gap-3">
                                {/* Email display */}
                                {apiMemoryData?.user?.email && (
                                  <div className="flex items-center gap-2 text-sm">
                                    <Mail className="w-4 h-4 text-gray-500" />
                                    <a
                                      href={`mailto:${apiMemoryData.user.email}`}
                                      className="text-gray-700 hover:text-[#6C60FF] hover:underline"
                                    >
                                      {apiMemoryData.user.email}
                                    </a>
                                  </div>
                                )}

                                {/* LinkedIn Icon - Always show */}
                                <Button
                                  variant="outline"
                                  size="sm"
                                  className={`w-10 h-10 p-0 border-gray-300 ${
                                    apiMemoryData?.user?.linkedin_url
                                      ? 'text-blue-700 hover:bg-blue-50 hover:border-blue-300'
                                      : 'text-gray-400 cursor-not-allowed opacity-50'
                                  }`}
                                  onClick={() => {
                                    if (apiMemoryData?.user?.linkedin_url) {
                                      window.open(apiMemoryData.user.linkedin_url, '_blank');
                                    }
                                  }}
                                  disabled={!apiMemoryData?.user?.linkedin_url}
                                >
                                  <Linkedin className="w-4 h-4" />
                                </Button>

                                {/* Facebook Icon - Always show */}
                                <Button
                                  variant="outline"
                                  size="sm"
                                  className={`w-10 h-10 p-0 border-gray-300 ${
                                    apiMemoryData?.user?.facebook_url
                                      ? 'text-blue-600 hover:bg-blue-50 hover:border-blue-300'
                                      : 'text-gray-400 cursor-not-allowed opacity-50'
                                  }`}
                                  onClick={() => {
                                    if (apiMemoryData?.user?.facebook_url) {
                                      window.open(apiMemoryData.user.facebook_url, '_blank');
                                    }
                                  }}
                                  disabled={!apiMemoryData?.user?.facebook_url}
                                >
                                  <Facebook className="w-4 h-4" />
                                </Button>
                              </div>
                            </div>
                          </div>
                        </HoverCardContent>
                      </HoverCard>

                      {/* Date and Location */}
                      <div className="flex items-center gap-2 sm:gap-3 md:gap-4">
                        {apiMemoryData?.dates?.formatted_range && (
                          <div className="flex items-center gap-1 sm:gap-1.5">
                            <Calendar className="w-3 h-3 sm:w-4 sm:h-4" />
                            <span className="text-[13px] md:text-[14px]">{apiMemoryData.dates.formatted_range}</span>
                          </div>
                        )}
                        {apiMemoryData?.location && (
                          <div className="flex items-center gap-1 sm:gap-1.5">
                            <MapPin className="w-3 h-3 sm:w-4 sm:h-4" />
                            <span className="truncate max-w-[150px] sm:max-w-none text-[13px] md:text-[14px]">{apiMemoryData.location}</span>
                          </div>
                        )}
                      </div>
                    </div>
                  </div>
                </div>
              </>
            )}
          </div>

          {/* Timeline Section - Full Width */}
          <div className="bg-white shadow-sm border-t border-b border-gray-200">
            {/* Timeline Header */}
            <div className="max-w-7xl mx-auto md:px-3 px-0">
              <div className="flex items-center justify-between py-4 px-4 md:px-0 sm:py-6 border-b border-gray-100 mt-5">
              <div className="flex items-center gap-2 sm:gap-3">
                <div className="hidden sm:flex w-8 h-8 sm:w-10 sm:h-10 bg-[#6C60FF]/10 rounded-full items-center justify-center">
                  <Clock className="w-4 h-4 sm:w-5 sm:h-5 text-[#6C60FF]" />
                </div>
                <div>
                  <h2 className="text-[21px] sm:text-lg font-semibold text-gray-900 leading-tight">Timeline</h2>
                  <p className="text-xs sm:text-sm text-gray-500">{sortedTimelinePosts.length} moments shared</p>
                </div>
              </div>

              {/* Role Badge and Filter */}
              <div className="flex items-center gap-2 sm:gap-3">
                {currentUserRole === 'contributor' && (
                  <Badge
                    className="flex items-center justify-center mb-1 text-xs font-medium"
                    style={{
                      height: '28px',
                      padding: '4.5px 8px',
                      gap: '3.5px',
                      borderRadius: '3.5px',
                      border: '1px solid #9333EA',
                      background: '#F3E8FF',
                      color: '#9333EA'
                    }}
                  >
                    <Users className="w-3.5 h-3.5" />
                    Contributor
                  </Badge>
                )}
                {currentUserRole === 'viewer' && (
                  <Badge className="bg-gray-100 text-gray-700 border border-gray-200 text-xs font-medium px-3 py-1">
                    Viewer
                  </Badge>
                )}
                <Select value={timelineFilter} onValueChange={setTimelineFilter}>
                  <SelectTrigger className="w-21 md:w-32 h-9 text-xs border-gray-200">
                    <SelectValue />
                  </SelectTrigger>
                  <SelectContent>
                    <SelectItem value="latest" className="text-xs">Latest First</SelectItem>
                    <SelectItem value="oldest" className="text-xs">Oldest First</SelectItem>
                    <SelectItem value="most_comments" className="text-xs">Most Comments</SelectItem>
                    <SelectItem value="fewer_comments" className="text-xs">Fewer Comments</SelectItem>
                  </SelectContent>
                </Select>

                {/* Three Dot Menu - Only show for collaborators (not owner) */}
                {currentUserRole && currentUserRole !== 'owner' && (
                  <DropdownMenu>
                    <DropdownMenuTrigger asChild>
                      <Button
                        variant="ghost"
                        size="sm"
                        className="h-9 w-9 p-0 border border-gray-200 hover:bg-gray-50"
                      >
                        <MoreVertical className="w-4 h-4 text-gray-600" />
                      </Button>
                    </DropdownMenuTrigger>
                    <DropdownMenuContent align="end" className="w-56 bg-white border border-gray-200 rounded-lg shadow-lg p-1">
                      <DropdownMenuItem
                        className="flex items-center gap-2 px-3 py-2 text-sm text-gray-700 hover:bg-gray-50 cursor-pointer rounded"
                        onClick={async () => {
                          try {
                            console.log('=== REQUESTING FULL ACCESS ===');
                            console.log('Memory ID:', memoryId);

                            const response = await dashboardAPI.requestFullAccess(memoryId);

                            if (response.success) {
                              toast.success("Access request sent to memory owner");
                              console.log('✅ Full access request sent successfully');
                            } else {
                              toast.error(response.error || "Failed to send access request");
                              console.error('❌ Failed to request full access:', response.error);
                            }
                          } catch (error) {
                            console.error('🔥 Error requesting full access:', error);
                            toast.error("An error occurred while sending access request");
                          }
                        }}
                      >
                        <UserCircle className="w-4 h-4 text-gray-600" />
                        Request Full Access
                      </DropdownMenuItem>
                      <DropdownMenuItem
                        className="flex items-center gap-2 px-3 py-2 text-sm text-red-600 hover:bg-red-50 cursor-pointer rounded"
                        onClick={async () => {
                          try {
                            console.log('=== REMOVING SHARED MEMORY ===');
                            console.log('Memory ID:', memoryId);

                            // Use external_user_id as the actual user ID (id field is admin_id)
                            const userId = (user as any)?.external_user_id?.toString() || user?.id?.toString();
                            console.log('User ID:', userId);
                            console.log('Admin ID:', user?.id);
                            console.log('External User ID:', (user as any)?.external_user_id);

                            if (!userId) {
                              toast.error("User not authenticated");
                              return;
                            }

                            const response = await dashboardAPI.removeSharedWithMemory(memoryId, userId);

                            if (response.success) {
                              toast.success("Memory removed from your collection");
                              console.log('✅ Memory removed successfully');

                              // Refresh memories list to remove the deleted memory
                              if (onRefresh) {
                                console.log('🔄 Refreshing memories list after removing shared memory');
                                await onRefresh();
                              }

                              // Navigate back to memories page after a short delay
                              setTimeout(() => {
                                onBack();
                              }, 500);
                            } else {
                              toast.error(response.error || "Failed to remove memory");
                              console.error('❌ Failed to remove memory:', response.error);
                            }
                          } catch (error) {
                            console.error('🔥 Error removing memory:', error);
                            toast.error("An error occurred while removing memory");
                          }
                        }}
                      >
                        <Trash2 className="w-4 h-4" />
                        Remove Memory
                      </DropdownMenuItem>
                    </DropdownMenuContent>
                  </DropdownMenu>
                )}
              </div>
            </div>
            </div>

            {/* Timeline Posts */}
            <div className="max-w-7xl mx-auto px-3 sm:px-4 py-4 sm:py-6">
              <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-4 md:gap-6">
                {isLoadingMemory ? (
                  <div className="col-span-full text-center py-12">
                    <div className="w-6 h-6 border-2 border-[#6C60FF] border-t-transparent rounded-full animate-spin mx-auto mb-4"></div>
                    <p className="text-gray-500">Loading timeline...</p>
                  </div>
                ) : sortedTimelinePosts.length > 0 ? (
                  sortedTimelinePosts.map((post) => {
                    const memoryOwnerId = apiMemoryData?.user_id?.toString() || apiMemoryData?.user?.id?.toString();

                    // Calculate sub-image count for this post
                    const subImageCount = rawApiPosts?.filter((p: any) =>
                      p.parent_id?.toString() === post.id?.toString()
                    ).length || 0;

                    // Get sub-images array for this post, sorted so featured image appears first
                    const postSubImages = (rawApiPosts?.filter((p: any) =>
                      p.parent_id?.toString() === post.id?.toString()
                    ) || [])
                    .sort((a: any, b: any) => {
                      // Featured images come first
                      const aIsFeatured = a.is_featured === 1 || a.is_featured === true;
                      const bIsFeatured = b.is_featured === 1 || b.is_featured === true;
                      if (aIsFeatured && !bIsFeatured) return -1;
                      if (!aIsFeatured && bIsFeatured) return 1;
                      return 0; // Maintain original order for non-featured images
                    })
                    .map((p: any) => ({
                      id: p.id?.toString(),
                      src: p.image_link ? p.image_link.replace(/\\\//g, '/') : (p.image || p.image_url || ''),
                      alt: p.name || 'Sub-image',
                      name: p.name || '', // Keep name separate for comparison
                      title: p.title || '', // Only use actual title, don't fallback to name
                      description: p.description || '',
                      location: p.location || '',
                      dateTaken: p.capture_date || p.created_at || '',
                      is_featured: p.is_featured || 0
                    }));

                    return (
                      <PostCard
                        key={post.id}
                        post={post}
                        variant="card"
                        onContentUpdate={handlePostContentUpdate}
                        onImageClick={handleTimelineImageView}
                        memoryOwnerId={memoryOwnerId}
                        onPostDelete={handlePostDelete}
                        onUpdateItem={handleUpdateItem}
                        activeCollaborators={apiCollaborators.filter(c => c.status === 'active')}
                        subImageCount={subImageCount}
                        subImages={postSubImages}
                        memoryTitle={apiMemoryData?.title}
                        memoryThumbnail={apiMemoryData?.last_update_img}
                        memoryCreatedDate={apiMemoryData?.created_at}
                        memoryImages={memoryImagesWithSubImages}
                        memoryPublished={apiMemoryData?.published}
                        memoryId={memoryId}
                        memorySlug={apiMemoryData?.slug || apiMemoryData?.token}
                        onRefresh={async () => {
                          setApiMemoryData(null);
                          await fetchMemoryDetails(false);
                        }}
                      />
                    );
                  })
                ) : (
                  <div className="col-span-full text-center py-12">
                    <Activity className="w-12 h-12 text-gray-400 mx-auto mb-4" />
                    <h3 className="text-lg font-medium text-gray-900 mb-2">No moments yet</h3>
                    <p className="text-gray-500">This memory doesn't have any posts yet.</p>
                  </div>
                )}
              </div>
            </div>
          </div>
        </div>

        {/* Add Moment Modal */}
        <AddMomentModal
          isOpen={isAddMomentModalOpen}
          onClose={() => {
            setIsAddMomentModalOpen(false);
            setSelectedMediaLibraryImagesForMoment([]);
            setParentImageIdForSubImage(undefined); // Clear parent image ID
            setCapturedFiles(null); // Clear captured files
            // Refresh memory data
            fetchMemoryDetails();
          }}
          memoryId={memoryId}
          memoryTitle={apiMemoryData?.title || 'Memory'}
          memoryThumbnail={apiMemoryData?.last_update_img || apiMemoryData?.thumbnail}
          memoryCreatedDate={apiMemoryData?.created_at}
          userRole={currentUserRole}
          parentImageId={parentImageIdForSubImage}
          capturedFiles={capturedFiles}
          memoryImages={memoryImagesWithSubImages}
          onOpenMediaLibrary={() => {
            console.log('🔍 onOpenMediaLibrary called (Shared Memory) - Opening media library');
            console.log('🔍 Current userRole:', currentUserRole);
            console.log('🔍 Setting isAddMomentSelectionMode: true');
            console.log('🔍 Setting isMediaLibraryOpen: true');
            setIsAddMomentSelectionMode(true);
            setIsMediaLibraryOpen(true);
            console.log('🔍 States updated');
          }}
          selectedMediaLibraryImages={selectedMediaLibraryImagesForMoment}
          onAddMoment={(momentData) => {
            console.log('Moment added:', momentData);
            // Close modal and refresh
            setIsAddMomentModalOpen(false);
            setSelectedMediaLibraryImagesForMoment([]);
            setCapturedFiles(null); // Clear captured files
            fetchMemoryDetails();

            // Refresh memories list on parent page
            if (onRefresh) {
              onRefresh();
            }
          }}
        />

        {/* Hidden Camera Input for Mobile */}
        <input
          ref={cameraInputRef}
          type="file"
          accept="image/*"
          capture="environment"
          className="hidden"
          onChange={handleCameraCapture}
        />

        {/* Hidden Media Library Input for Mobile */}
        <input
          ref={mediaLibraryInputRef}
          type="file"
          accept="image/*"
          className="hidden"
          onChange={handleMediaLibrarySelection}
        />

        {/* Camera Options Modal */}
        {showCameraOptions && (
          <div
            className="fixed inset-0 bg-black/50 z-[60] flex items-end md:items-center md:justify-center"
            onClick={() => setShowCameraOptions(false)}
          >
            <div
              className="bg-white rounded-t-3xl md:rounded-2xl w-full md:max-w-md p-6 pb-8 md:pb-6 space-y-4"
              onClick={(e) => e.stopPropagation()}
            >
              <h3 className="text-lg font-semibold text-center text-gray-900 mb-4">Add Photo</h3>

              <button
                onClick={handleTakePhoto}
                className="w-full flex items-center gap-4 p-4 bg-[#6C60FF] hover:bg-[#5B4FE8] text-white rounded-xl transition-colors"
              >
                <Camera className="w-6 h-6" />
                <span className="text-base font-medium">Take Photo</span>
              </button>

              <button
                onClick={handleChooseFromLibrary}
                className="w-full flex items-center gap-4 p-4 bg-gray-100 hover:bg-gray-200 text-gray-900 rounded-xl transition-colors"
              >
                <ImageIcon className="w-6 h-6" />
                <span className="text-base font-medium">Choose from Library</span>
              </button>

              <button
                onClick={() => setShowCameraOptions(false)}
                className="w-full p-4 text-gray-600 hover:text-gray-900 font-medium transition-colors"
              >
                Cancel
              </button>
            </div>
          </div>
        )}

        {/* Camera Interface */}
        <CameraInterface
          isOpen={showCameraInterface}
          onClose={() => setShowCameraInterface(false)}
          onCapture={handleCameraInterfaceCapture}
        />

        {/* Floating Camera Button - Mobile Only */}
        {currentUserRole === 'contributor' && (
          <button
            onClick={handleCameraClick}
            className="md:hidden fixed bottom-10 left-1/2 -translate-x-1/2 z-50 w-24 h-24 bg-[#6C60FF] hover:bg-[#5B4FE8] rounded-full shadow-lg flex items-center justify-center transition-all active:scale-95"
            aria-label="Open Camera"
          >
            <Camera className="w-8 h-8 text-white" />
          </button>
        )}

        {/* Image Viewer */}
        {void console.log('🎨 RENDERING FIRST ImageViewer - isOpen:', imageViewer.isOpen, 'imageViewer.memoryId:', imageViewer.memoryId, 'imageViewer.imageId:', imageViewer.imageId)}
        {void console.log('🗑️ Passing handleDeleteSubImage to first ImageViewer:', typeof handleDeleteSubImage, handleDeleteSubImage)}
        <ImageViewer
          isOpen={imageViewer.isOpen}
          imageSrc={imageViewer.src}
          imageAlt={imageViewer.alt}
          title={imageViewer.title}
          subtitle={imageViewer.subtitle}
          filename={imageViewer.filename}
          dateTaken={imageViewer.dateTaken}
          location={imageViewer.location}
          images={imageViewer.images}
          largeSize={true}
          coverContentOnly={false}
          onClose={handleCloseImageViewer}
          currentImageIndex={imageViewer.currentIndex}
          onNextImage={handleNextImage}
          onPrevImage={handlePrevImage}
          isSelected={imageViewer.imageId ? selectedItems.includes(imageViewer.imageId) : false}
          onToggleSelection={handleToggleImageSelection}
          imageId={imageViewer.imageId}
          memoryId={imageViewer.memoryId}
          memoryTitle={apiMemoryData?.title || 'Memory'}
          memoryThumbnail={apiMemoryData?.last_update_img || apiMemoryData?.thumbnail}
          memoryCreatedDate={apiMemoryData?.created_at}
          memoryImages={memoryImagesWithSubImages}
          userRole={currentUserRole}
          parentImageIsFeatured={imageViewer.parentImageIsFeatured}
          onSubImageAdded={async () => {
            await fetchMemoryDetails();
            await fetchMemoryActivity();
          }}
          onGetSubImages={(parentImageId) => {
            const allPosts = rawApiPosts || [];
            const subImages = allPosts
              .filter((post: any) => {
                const postParentId = post.parent_id?.toString();
                const searchParentId = parentImageId?.toString();
                const isSubImage = postParentId === searchParentId;
                // Only show approved sub-images (admin_approval !== 0)
                const isApproved = post.admin_approval === 1 || post.admin_approval === '1' || post.admin_approval === undefined || post.admin_approval === null;
                return isSubImage && isApproved;
              })
              .map((post: any) => ({
                id: post.id?.toString(),
                src: post.image_link ? post.image_link.replace(/\\\//g, '/') : (post.image || post.image_url || ''),
                alt: post.name || post.title || 'Sub-image',
                title: post.name || post.title,
                description: post.description || '',
                location: post.location || '',
                dateTaken: post.capture_date || post.created_at || '',
                filename: post.name || post.title || 'Sub-image'
              }));
            return subImages;
          }}
          initialSubImageId={(imageViewer as any).initialSubImageId}
          initialRotation={imageViewer.rotation_angle}
          onRefreshData={async () => {
            await fetchMemoryDetails();
            await fetchMemoryActivity();
          }}
          locationData={{
            address: imageViewer.location
          }}
          onLocationChange={(newLocation) => {
            setImageViewer(prev => ({
              ...prev,
              location: newLocation
            }));
          }}
          onDescriptionUpdate={(imageId, newDescription) => {
            setUpdatedPosts(prev => ({
              ...prev,
              [imageId]: newDescription
            }));
          }}
          onCommentCountChange={handleCommentCountChange}
          activeCollaborators={apiCollaborators.filter(c => c.status === 'active')}
          onDeleteSubImage={handleDeleteSubImage}
        />

        {/* Media Library Modal */}
        {void console.log('🎬 Rendering check - isMediaLibraryOpen:', isMediaLibraryOpen)}
        {isMediaLibraryOpen && (
          <div className="fixed inset-0 z-[100002] flex items-center justify-center">
            <div className="fixed inset-0 bg-black/50" onClick={() => {
              setIsMediaLibraryOpen(false);
              setIsCoverPhotoSelectionMode(false);
              setIsAddMomentSelectionMode(false);
              setMediaLibrarySelectedItems([]);
            }} />
            <div className="relative z-[100003] max-w-3xl max-h-[90vh] w-full mx-4 bg-white flex flex-col rounded-lg overflow-hidden border border-gray-200 shadow-xl">
            {/* Header */}
            <div className="flex items-center gap-3 px-6 py-4 border-b border-gray-200 bg-white">
              <div className="flex items-center justify-center w-10 h-10 bg-[#6C60FF]/10 rounded-lg">
                <ImageIcon className="w-5 h-5 text-[#6C60FF]" />
              </div>
              <div className="flex-1">
                <h2 className="text-lg font-semibold text-gray-900">
                  {isCoverPhotoSelectionMode ? 'Select Cover Photo' : isAddMomentSelectionMode ? 'Add Moments from Library' : 'Media Library'}
                </h2>
                <p className="text-sm text-gray-500">
                  {isCoverPhotoSelectionMode ? 'Choose one photo for your memory cover' : isAddMomentSelectionMode ? 'Select photos to add as moments' : 'Select photos to add to this memory'}
                </p>
              </div>
            </div>

            {/* Search and Filter */}
            <div className="flex items-center gap-3 px-6 py-4 border-b border-gray-200 bg-white">
              <div className="flex-1 relative">
                <MapPin className="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400" />
                <Input
                  placeholder="Search your media library..."
                  value={mediaLibrarySearchTerm}
                  onChange={(e) => setMediaLibrarySearchTerm(e.target.value)}
                  className="pl-10 border-gray-300 focus:border-gray-400 focus:ring-gray-400"
                />
              </div>
              <Select value={mediaLibraryCategory} onValueChange={setMediaLibraryCategory}>
                <SelectTrigger className="w-48 border-gray-300 focus:border-gray-400 focus:ring-gray-400">
                  <SelectValue />
                </SelectTrigger>
                <SelectContent>
                  <SelectItem value="All Categories">All Categories</SelectItem>
                  {mediaLibraryCategories.map((cat) => (
                    <SelectItem key={cat} value={cat}>{cat}</SelectItem>
                  ))}
                </SelectContent>
              </Select>
            </div>

            {/* Selection Info */}
            {!isCoverPhotoSelectionMode && isAddMomentSelectionMode && (
              <div className="flex items-center justify-between px-6 py-3 bg-gray-50 border-b border-gray-200">
                <div className="flex items-center gap-4">
                  <span className="text-sm font-medium text-gray-700">
                    <span className="text-[#6C60FF]">{mediaLibrarySelectedItems.length} of</span> {filteredMediaLibraryImages.length} selected
                  </span>
                  <button
                    onClick={() => {
                      setMediaLibrarySelectedItems(filteredMediaLibraryImages.map(p => p.id));
                    }}
                    className="text-sm text-[#6C60FF] hover:text-[#5850E5] font-medium"
                  >
                    Select All
                  </button>
                </div>
                <button
                  onClick={() => setMediaLibrarySelectedItems([])}
                  className="flex items-center gap-1 text-sm text-gray-600 hover:text-gray-900"
                >
                  <X className="w-4 h-4" />
                  Clear Selection
                </button>
              </div>
            )}

            {/* Media Grid */}
            <div className="flex-1 overflow-y-auto px-6 py-4 bg-white">
              {isLoadingMediaLibrary ? (
                <div className="flex items-center justify-center py-12">
                  <div className="animate-spin rounded-full h-8 w-8 border-b-2 border-[#6C60FF]"></div>
                </div>
              ) : filteredMediaLibraryImages.length === 0 ? (
                <div className="flex flex-col items-center justify-center py-12 text-center">
                  <ImageIcon className="w-12 h-12 text-gray-300 mb-3" />
                  <p className="text-gray-600 font-medium">No images found</p>
                  <p className="text-sm text-gray-400 mt-1">
                    {mediaLibrarySearchTerm || mediaLibraryCategory !== "All Categories"
                      ? "Try adjusting your search or filters"
                      : "Upload some images to get started"}
                  </p>
                </div>
              ) : (
                <div className="grid grid-cols-3 gap-4">
                  {filteredMediaLibraryImages.map((post) => {
                    const isSelected = mediaLibrarySelectedItems.includes(post.id);
                    return (
                      <div
                        key={post.id}
                        className={`relative group cursor-pointer rounded-lg overflow-hidden border-2 transition-all shadow-sm hover:shadow-md ${
                          isSelected ? 'border-[#6C60FF] ring-2 ring-[#6C60FF]/20 shadow-lg' : 'border-gray-200 hover:border-gray-300'
                        }`}
                      onClick={() => {
                        if (isCoverPhotoSelectionMode) {
                          setMediaLibrarySelectedItems([post.id]);
                        } else {
                          setMediaLibrarySelectedItems(prev =>
                            prev.includes(post.id)
                              ? prev.filter(id => id !== post.id)
                              : [...prev, post.id]
                          );
                        }
                      }}
                    >
                      {/* Checkbox */}
                      <div className="absolute top-2 left-2 z-10">
                        <div className={`w-5 h-5 rounded border-2 flex items-center justify-center transition-all ${
                          isSelected
                            ? 'bg-[#6C60FF] border-[#6C60FF]'
                            : 'bg-white border-gray-300 group-hover:border-gray-400'
                        }`}>
                          {isSelected && (
                            <svg className="w-3 h-3 text-white" viewBox="0 0 12 12" fill="none">
                              <path d="M10 3L4.5 8.5L2 6" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"/>
                            </svg>
                          )}
                        </div>
                      </div>

                      {/* Image */}
                      <div className="aspect-square bg-gray-100">
                        <img
                          src={post.image || ''}
                          alt={post.title}
                          className="w-full h-full object-cover"
                        />
                      </div>

                      {/* Info */}
                      <div className="p-3 bg-white">
                        <div className="flex items-center gap-2 mb-1">
                          <span className="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium text-white bg-[#6C60FF]">
                            {post.category || 'Travel'}
                          </span>
                        </div>
                        <p className="text-sm font-medium text-gray-900 truncate">{post.title}</p>
                        <div className="flex items-center gap-2 text-xs text-gray-500 mt-1">
                          <span>2.4 MB</span>
                          {post.date && !isNaN(new Date(post.date).getTime()) && (
                            <>
                              <span>•</span>
                              <span>{new Date(post.date).toLocaleDateString()}</span>
                            </>
                          )}
                        </div>
                      </div>
                    </div>
                  );
                })}
                </div>
              )}
            </div>

            {/* Footer */}
            <div className="flex items-center justify-between px-6 py-4 border-t border-gray-200 bg-gray-50">
              <p className="text-sm text-gray-600">
                {isCoverPhotoSelectionMode
                  ? 'Select a photo to set as cover'
                  : isAddMomentSelectionMode
                  ? `${mediaLibrarySelectedItems.length} ${mediaLibrarySelectedItems.length === 1 ? 'photo' : 'photos'} selected`
                  : 'Ready to add to memory'}
              </p>
              <div className="flex items-center gap-3">
                <Button
                  variant="outline"
                  onClick={() => {
                    setIsMediaLibraryOpen(false);
                    setMediaLibrarySelectedItems([]);
                    setIsCoverPhotoSelectionMode(false);
                    setIsAddMomentSelectionMode(false);
                  }}
                >
                  Cancel
                </Button>
                <Button
                  className="bg-[#6C60FF] hover:bg-[#5850E5] text-white"
                  disabled={mediaLibrarySelectedItems.length === 0}
                  onClick={async () => {
                    if (isCoverPhotoSelectionMode) {
                      const selectedImage = filteredMediaLibraryImages.find(img => img.id === mediaLibrarySelectedItems[0]);
                      if (selectedImage) {
                        await handleUpdateCoverPhotoFromLibrary(selectedImage.image);
                      }
                    } else if (isAddMomentSelectionMode) {
                      const selectedImages = filteredMediaLibraryImages.filter(img =>
                        mediaLibrarySelectedItems.includes(img.id)
                      );
                      console.log('Passing moments to AddMomentModal:', selectedImages);

                      setSelectedMediaLibraryImagesForMoment(selectedImages);

                      setIsMediaLibraryOpen(false);
                      setMediaLibrarySelectedItems([]);
                      setIsAddMomentSelectionMode(false);
                    } else {
                      console.log('Adding items:', mediaLibrarySelectedItems);
                      setIsMediaLibraryOpen(false);
                      setMediaLibrarySelectedItems([]);
                    }
                  }}
                >
                  {isCoverPhotoSelectionMode
                    ? 'Set as Cover Photo'
                    : isAddMomentSelectionMode
                    ? `Add ${mediaLibrarySelectedItems.length} ${mediaLibrarySelectedItems.length === 1 ? 'Moment' : 'Moments'}`
                    : `Add ${mediaLibrarySelectedItems.length} ${mediaLibrarySelectedItems.length === 1 ? 'item' : 'items'}`}
                </Button>
              </div>
            </div>
          </div>
          </div>
        )}
      </div>
    );
  }

  // Memory Owner View - Full Featured Design
  // Get post-specific data if post_id is in URL
  const currentPost = postIdFromUrl ? sortedTimelinePosts.find(p => p.id?.toString() === postIdFromUrl) : null;

  // Create Open Graph image URL
  // Instead of using S3 URL directly (which LinkedIn cannot access),
  // use a backend proxy endpoint that serves the image publicly
  let postImageUrl = '';
  const apiBaseUrl = import.meta.env.VITE_API_BASE_URL || 'https://restapi-stasht.wd-projects.online/api/react';

  if (postIdFromUrl) {
    // Use backend OG image proxy endpoint for post-specific images
    // Backend will fetch from S3 and serve publicly
    // We use postIdFromUrl directly - backend will find the post
    postImageUrl = `${apiBaseUrl}/og-image/post/${postIdFromUrl}`;

    console.log('🖼️ Using OG Image Proxy for Post:', {
      postId: postIdFromUrl,
      proxyUrl: postImageUrl,
      currentPostFound: !!currentPost,
      originalImage: currentPost?.image
    });
  } else if (apiMemoryData) {
    // For memory-level sharing, use memory ID
    postImageUrl = `${apiBaseUrl}/og-image/memory/${memoryId}`;

    console.log('🖼️ Using OG Image Proxy for Memory:', {
      memoryId: memoryId,
      proxyUrl: postImageUrl,
      originalImage: apiMemoryData?.last_update_img || apiMemoryData?.thumbnail
    });
  }

  const postTitle = currentPost?.title || currentPost?.name || apiMemoryData?.title || 'Memory Post';

  // Ensure description is at least 100 characters for LinkedIn preview
  let postDescription = currentPost?.content || apiMemoryData?.description || 'View and share this precious memory moment captured with Stasht - your personal memory keeper and sharing platform.';

  // LinkedIn requires at least 100 characters for proper preview
  if (postDescription.length < 100) {
    postDescription = postDescription + ' Capture, organize, and share your most precious memories with friends and family on Stasht.';
  }

  return (
    <div className="relative h-full pb-20 lg:pb-0">
      {/* Dynamic Open Graph Meta Tags for Post Sharing */}
      <Helmet>
        {postIdFromUrl && currentPost ? (
          <>
            {/* Post-specific meta tags */}
            <title>{postTitle} - {apiMemoryData?.title || 'Stasht'}</title>
            <meta property="og:title" content={postTitle} />
            <meta property="og:description" content={postDescription} />
            <meta property="og:image" content={postImageUrl} />
            <meta property="og:image:width" content="1200" />
            <meta property="og:image:height" content="630" />
            <meta property="og:image:type" content="image/jpeg" />
            <meta property="og:url" content={window.location.href} />
            <meta property="og:type" content="article" />
            <meta property="og:site_name" content="Stasht" />
            <meta name="twitter:card" content="summary_large_image" />
            <meta name="twitter:title" content={postTitle} />
            <meta name="twitter:description" content={postDescription} />
            <meta name="twitter:image" content={postImageUrl} />
            <meta name="twitter:site" content="@stasht" />
          </>
        ) : apiMemoryData ? (
          <>
            {/* Memory-level meta tags */}
            <title>{apiMemoryData.title || 'Memory'} - Stasht</title>
            <meta property="og:title" content={apiMemoryData.title || 'Memory'} />
            <meta property="og:description" content={apiMemoryData.description || 'View this memory on Stasht'} />
            <meta property="og:image" content={postImageUrl} />
            <meta property="og:image:width" content="1200" />
            <meta property="og:image:height" content="630" />
            <meta property="og:image:type" content="image/jpeg" />
            <meta property="og:url" content={window.location.href} />
            <meta property="og:type" content="website" />
            <meta property="og:site_name" content="Stasht" />
            <meta name="twitter:card" content="summary_large_image" />
            <meta name="twitter:title" content={apiMemoryData.title || 'Memory'} />
            <meta name="twitter:description" content={apiMemoryData.description || 'View this memory on Stasht'} />
            <meta name="twitter:image" content={postImageUrl} />
            <meta name="twitter:site" content="@stasht" />
          </>
        ) : null}
      </Helmet>

      {/* Add Collaborator Dialog */}
      <AddCollaboratorDialog
        isOpen={isAddCollaboratorOpen}
        onClose={() => setIsAddCollaboratorOpen(false)}
        onAddCollaborator={handleAddCollaborator}
        existingCollaborators={collaborators}
        memoryId={memoryId}
      />

      {/* Generate QR Code Dialog */}
      <Dialog open={isGenerateQROpen} onOpenChange={setIsGenerateQROpen}>
        <DialogContent className="max-w-[420px] bg-white p-6 max-h-[90vh] overflow-y-auto border-0 shadow-xl">
          <DialogHeader className="space-y-2 pb-4">
            <DialogTitle className="flex items-center gap-3 text-gray-900 text-base font-semibold">
              <div className="w-8 h-8 flex items-center justify-center bg-[#6C60FF]/10 rounded">
                <QrCode className="w-5 h-5 text-[#6C60FF]" />
              </div>
              Generate QR Code for Collaboration
            </DialogTitle>
            <DialogDescription className="text-sm text-gray-600 leading-relaxed">
              Create a QR code that allows people to quickly join "{memory?.title || 'Cancun - Mexico'}" as collaborators.
            </DialogDescription>
          </DialogHeader>

          <div className="space-y-5">
            {/* Default Role Selection */}
            <div className="space-y-2">
              <label className="text-sm font-medium text-gray-700">Default Role for New Collaborators</label>
              <div className="space-y-2">
                {/* View Option */}
                <div
                  className={`flex items-start justify-between p-2.5 rounded-lg border-2 cursor-pointer transition-all ${
                    selectedRole === 'view'
                      ? 'border-[#6C60FF] bg-[#6C60FF]/5'
                      : 'border-gray-200 hover:border-gray-300'
                  }`}
                  onClick={() => setSelectedRole('view')}
                >
                  <div className="flex-1">
                    <div className="flex items-center justify-between mb-0.5">
                      <span className="font-medium text-gray-900 text-sm">View</span>
                      {selectedRole === 'view' && (
                        <Badge className="bg-gray-100 text-gray-700 border-0 text-xs">View</Badge>
                      )}
                    </div>
                    <p className="text-xs text-gray-600">Can view and comment on the memory</p>
                  </div>
                </div>

                {/* Collaborator Option */}
                <div
                  className={`flex items-start justify-between p-2.5 rounded-lg border-2 cursor-pointer transition-all ${
                    selectedRole === 'edit'
                      ? 'border-[#6C60FF] bg-[#6C60FF]/5'
                      : 'border-gray-200 hover:border-gray-300'
                  }`}
                  onClick={() => setSelectedRole('edit')}
                >
                  <div className="flex-1">
                    <div className="flex items-center justify-between mb-0.5">
                      <span className="font-medium text-gray-900 text-sm">Collaborator</span>
                      {selectedRole === 'edit' && (
                        <Badge className="bg-cyan-100 text-cyan-700 border-0 text-xs">Collaborator</Badge>
                      )}
                    </div>
                    <p className="text-xs text-gray-600">Can add photos and edit content</p>
                  </div>
                </div>

                {/* Contributor Option */}
                <div
                  className={`flex items-start justify-between p-2.5 rounded-lg border-2 cursor-pointer transition-all ${
                    selectedRole === 'contributor'
                      ? 'border-[#6C60FF] bg-[#6C60FF]/5'
                      : 'border-gray-200 hover:border-gray-300'
                  }`}
                  onClick={() => setSelectedRole('contributor')}
                >
                  <div className="flex-1">
                    <div className="flex items-center justify-between mb-0.5">
                      <span className="font-medium text-gray-900 text-sm">Contributor</span>
                      {selectedRole === 'contributor' && (
                        <Badge className="bg-[#6C60FF] text-white border-0 text-xs">Contributor</Badge>
                      )}
                    </div>
                    <p className="text-xs text-gray-600">Enhanced content creation abilities with AI features</p>
                  </div>
                </div>
              </div>
            </div>

            {/* Shareable Link */}
            <div className="space-y-2">
              <label className="text-sm font-medium text-gray-700">Shareable Link</label>
              <div className="flex items-center gap-2">
                <Input
                  value={isGeneratingLink ? 'Generating link...' : (generatedShareLink || 'Loading...')}
                  readOnly
                  className="flex-1 bg-gray-50 border-gray-200 text-sm"
                  disabled={isGeneratingLink}
                />
                <Button
                  variant="ghost"
                  size="sm"
                  onClick={() => {
                    if (generatedShareLink) {
                      navigator.clipboard.writeText(generatedShareLink);
                      setCopiedQRLink(true);
                      setTimeout(() => setCopiedQRLink(false), 2000);
                      toast.success("Link copied to clipboard");
                    }
                  }}
                  className="flex-shrink-0"
                  disabled={isGeneratingLink || !generatedShareLink}
                >
                  {copiedQRLink ? (
                    <CheckCircle className="w-4 h-4 text-green-500" />
                  ) : (
                    <Copy className="w-4 h-4" />
                  )}
                </Button>
              </div>
            </div>

            {/* QR Code */}
            <div className="space-y-2">
              <label className="text-sm font-medium text-gray-700">QR Code</label>
              <div className="flex justify-center p-4 bg-gray-50 rounded-lg border border-gray-200">
                {isGeneratingLink ? (
                  <div className="flex items-center justify-center h-[200px]">
                    <div className="w-8 h-8 border-2 border-[#6C60FF] border-t-transparent rounded-full animate-spin"></div>
                  </div>
                ) : generatedShareLink ? (
                  <div className="bg-white p-3 rounded shadow-sm">
                    <QRCodeSVG
                      value={generatedShareLink}
                      size={160}
                      level="M"
                      includeMargin={true}
                    />
                  </div>
                ) : (
                  <div className="flex items-center justify-center h-[200px] text-gray-400">
                    <p className="text-sm">Loading QR code...</p>
                  </div>
                )}
              </div>
              <p className="text-xs text-center text-gray-500">
                Scan with any QR code reader to join the memory with {selectedRole} access
              </p>
            </div>

            {/* Share Options */}
            <div className="space-y-2">
              <label className="text-sm font-medium text-gray-700">Share Options</label>
              <div className="grid grid-cols-1 gap-2">
                <Button
                  variant="outline"
                  onClick={() => {
                    if (generatedShareLink) {
                      window.location.href = `mailto:?subject=Join my memory on Stasht&body=Join my memory: ${generatedShareLink}`;
                    }
                  }}
                  className="flex items-center gap-2 justify-start border border-gray-200 hover:bg-gray-50"
                  disabled={isGeneratingLink || !generatedShareLink}
                >
                  <Mail className="w-4 h-4" />
                  Email Invite
                </Button>
                <Button
                  variant="outline"
                  onClick={() => {
                    // Download QR code functionality
                    const svg = document.querySelector('svg[role="img"]');
                    if (svg) {
                      const svgData = new XMLSerializer().serializeToString(svg);
                      const canvas = document.createElement("canvas");
                      const ctx = canvas.getContext("2d");
                      const img = new Image();
                      img.onload = () => {
                        canvas.width = img.width;
                        canvas.height = img.height;
                        ctx?.drawImage(img, 0, 0);
                        const pngFile = canvas.toDataURL("image/png");
                        const downloadLink = document.createElement("a");
                        downloadLink.download = `${memory?.title || 'memory'}-qr-code.png`;
                        downloadLink.href = pngFile;
                        downloadLink.click();
                      };
                      img.src = "data:image/svg+xml;base64," + btoa(svgData);
                    }
                    toast.success("QR code downloaded");
                  }}
                  className="flex items-center gap-2 justify-start border border-gray-200 hover:bg-gray-50"
                  disabled={isGeneratingLink || !generatedShareLink}
                >
                  <Download className="w-4 h-4" />
                  Download QR
                </Button>
                <Button
                  variant="outline"
                  onClick={() => {
                    if (generatedShareLink) {
                      navigator.clipboard.writeText(generatedShareLink);
                      toast.success("Link copied to clipboard");
                    }
                  }}
                  className="flex items-center gap-2 justify-start border border-gray-200 hover:bg-gray-50"
                  disabled={isGeneratingLink || !generatedShareLink}
                >
                  <Copy className="w-4 h-4" />
                  Copy Shareable Link
                </Button>
              </div>
            </div>

            {/* Done Button */}
            <div className="flex justify-end pt-1">
              <Button
                onClick={() => setIsGenerateQROpen(false)}
                className="bg-[#6C60FF] hover:bg-[#5A52E6] text-white"
              >
                Done
              </Button>
            </div>
          </div>
        </DialogContent>
      </Dialog>

      {/* Publishing Progress Bar */}
      {isPublishing && (
        <div className="fixed top-12 left-0 right-0 bg-white border-b border-gray-200 shadow-sm z-50">
          <div className="px-6 py-4">
            <div className="flex items-center gap-4">
              <div className="flex-1">
                <div className="flex items-center justify-between mb-2">
                  <span className="text-sm font-medium text-gray-900">Publishing Memory...</span>
                  <span className="text-sm text-gray-500">{publishProgress}%</span>
                </div>
                <Progress value={publishProgress} className="h-2" />
              </div>
              <div className="w-8 h-8 rounded-full border-2 border-[#6C60FF] border-t-transparent animate-spin"></div>
            </div>
          </div>
        </div>
      )}

      {/* Memory Update Loading Overlay */}
      {isUpdatingMemory && (
        <div className="absolute inset-0 bg-white bg-opacity-80 flex items-center justify-center z-40">
          <div className="flex flex-col items-center gap-3">
            <div className="w-8 h-8 rounded-full border-2 border-[#7B68EE] border-t-transparent animate-spin"></div>
            <span className="text-sm font-medium text-gray-700">Updating memory...</span>
          </div>
        </div>
      )}

      {/* Publish Success Modal */}
      <Dialog open={isPublishModalOpen} onOpenChange={setIsPublishModalOpen}>
        <DialogContent className="sm:max-w-lg bg-white">
          <DialogHeader>
            <DialogTitle className="flex items-center gap-2">
              <CheckCircle className="w-5 h-5 text-green-500" />
              Memory Published Successfully!
            </DialogTitle>
            <DialogDescription>
              Your memory is now live and can be shared with others using the link or QR code below.
            </DialogDescription>
          </DialogHeader>
          
          <div className="space-y-6">
            {/* Published URL */}
            <div className="space-y-2">
              <label className="text-sm font-medium text-gray-700">Public URL</label>
              <div className="flex items-center gap-2">
                <Input
                  value={publishedUrl}
                  readOnly
                  className="flex-1 bg-gray-50 border-gray-200"
                />
                <Button
                  variant="outline"
                  size="sm"
                  onClick={handleCopyPublishLink}
                  className="flex-shrink-0"
                >
                  {copiedPublishLink ? (
                    <CheckCircle className="w-4 h-4 text-green-500" />
                  ) : (
                    <Copy className="w-4 h-4" />
                  )}
                </Button>
              </div>
            </div>

            {/* QR Code Section */}
            <div className="space-y-3">
              <label className="text-sm font-medium text-gray-700">QR Code</label>
              <div className="flex justify-center p-4 bg-gray-50 rounded-lg border border-gray-200">
                <div className="bg-white p-3 rounded-lg shadow-sm">
                  <QRCodeSVG
                    value={publishedUrl}
                    size={120}
                    level="M"
                    includeMargin={true}
                  />
                </div>
              </div>
              <p className="text-xs text-center text-gray-500">
                Scan with your phone to open the memory
              </p>
            </div>

            {/* Share Options */}
            <div className="space-y-3">
              <label className="text-sm font-medium text-gray-700">Share Options</label>
              <div className="grid grid-cols-2 gap-2">
                <Button
                  variant="outline"
                  onClick={handleEmailShare}
                  className="flex items-center gap-2 justify-start"
                >
                  <Mail className="w-4 h-4" />
                  Email
                </Button>
                <Button
                  variant="outline"
                  onClick={handleCopyPublishLink}
                  className="flex items-center gap-2 justify-start"
                >
                  <Link className="w-4 h-4" />
                  Copy Link
                </Button>
                <Button
                  variant="outline"
                  onClick={handleTwitterShare}
                  className="flex items-center gap-2 justify-start"
                >
                  <svg className="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                  </svg>
                  X
                </Button>
                <Button
                  variant="outline"
                  onClick={handleFacebookShare}
                  className="flex items-center gap-2 justify-start"
                >
                  <Facebook className="w-4 h-4" />
                  Facebook
                </Button>
              </div>
            </div>

            {/* Close Button */}
            <div className="flex justify-end pt-4">
              <Button onClick={() => setIsPublishModalOpen(false)}>
                Done
              </Button>
            </div>
          </div>
        </DialogContent>
      </Dialog>

      {/* Main Content */}
      <div className="space-y-4 md:space-y-8 lg:pr-[28rem]" style={{ paddingTop: isPublishing ? '120px' : '0' }}>
        {/* Header */}
        <div className="sticky top-20 relative bg-gray-50 z-10 p-4 md:px-0 flex sm:flex-row items-start sm:items-center justify-between gap-3 sm:gap-0">
          <Button variant="ghost" size="sm" onClick={onBack} className="hover:bg-gray-100 text-xs md:text-sm">
            <ArrowLeft className="w-6 h-6 md:w-4 md:h-4 mr-1 md:mr-2" />
            <span className="hidden sm:inline">Back to Memories</span>
            <span className="sm:hidden text-base">Back</span>
          </Button>
          <div className="flex items-center gap-2 lg:mr-8">
            {/* Hide Edit button for Suggested category memories */}
            {!isSuggestedCategory && (
              <Popover open={isEditPopoverOpen} onOpenChange={setIsEditPopoverOpen}>
                <PopoverTrigger asChild>
                  <Button variant="ghost" size="sm" onClick={handleEdit} className="bg-white hover:bg-gray-50 border border-gray-200 shadow-sm outline-none focus:outline-none focus:ring-0 focus-visible:ring-0">
                    <Edit className="w-6 h-6 md:w-4 md:h-4 mr-2" />
                    Edit
                  </Button>
                </PopoverTrigger>
              <PopoverContent className="w-96 bg-white border-0 shadow-lg rounded-lg" align="end">
                <div className="space-y-4">
                  {/* Header */}
                  <div className="flex items-center justify-between">
                    <h4 className="font-semibold text-lg text-gray-900">Edit Memory</h4>
                    <Button
                      variant="ghost"
                      size="sm"
                      onClick={handleEditCancel}
                      className="h-8 w-8 p-0 hover:bg-gray-100 rounded-full"
                    >
                      <X className="h-4 w-4 text-gray-400" />
                    </Button>
                  </div>

                  {/* Edit Form */}
                  <div className="space-y-4">
                    {/* Title */}
                    <div>
                      <label className="text-sm font-medium text-gray-700 block mb-2">
                        Title
                      </label>
                      <Input
                        value={editData.title}
                        onChange={(e) => setEditData(prev => ({ ...prev, title: e.target.value }))}
                        placeholder="Enter memory title..."
                        className="w-full bg-white border border-gray-200 hover:border-[#6C60FF] focus:border-[#6C60FF] focus:ring-0 transition-all duration-200"
                      />
                    </div>

                    {/* Category */}
                    <div>
                      <label className="text-sm font-medium text-gray-700 block mb-2">
                        Category
                      </label>
                      <Select value={editData.category} onValueChange={(value) => setEditData(prev => ({ ...prev, category: value }))}>
                        <SelectTrigger className="w-full bg-white border border-gray-200 hover:border-[#6C60FF] focus:border-[#6C60FF] focus:ring-0 transition-all duration-200">
                          <SelectValue placeholder="Select category..." />
                        </SelectTrigger>
                        <SelectContent className="bg-white border border-gray-200 shadow-lg">
                          {(apiCategories.length > 0 ? apiCategories : categories)
                            .filter((category) => category.name !== "Shared With" && category.name !== "Published")
                            .map((category) => (
                              <SelectItem
                                key={category.name}
                                value={category.name}
                                className="hover:bg-[#6C60FF]/10 focus:bg-[#6C60FF]/10 data-[highlighted]:bg-[#6C60FF]/10 cursor-pointer"
                              >
                                {category.name}
                              </SelectItem>
                            ))}
                        </SelectContent>
                      </Select>
                    </div>

                    {/* Label */}
                    {apiLabels.length > 0 && (
                      <div>
                        <label className="text-sm font-medium text-gray-700 block mb-2">
                          Label
                        </label>
                        <div className="flex flex-wrap gap-2">
                          {apiLabels.map((label) => (
                            <button
                              key={label.name}
                              type="button"
                              onClick={() => setEditData(prev => ({ ...prev, label: label.name }))}
                              className={`px-3 py-1.5 rounded-lg text-sm font-medium transition-all duration-200 ${
                                editData.label === label.name
                                  ? 'bg-[#ffd460] text-[#393131] border border-[#ffd460]'
                                  : 'bg-gray-100 text-gray-700 border border-gray-200 hover:bg-[#6C60FF]/10 hover:border-[#6C60FF]/30 hover:text-[#6C60FF]'
                              }`}
                            >
                              {label.name}
                            </button>
                          ))}
                        </div>
                      </div>
                    )}

                    {/* Date Range */}
                    <div>
                      <label className="text-sm font-medium text-gray-700 block mb-2">
                        Date Range
                      </label>
                      <DateRangePicker
                        value={editData.dateRange}
                        onChange={(value) => {
                          console.log('📝 MemoryDetailsPage received new date value:', value);
                          setEditData(prev => {
                            console.log('📝 Updating editData.dateRange from', prev.dateRange, 'to', value);
                            return { ...prev, dateRange: value };
                          });
                        }}
                        placeholder="Select date range"
                      />
                    </div>

                    {/* Location */}
                    <div>
                      <label className="text-sm font-medium text-gray-700 block mb-2">
                        Location
                      </label>
                      <GooglePlacesInput
                        value={editData.location}
                        onChange={(value) => setEditData(prev => ({ ...prev, location: value }))}
                        placeholder="Enter location..."
                        className="w-full bg-white border border-gray-200 hover:border-[#6C60FF] focus:border-[#6C60FF] focus:ring-0 transition-all duration-200"
                        onPlaceSelect={(place) => {
                          console.log('Selected place:', place);
                          // You can add additional logic here when a place is selected
                        }}
                      />
                    </div>
                  </div>

                  {/* Action Buttons */}
                  <div className="flex items-center justify-between pt-4 border-t border-gray-100">
                    {/* Delete Button - Left Side */}
                    <Button
                      variant="ghost"
                      onClick={() => setShowDeleteDialog(true)}
                      className="text-red-600 hover:text-red-700 hover:bg-red-50 flex-shrink-0"
                      size="sm"
                    >
                      <Trash2 className="h-4 w-4 mr-2" />
                      Delete
                    </Button>
                    
                    {/* Cancel and Save Buttons - Right Side */}
                    <div className="flex items-center gap-2 flex-shrink-0">
                      <Button
                        variant="ghost"
                        onClick={handleEditCancel}
                        className="text-gray-500 hover:text-gray-700"
                        size="sm"
                      >
                        Cancel
                      </Button>
                      <Button
                        onClick={handleEditSave}
                        className="bg-[#6C60FF] hover:bg-[#6C60FF]/90 text-white"
                        size="sm"
                      >
                        <Save className="h-4 w-4 mr-2" />
                        Save
                      </Button>
                    </div>
                  </div>
                </div>
              </PopoverContent>
            </Popover>
            )}

            {/* Hide Add a Moment button for Suggested category and for viewers */}
            {!isSuggestedCategory && currentUserRole !== 'viewer' && (
              <Button
                ref={addMomentButtonRef}
                onClick={() => setIsAddMomentModalOpen(true)}
                size="sm"
                className="bg-[#6C60FF] hover:bg-[#5B4FE8] text-white disabled:opacity-50 disabled:cursor-not-allowed hidden md:flex"
                disabled={isAddMomentModalOpen}
              >
                <Plus className="w-4 h-4 sm:mr-2" />
                <span className="">Add a Moment</span>
              </Button>
            )}

            {/* Hide Publish button for Suggested category */}
            {!isSuggestedCategory && (
              (apiMemoryData?.published === 1 || apiMemoryData?.published === 2 || apiMemoryData?.published === 3) ? (
                <Button
                  variant="outline"
                  size="sm"
                  onClick={() => handlePublish()}
                  disabled={isPublishing}
                  className="hidden lg:flex hover:bg-red-500 hover:text-white border-red-500 text-red-500 disabled:opacity-50 disabled:cursor-not-allowed"
                >
                  {isPublishing ? (
                    <>
                      <div className="w-4 h-4 mr-2 animate-spin rounded-full border-2 border-red-500 border-t-transparent" />
                      Unpublishing...
                    </>
                  ) : (
                    <>
                      <Globe className="w-4 h-4 mr-2" />
                      Unpublish
                    </>
                  )}
                </Button>
              ) : (
                <Popover open={isPublishOptionsModalOpen} onOpenChange={setIsPublishOptionsModalOpen}>
                  <PopoverTrigger asChild>
                    <Button
                      variant="outline"
                      size="sm"
                      disabled={isPublishing}
                      className="hidden lg:flex hover:bg-[#6C60FF] hover:text-white border-[#6C60FF] text-[#6C60FF] disabled:opacity-50 disabled:cursor-not-allowed"
                    >
                      {isPublishing ? (
                        <>
                          <div className="w-4 h-4 mr-2 animate-spin rounded-full border-2 border-[#6C60FF] border-t-transparent" />
                          Publishing...
                        </>
                      ) : (
                        <>
                          <Globe className="w-4 h-4 mr-2" />
                          Publish
                        </>
                      )}
                    </Button>
                  </PopoverTrigger>
                  <PopoverContent className="w-80 p-4 bg-white border-0 shadow-xl" align="end">
                    <div className="space-y-3">
                      {/* View Only Option */}
                      <button
                        onClick={() => {
                          setSelectedPublishOption('view-only');
                          setIsPublishOptionsModalOpen(false);
                          setTimeout(() => handlePublish(2), 100); // view-only = 2
                        }}
                        className="w-full p-3 rounded-lg hover:bg-gray-50 transition-all text-left"
                      >
                        <div className="flex items-start gap-3">
                          <Eye className="w-6 h-6 text-gray-600 flex-shrink-0 mt-0.5" />
                          <div className="flex-1">
                            <h3 className="font-semibold text-gray-900 mb-1">View Only</h3>
                            <p className="text-sm text-gray-500">Users can only view the memory, no comments allowed</p>
                          </div>
                        </div>
                      </button>

                      {/* Public Option */}
                      <button
                        onClick={() => {
                          setSelectedPublishOption('public');
                          setIsPublishOptionsModalOpen(false);
                          setTimeout(() => handlePublish(1), 100); // public = 1
                        }}
                        className="w-full p-3 rounded-lg hover:bg-gray-50 transition-all text-left"
                      >
                        <div className="flex items-start gap-3">
                          <Globe className="w-6 h-6 text-[#6C60FF] flex-shrink-0 mt-0.5" />
                          <div className="flex-1">
                            <h3 className="font-semibold text-gray-900 mb-1">Public</h3>
                            <p className="text-sm text-gray-500">Anyone can view and leave comments</p>
                          </div>
                        </div>
                      </button>

                      {/* Private Option */}
                      <button
                        onClick={() => {
                          setSelectedPublishOption('private');
                          setIsPublishOptionsModalOpen(false);
                          setTimeout(() => handlePublish(3), 100); // private = 3
                        }}
                        className="w-full p-3 rounded-lg hover:bg-gray-50 transition-all text-left"
                      >
                        <div className="flex items-start gap-3">
                          <Lock className="w-6 h-6 text-orange-600 flex-shrink-0 mt-0.5" />
                          <div className="flex-1">
                            <h3 className="font-semibold text-gray-900 mb-1">Private</h3>
                            <p className="text-sm text-gray-500">Only visible with a valid access token</p>
                          </div>
                        </div>
                      </button>
                    </div>
                  </PopoverContent>
                </Popover>
              )
            )}
          </div>
        </div>

        {/* Published Link Display */}
        {(apiMemoryData?.published === 1 || apiMemoryData?.published === 2 || apiMemoryData?.published === 3) && apiMemoryData?.published_url && (
          <div className="bg-gradient-to-r from-green-50 to-emerald-50 border border-green-200 rounded-lg p-4 shadow-sm">
            <div className="flex items-center gap-3">
              <div className="flex-shrink-0">
                <div className="w-10 h-10 bg-green-100 rounded-full flex items-center justify-center">
                  <Globe className="w-5 h-5 text-green-600" />
                </div>
              </div>
              <div className="flex-1 min-w-0">
                <div className="flex items-center gap-2 mb-1">
                  <h4 className="text-sm font-semibold text-green-800">Published Memory</h4>
                  <Badge variant="secondary" className="bg-green-100 text-green-700 border-green-200 text-xs">
                    Live
                  </Badge>
                  {/* Privacy Badge */}
                  {apiMemoryData?.published === 1 && (
                    <Badge variant="secondary" className="bg-blue-100 text-blue-700 border-blue-200 text-xs">
                      Public
                    </Badge>
                  )}
                  {apiMemoryData?.published === 2 && (
                    <Badge variant="secondary" className="bg-yellow-100 text-yellow-700 border-yellow-200 text-xs">
                      View Only
                    </Badge>
                  )}
                  {apiMemoryData?.published === 3 && (
                    <Badge variant="secondary" className="bg-red-100 text-red-700 border-red-200 text-xs">
                      Private
                    </Badge>
                  )}
                  {/* Shared with badge - only show for collaborators */}
                  {(currentUserRole === 'contributor' || currentUserRole === 'viewer') && (
                    <Badge variant="secondary" className="bg-red-500 text-white text-xs">
                      Shared with
                    </Badge>
                  )}
                </div>
                <div className="flex items-center gap-2">
                  <Input
                    value={apiMemoryData.published_url}
                    readOnly
                    className="flex-1 text-sm bg-white border-green-200 text-gray-700 h-9"
                  />
                  <Button
                    variant="outline"
                    size="sm"
                    onClick={async () => {
                      try {
                        await navigator.clipboard.writeText(apiMemoryData.published_url);
                        toast.success("Link copied to clipboard");
                      } catch (error) {
                        toast.error("Failed to copy link");
                      }
                    }}
                    className="flex-shrink-0 h-9 px-3 bg-white hover:bg-green-50 border-green-200 text-green-700"
                  >
                    <Copy className="w-4 h-4 md:mr-1" />
                    <span className="hidden md:inline">Copy</span>
                  </Button>

                  {/* Share Button with Dropdown Menu */}
                  <div className="relative" ref={shareMenuRef}>
                    <Button
                      variant="outline"
                      size="sm"
                      className="flex-shrink-0 h-9 px-3 bg-white hover:bg-green-50 border-green-200 text-green-700"
                      onClick={() => setIsSharePopoverOpen(!isSharePopoverOpen)}
                    >
                      <Share2 className="w-4 h-4 md:mr-1" />
                      <span className="hidden md:inline">Share</span>
                    </Button>

                    {/* Share Menu Dropdown */}
                    {isSharePopoverOpen && (
                      <div className="absolute top-full right-0 mt-2 w-64 bg-white rounded-lg shadow-2xl border border-gray-200 py-2 z-50">
                        <button
                          onClick={() => {
                            navigator.clipboard.writeText(apiMemoryData.published_url).then(() => {
                              toast.success("Link copied to clipboard!");
                              setIsSharePopoverOpen(false);
                            }).catch(() => {
                              toast.error("Failed to copy link");
                            });
                          }}
                          className="w-full px-4 py-3 flex items-center gap-3 hover:bg-gray-50 transition-colors text-left"
                        >
                          <Link className="w-5 h-5 text-gray-700" />
                          <span className="text-gray-900 font-medium">Copy Link</span>
                        </button>

                        <button
                          onClick={() => {
                            // Validate required data before sharing
                            if (!apiMemoryData?.published_url) {
                              toast.error("Published URL not available. Please try again.");
                              console.error('Facebook share failed: No published URL');
                              return;
                            }

                            console.log('Sharing to Facebook:', {
                              url: apiMemoryData.published_url,
                              title: uiMemory.title,
                              description: uiMemory.description,
                              image: uiMemory.thumbnail
                            });

                            // Check if this is a localhost URL
                            const isLocalhost = apiMemoryData.published_url.includes('localhost') ||
                                              apiMemoryData.published_url.includes('127.0.0.1') ||
                                              apiMemoryData.published_url.includes('192.168.');

                            if (isLocalhost) {
                              // For localhost, copy to clipboard and show instructions
                              navigator.clipboard.writeText(apiMemoryData.published_url).then(() => {
                                toast.warning("Local development URL detected! Link copied to clipboard.", {
                                  description: "Facebook can't preview localhost URLs. Please paste the link directly into Facebook, or deploy your app to test social sharing.",
                                  duration: 6000
                                });
                                setIsSharePopoverOpen(false);
                              }).catch(() => {
                                toast.error("Unable to share localhost URL. Please deploy to production to test social sharing.");
                                setIsSharePopoverOpen(false);
                              });
                              return;
                            }

                            // For production URLs, use Facebook with pre-filled text
                            const authorName = apiMemoryData?.user?.name || 'Unknown';
                            const postText = `${uiMemory.title}\n\nShared by ${authorName}${uiMemory.description ? `\n\n${uiMemory.description.substring(0, 150)}` : ''}\n\n${apiMemoryData.published_url}`;

                            // Copy post text to clipboard for user to paste
                            navigator.clipboard.writeText(postText).then(() => {
                              // Show alert so user knows content is copied before Facebook opens
                              alert("Memory details copied to clipboard!\n\nPress Ctrl+V (or Cmd+V) to paste in your Facebook post.");
                              // Open Facebook after user dismisses alert
                              window.open(`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(apiMemoryData.published_url)}`, 'facebook-share-dialog', 'width=800,height=600');
                            }).catch(() => {
                              // Still open Facebook even if clipboard fails
                              window.open(`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(apiMemoryData.published_url)}`, 'facebook-share-dialog', 'width=800,height=600');
                            });

                            setIsSharePopoverOpen(false);

                            // Show a helpful message
                            setTimeout(() => {
                              toast.info("Sharing to Facebook", {
                                description: "If the preview doesn't appear immediately, Facebook may still be fetching the page data. This can take a few moments for newly published pages.",
                                duration: 5000
                              });
                            }, 500);
                          }}
                          className="w-full px-4 py-3 flex items-center gap-3 hover:bg-gray-50 transition-colors text-left"
                        >
                          <Facebook className="w-5 h-5 text-gray-700" />
                          <span className="text-gray-900 font-medium">Share on Facebook</span>
                        </button>

                        <button
                          onClick={() => {
                            // Validate required data before sharing
                            if (!apiMemoryData?.published_url) {
                              toast.error("Published URL not available. Please try again.");
                              console.error('Twitter/X share failed: No published URL');
                              return;
                            }

                            const title = uiMemory.title || 'Check out this memory';
                            const authorName = apiMemoryData?.user?.name || 'Unknown';
                            const description = uiMemory.description ? `\n\n${uiMemory.description.substring(0, 100)}${uiMemory.description.length > 100 ? '...' : ''}` : '';

                            // Build post text with title, author, description
                            const postText = `${title}\n\nShared by ${authorName}${description}`;

                            console.log('Sharing to Twitter/X:', {
                              url: apiMemoryData.published_url,
                              title: title,
                              text: postText
                            });

                            // Check if this is a localhost URL
                            const isLocalhost = apiMemoryData.published_url.includes('localhost') ||
                                              apiMemoryData.published_url.includes('127.0.0.1') ||
                                              apiMemoryData.published_url.includes('192.168.');

                            if (isLocalhost) {
                              // For localhost, copy to clipboard and show instructions
                              navigator.clipboard.writeText(apiMemoryData.published_url).then(() => {
                                toast.warning("Local development URL detected! Link copied to clipboard.", {
                                  description: "Twitter/X can't preview localhost URLs. Deploy your app to production to test social sharing.",
                                  duration: 6000
                                });
                                setIsSharePopoverOpen(false);
                              }).catch(() => {
                                toast.error("Unable to share localhost URL.");
                                setIsSharePopoverOpen(false);
                              });
                              return;
                            }

                            // Twitter/X - pre-fill post with memory details and URL
                            window.open(`https://twitter.com/intent/tweet?text=${encodeURIComponent(postText)}&url=${encodeURIComponent(apiMemoryData.published_url)}`, 'twitter-share-dialog', 'width=800,height=600');
                            setIsSharePopoverOpen(false);

                            // Show helpful message for production URLs
                            setTimeout(() => {
                              toast.info("Sharing to X/Twitter", {
                                description: "Card preview may take a moment to appear as X fetches your page data.",
                                duration: 4000
                              });
                            }, 500);
                          }}
                          className="w-full px-4 py-3 flex items-center gap-3 hover:bg-gray-50 transition-colors text-left"
                        >
                          <svg className="w-5 h-5 text-gray-700" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                          </svg>
                          <span className="text-gray-900 font-medium">Share on X</span>
                        </button>

                        <button
                          onClick={() => {
                            // Validate required data before sharing
                            if (!apiMemoryData?.published_url) {
                              toast.error("Published URL not available. Please try again.");
                              console.error('LinkedIn share failed: No published URL');
                              return;
                            }

                            console.log('Sharing to LinkedIn:', {
                              url: apiMemoryData.published_url,
                              title: uiMemory.title,
                              description: uiMemory.description
                            });

                            // Check if this is a localhost URL
                            const isLocalhost = apiMemoryData.published_url.includes('localhost') ||
                                              apiMemoryData.published_url.includes('127.0.0.1') ||
                                              apiMemoryData.published_url.includes('192.168.');

                            if (isLocalhost) {
                              // For localhost, copy to clipboard and show instructions
                              navigator.clipboard.writeText(apiMemoryData.published_url).then(() => {
                                toast.warning("Local development URL detected! Link copied to clipboard.", {
                                  description: "LinkedIn can't preview localhost URLs. Deploy your app to production to test social sharing.",
                                  duration: 6000
                                });
                                setIsSharePopoverOpen(false);
                              }).catch(() => {
                                toast.error("Unable to share localhost URL.");
                                setIsSharePopoverOpen(false);
                              });
                              return;
                            }

                            // LinkedIn share - pre-fill post text with memory details in a professional format
                            const authorName = apiMemoryData?.user?.name || 'Unknown';

                            // Format the post text for LinkedIn with proper structure
                            let postText = `✨ ${uiMemory.title}\n\n`;

                            if (uiMemory.description) {
                              // Limit description to 200 characters for better readability
                              const description = uiMemory.description.length > 200
                                ? uiMemory.description.substring(0, 200) + '...'
                                : uiMemory.description;
                              postText += `${description}\n\n`;
                            }

                            postText += `👤 Shared by: ${authorName}\n\n`;
                            postText += `🔗 View the full memory:\n${apiMemoryData.published_url}`;

                            // Use LinkedIn feed share with text parameter
                            const linkedInUrl = `https://www.linkedin.com/feed/?shareActive=true&text=${encodeURIComponent(postText)}`;
                            window.open(linkedInUrl, 'linkedin-share-dialog', 'width=800,height=600');
                            setIsSharePopoverOpen(false);

                            // Show helpful message for production URLs
                            setTimeout(() => {
                              toast.info("Sharing to LinkedIn", {
                                description: "Preview may take a moment to load as LinkedIn fetches your page data.",
                                duration: 4000
                              });
                            }, 500);
                          }}
                          className="w-full px-4 py-3 flex items-center gap-3 hover:bg-gray-50 transition-colors text-left"
                        >
                          <Linkedin className="w-5 h-5 text-gray-700" />
                          <span className="text-gray-900 font-medium">Share on LinkedIn</span>
                        </button>

                        {/* Separator */}
                        <div className="border-t border-gray-200 my-1"></div>

                        <button
                          onClick={() => {
                            const embedCode = `<iframe src="${apiMemoryData.published_url}" width="600" height="800" frameborder="0"></iframe>`;
                            navigator.clipboard.writeText(embedCode).then(() => {
                              toast.success("Embed code copied to clipboard!");
                              setIsSharePopoverOpen(false);
                            }).catch(() => {
                              toast.error("Failed to copy embed code");
                            });
                          }}
                          className="w-full px-4 py-3 flex items-center gap-3 hover:bg-gray-50 transition-colors text-left"
                        >
                          <Code className="w-5 h-5 text-gray-700" />
                          <span className="text-gray-900 font-medium">Embed Code</span>
                        </button>
                      </div>
                    )}
                  </div>

                  {/* QR Code Button with Popover */}
                  <Popover open={isQRPopoverOpen} onOpenChange={setIsQRPopoverOpen}>
                    <PopoverTrigger asChild>
                      <Button
                        variant="outline"
                        size="sm"
                        className="flex-shrink-0 h-9 px-3 bg-white hover:bg-green-50 border-green-200 text-green-700"
                      >
                        <QrCode className="w-4 h-4 md:mr-1" />
                        <span className="hidden md:inline">QR Code</span>
                      </Button>
                    </PopoverTrigger>
                    <PopoverContent className="w-64 p-4 bg-white border border-gray-200 shadow-lg" align="end">
                      <div className="space-y-3">
                        <h4 className="font-semibold text-sm text-gray-900 text-center">Scan to View</h4>
                        <div className="flex justify-center p-3 bg-gray-50 rounded-lg border border-gray-200">
                          <div className="bg-white p-2 rounded-lg shadow-sm" id="qr-code-container">
                            <QRCodeSVG
                              value={apiMemoryData.published_url}
                              size={140}
                              level="M"
                              includeMargin={true}
                            />
                          </div>
                        </div>
                        <p className="text-xs text-center text-gray-500">
                          Scan with your phone to open the memory
                        </p>
                        <Button
                          variant="outline"
                          size="sm"
                          onClick={() => {
                            const container = document.getElementById('qr-code-container');
                            const svg = container?.querySelector('svg');
                            if (svg) {
                              const svgData = new XMLSerializer().serializeToString(svg);
                              const canvas = document.createElement('canvas');
                              const ctx = canvas.getContext('2d');
                              const img = new Image();

                              img.onload = () => {
                                canvas.width = svg.width.baseVal.value;
                                canvas.height = svg.height.baseVal.value;

                                if (ctx) {
                                  // Fill white background
                                  ctx.fillStyle = 'white';
                                  ctx.fillRect(0, 0, canvas.width, canvas.height);
                                  // Draw QR code
                                  ctx.drawImage(img, 0, 0);

                                  // Convert to PNG and download
                                  canvas.toBlob((blob) => {
                                    if (blob) {
                                      const url = URL.createObjectURL(blob);
                                      const downloadLink = document.createElement('a');
                                      downloadLink.download = `memory-qr-code-${Date.now()}.png`;
                                      downloadLink.href = url;
                                      downloadLink.click();
                                      URL.revokeObjectURL(url);
                                      toast.success("QR Code downloaded");
                                    }
                                  }, 'image/png');
                                }
                              };

                              img.src = 'data:image/svg+xml;base64,' + btoa(unescape(encodeURIComponent(svgData)));
                            } else {
                              toast.error("Failed to download QR Code");
                            }
                          }}
                          className="w-full flex items-center gap-2 justify-center h-8 bg-white hover:bg-gray-50"
                        >
                          <Download className="w-4 h-4" />
                          Download QR Code
                        </Button>
                      </div>
                    </PopoverContent>
                  </Popover>
                </div>
              </div>
            </div>
          </div>
        )}

        {/* Clean Toggle Section */}
        <div className="bg-white rounded-lg border border-gray-200 overflow-hidden">
          <style {...({ jsx: true } as any)}>{`
            .memory-tab-active {
              background-color: white !important;
              color: #6366f1 !important;
            }
            .memory-tab-active [data-slot="tabs-trigger"] {
              background-color: white !important;
            }
            button[aria-selected="true"].memory-tab-active {
              background-color: white !important;
              color: #6366f1 !important;
            }
            .memory-tab-trigger[aria-selected="true"] {
              background-color: white !important;
              color: #6366f1 !important;
            }
          `}</style>
          <Tabs value={activeTab} onValueChange={setActiveTab} className="w-full">
            <div className="bg-gray-50/50 px-1 py-1 hidden lg:block">
              <TabsList className={`grid w-full ${isOwner ? 'grid-cols-4' : 'grid-cols-3'} bg-transparent p-0 h-auto gap-1`}>
                <TabsTrigger
                  value="overview"
                  className={`memory-tab-trigger border-0 rounded-md py-3 px-4 flex items-center justify-center gap-2 text-sm font-medium transition-all duration-200 ${
                    activeTab === "overview"
                      ? 'memory-tab-active bg-white shadow-sm'
                      : 'memory-tab-inactive bg-transparent'
                  }`}
                  style={activeTab === "overview" ? { backgroundColor: 'white !important' } : {}}
                >
                  <BarChart3
                    className="w-4 h-4"
                    style={{ color: activeTab === "overview" ? '#6366f1' : '#6b7280' }}
                  />
                  <span style={{ color: activeTab === "overview" ? '#6366f1' : '#6b7280' }}>
                    Overview
                  </span>
                </TabsTrigger>

                {/* Moderation Tab - Only visible to owner */}
                {isOwner && (
                  <TabsTrigger
                    value="moderation"
                    className={`memory-tab-trigger border-0 rounded-md py-3 px-4 flex items-center justify-center gap-2 text-sm font-medium transition-all duration-200 ${
                      activeTab === "moderation"
                        ? 'memory-tab-active bg-white shadow-sm'
                        : 'memory-tab-inactive bg-transparent'
                    }`}
                    style={activeTab === "moderation" ? { backgroundColor: 'white !important' } : {}}
                  >
                    <Shield
                      className="w-4 h-4"
                      style={{ color: activeTab === "moderation" ? '#6366f1' : '#6b7280' }}
                    />
                    <span style={{ color: activeTab === "moderation" ? '#6366f1' : '#6b7280' }}>
                      Moderation
                    </span>
                    {pendingPostsCount > 0 && (
                      <Badge
                        className="ml-1 h-5 min-w-[20px] flex items-center justify-center px-1.5 bg-indigo-500 text-white text-xs"
                      >
                        {pendingPostsCount}
                      </Badge>
                    )}
                  </TabsTrigger>
                )}

                <TabsTrigger
                  value="analytics"
                  className={`memory-tab-trigger border-0 rounded-md py-3 px-4 flex items-center justify-center gap-2 text-sm font-medium transition-all duration-200 ${
                    activeTab === "analytics"
                      ? 'memory-tab-active bg-white shadow-sm'
                      : 'memory-tab-inactive bg-transparent'
                  }`}
                  style={activeTab === "analytics" ? { backgroundColor: 'white !important' } : {}}
                >
                  <BarChart3
                    className="w-4 h-4"
                    style={{ color: activeTab === "analytics" ? '#6366f1' : '#6b7280' }}
                  />
                  <span style={{ color: activeTab === "analytics" ? '#6366f1' : '#6b7280' }}>
                    Analytics
                  </span>
                </TabsTrigger>
                <TabsTrigger
                  value="collaborators"
                  className={`memory-tab-trigger border-0 rounded-md py-3 px-4 flex items-center justify-center gap-2 text-sm font-medium transition-all duration-200 ${
                    activeTab === "collaborators"
                      ? 'memory-tab-active bg-white shadow-sm'
                      : 'memory-tab-inactive bg-transparent'
                  }`}
                  style={activeTab === "collaborators" ? { backgroundColor: 'white !important' } : {}}
                >
                  <Users
                    className="w-4 h-4"
                    style={{ color: activeTab === "collaborators" ? '#6366f1' : '#6b7280' }}
                  />
                  <span style={{ color: activeTab === "collaborators" ? '#6366f1' : '#6b7280' }}>
                    Collaborators
                  </span>
                </TabsTrigger>
              </TabsList>
            </div>

            <TabsContent value="overview" className="m-0 p-0">
              {/* Overview Content */}
              <div className="flex flex-col lg:flex-row gap-4 md:gap-8 p-2 md:p-3 lg:p-6">
                {/* Memory Wallpaper - 2/3 width */}
                <div className="flex-1 lg:flex-[2]">
                  <div className="relative rounded-xl md:rounded-2xl overflow-hidden shadow-lg bg-white">
                    <div className="relative h-[18rem] sm:h-[20rem] md:h-[24rem] lg:h-[28rem]">
                      {(() => {
                        const rawColor = apiMemoryData?.user?.profile_color || (user as any)?.profile_color;
                        const profileColor = rawColor
                          ? (rawColor.startsWith('#') ? rawColor : `#${rawColor}`)
                          : '#6C60FF';
                        const userInitial = apiMemoryData?.user?.name?.charAt(0) || apiMemoryData?.user?.username?.charAt(0) || (user as any)?.name?.charAt(0) || 'U';
                        return apiMemoryData?.last_update_img || apiMemoryData?.user?.profile_image ? (
                          <ImageWithFallback
                            src={uiMemory.thumbnail}
                            alt={uiMemory.title}
                            className="w-full h-full object-cover"
                            fallback={
                              <div
                                className="w-full h-full flex items-center justify-center"
                                style={{ backgroundColor: profileColor }}
                              >
                                <span className="text-white font-bold text-6xl md:text-8xl uppercase">
                                  {userInitial}
                                </span>
                              </div>
                            }
                          />
                        ) : (
                          <div
                            className="w-full h-full flex items-center justify-center"
                            style={{ backgroundColor: profileColor }}
                          >
                            <span className="text-white font-bold text-6xl md:text-8xl uppercase">
                              {userInitial}
                            </span>
                          </div>
                        );
                      })()}
                      <div className="absolute inset-0 bg-gradient-to-t from-black/70 via-black/30 to-transparent" />
                      
                      {/* Add Cover Photo Button - Hide for Suggested category */}
                      {!isSuggestedCategory && (
                        <div className="absolute top-0 left-0 right-0 p-4 lg:p-8">
                          <div className="flex items-start justify-end">
                            <Popover open={isCoverPhotoMenuOpen} onOpenChange={setIsCoverPhotoMenuOpen}>
                              <PopoverTrigger asChild>
                                <Button
                                  variant="outline"
                                  size="sm"
                                  className="bg-black/30 backdrop-blur-sm border-white/30 text-white hover:bg-black/40 hover:text-white shadow-lg text-xs lg:text-sm"
                                >
                                  <ImageIcon className="w-3 h-3 lg:w-4 lg:h-4 mr-1 lg:mr-2" />
                                  <span className="hidden sm:inline">Edit Cover Photo</span>
                                  <span className="sm:hidden">Edit Cover</span>
                                </Button>
                              </PopoverTrigger>
                              <PopoverContent className="w-64 p-2 bg-white border border-gray-200 shadow-lg" align="end">
                                <div className="flex flex-col gap-1">
                                  <button
                                    onClick={handleUploadFromDesktop}
                                    className="flex items-start gap-3 px-3 py-3 hover:bg-gray-100 rounded-lg text-left transition-colors"
                                  >
                                    <div className="flex-shrink-0 mt-0.5">
                                      <Upload className="w-5 h-5 text-[#6C60FF]" />
                                    </div>
                                    <div className="flex-1">
                                      <div className="text-sm font-medium text-gray-900 hidden md:block">Upload from Desktop</div>
                                      <div className="text-sm font-medium text-gray-900 md:hidden">Take Photo</div>
                                      <div className="text-xs text-gray-500 mt-0.5 md:hidden">Take a photo from your camera or phone library</div>
                                      <div className="text-xs text-gray-500 mt-0.5 hidden md:block">Choose files from your computer</div>
                                    </div>
                                  </button>
                                  <button
                                    onClick={() => {
                                      setIsCoverPhotoMenuOpen(false);
                                      setIsCoverPhotoSelectionMode(true);
                                      setIsMediaLibraryOpen(true);
                                    }}
                                    className="flex items-start gap-3 px-3 py-3 hover:bg-gray-100 rounded-lg text-left transition-colors"
                                  >
                                    <div className="flex-shrink-0 mt-0.5">
                                      <ImageIcon className="w-5 h-5 text-[#6C60FF]" />
                                    </div>
                                    <div className="flex-1">
                                      <div className="text-sm font-medium text-gray-900">Add from Media Library</div>
                                      <div className="text-xs text-gray-500 mt-0.5">Choose from uploaded media</div>
                                    </div>
                                  </button>
                                </div>
                              </PopoverContent>
                            </Popover>
                          </div>
                        </div>
                      )}

                      {/* Bottom content */}
                      <div className="absolute bottom-0 left-0 right-0 p-4 lg:p-8 text-white">
                        <div className="space-y-2 lg:space-y-4">
                          {/* Badges above title */}
                          <div className="flex items-center gap-1.5 sm:gap-2 lg:gap-3 flex-wrap">
                            {/* Category Badge - Show "Shared with" if memory is shared */}
                            <div
                              className="text-white hover:opacity-90 flex items-center justify-center px-2 py-1 sm:px-3 sm:py-1.5 lg:px-4 lg:py-2 rounded-md lg:rounded-lg shadow-lg transition-opacity duration-200 backdrop-blur-sm"
                              style={{ backgroundColor: categoryColorHex }}
                            >
                              <span className="text-[10px] sm:text-xs lg:text-sm font-medium">
                                {isSharedMemory ? 'Shared with' : uiMemory.category}
                              </span>
                            </div>

                            {/* Admin Badge - Show when user is admin collaborator */}
                            {(currentUserRole === 'admin' || currentUserRole?.toLowerCase() === 'admin') && (
                              <Badge
                                variant="secondary"
                                className="bg-white/90 text-red-600 border-white/30 px-2 py-0.5 lg:px-3 lg:py-1 shadow-lg text-xs lg:text-sm flex items-center gap-1"
                              >
                                <Shield className="w-2.5 h-2.5 sm:w-3 sm:h-3 lg:w-4 lg:h-4" />
                                Admin
                              </Badge>
                            )}

                            {/* Subcategory Label - only show if exists */}
                            {uiMemory.tags && uiMemory.tags.length > 0 && (
                              <div className="bg-[#ffd460] text-[#393131] hover:bg-[#ffd460]/90 flex items-center justify-center px-2 py-1 sm:px-3 sm:py-1.5 lg:px-4 lg:py-2 rounded-md lg:rounded-lg shadow-lg transition-colors duration-200 backdrop-blur-sm">
                                <span className="text-[10px] sm:text-xs lg:text-sm font-medium">
                                  {uiMemory.tags[0]}
                                </span>
                              </div>
                            )}

                            {/* Private Badge - Show only when "Shared with" is shown */}
                            {isSharedMemory && (
                              <Badge
                                variant="secondary"
                                className="bg-white/20 backdrop-blur-sm text-white border-white/30 px-2 py-0.5 lg:px-3 lg:py-1 shadow-lg text-xs lg:text-sm"
                              >
                                <Lock className="w-2.5 h-2.5 sm:w-3 sm:h-3 lg:w-4 lg:h-4 mr-1 lg:mr-2" />
                                Private
                              </Badge>
                            )}

                            {/* Public Badge - Show when memory is published and belongs to login user */}
                            {!isSharedMemory && uiMemory.isPublic === true && (
                              <Badge
                                variant="secondary"
                                className="bg-white text-black border-white px-2 py-0.5 lg:px-3 lg:py-1 shadow-lg text-xs lg:text-sm"
                              >
                                <Globe className="w-2.5 h-2.5 sm:w-3 sm:h-3 lg:w-4 lg:h-4 mr-1 lg:mr-2" />
                                Public
                              </Badge>
                            )}
                          </div>

                          <h1 className="text-xl sm:text-2xl md:text-3xl lg:text-5xl font-bold leading-tight">{uiMemory.title}</h1>

                          <div className="space-y-1 lg:space-y-2">
                            {/* Location and Date on same line */}
                            <div className="flex items-center flex-wrap gap-2 md:gap-3 lg:gap-4 text-xs sm:text-sm lg:text-lg opacity-95">
                              {uiMemory.location?.primary && (
                                <div className="flex items-center gap-1 lg:gap-2">
                                  <MapPin className="w-3 h-3 sm:w-4 sm:h-4 lg:w-5 lg:h-5 flex-shrink-0" />
                                  <span
                                    className="truncate max-w-[200px] sm:max-w-[300px]"
                                    title={uiMemory.location.primary}
                                    style={{ cursor: uiMemory.location.primary.length > 40 ? 'help' : 'default' }}
                                  >
                                    {uiMemory.location.primary}
                                  </span>
                                </div>
                              )}
                              <div className="flex items-center gap-1 lg:gap-2">
                                <Calendar className="w-3 h-3 sm:w-4 sm:h-4 lg:w-5 lg:h-5" />
                                <span className="whitespace-nowrap text-xs sm:text-sm lg:text-base">{uiMemory.dateRange || `Created ${formatDate(uiMemory.createdDate)}`}</span>
                              </div>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>

                {/* Recent Activity - 1/3 width */}
                <div className="hidden lg:block flex-1 lg:flex-[1]">
                  <Card className="border-0 shadow-sm h-[28rem] flex flex-col">
                    <CardHeader className="pb-3 flex-shrink-0 border-b border-gray-100">
                      <CardTitle className="flex items-center gap-2 text-base">
                        <Clock className="w-4 h-4 text-[#6C60FF]" />
                        Recent Activity
                      </CardTitle>
                    </CardHeader>
                    <CardContent className="flex-1 pt-0 pb-0 overflow-hidden relative">
                      <div className="space-y-1 h-full overflow-y-auto pr-1 py-1 scrollbar-thin scrollbar-thumb-gray-300 scrollbar-track-transparent hover:scrollbar-thumb-gray-400">
                        {isLoadingActivity ? (
                          <div className="text-center py-8">
                            <div className="w-6 h-6 border-2 border-[#6C60FF] border-t-transparent rounded-full animate-spin mx-auto mb-2"></div>
                            <p className="text-xs text-gray-500">Loading activity...</p>
                          </div>
                        ) : apiActivity.length > 0 ? (
                          apiActivity.map((activity) => (
                            <div key={activity.id} className="flex items-center gap-2 p-2 rounded-lg hover:bg-gray-50 transition-colors">
                              <div className="w-1.5 h-1.5 bg-green-500 rounded-full flex-shrink-0"></div>
                              <Avatar className="h-5 w-5 flex-shrink-0">
                                <AvatarImage src={activity.user_avatar || activity.avatar || activity.user?.avatar} />
                                <AvatarFallback className="bg-gradient-to-br from-[#6C60FF] to-purple-600 text-white text-[10px]">
                                  {activity.user_name?.charAt(0)?.toUpperCase() || activity.user?.name?.charAt(0)?.toUpperCase() || '?'}
                                </AvatarFallback>
                              </Avatar>
                              <div className="flex-1 min-w-0">
                                <div className="flex items-center gap-1 text-xs">
                                  <span className="font-medium text-gray-900 truncate">{activity.user_name || 'Unknown User'}</span>
                                  <span className="text-gray-500 flex-shrink-0">{activity.description || 'performed an action'}</span>
                                </div>
                                <div className="flex items-center gap-2 text-[10px] text-gray-400">
                                  <span>{activity.time_ago || 'Recently'}</span>
                                  {(activity.created_at || activity.date || activity.timestamp) && (
                                    <span>• {new Date(activity.created_at || activity.date || activity.timestamp).toLocaleDateString('en-GB', { 
                                      day: '2-digit', 
                                      month: '2-digit', 
                                      year: '2-digit' 
                                    })}</span>
                                  )}
                                </div>
                              </div>
                            </div>
                          ))
                        ) : (
                          <div className="text-center py-8">
                            <Activity className="w-8 h-8 text-gray-300 mx-auto mb-2" />
                            <p className="text-xs text-gray-500 mb-1">No recent activity</p>
                            <p className="text-[10px] text-gray-400">Activity will appear here when users interact with this memory.</p>
                          </div>
                        )}
                      </div>
                    </CardContent>
                  </Card>
                </div>
              </div>

              {/* Media Section */}
              <div className="hidden md:block pb-0 md:pb-6 px-2 md:px-0">
                <Card className="border-0 shadow-sm">
                  <CardHeader className="pb-3 md:pb-4 px-3 md:px-6">
                    <div className="md:flex items-center justify-between">
                      <CardTitle className="flex items-center gap-2 text-base md:text-lg my-2">
                        <ImageIcon className="w-4 h-4 md:w-5 md:h-5 text-[#6C60FF]" />
                        <span className="text-sm md:text-base">Media ({filteredAndSortedMediaItems.length} photos)</span>
                      </CardTitle>
                      <div className="flex items-center gap-3">
                        {/* AI Memory Wizard Button - Hide for Suggested category */}
                        {!isSuggestedCategory && (
                          <Button
                            variant="outline"
                            size="sm"
                            disabled={aiProcessingData?.status === 'processing' && aiProcessingData?.memoryId !== memoryId}
                            onClick={() => {
                            // Check if another memory is being processed
                            if (aiProcessingData?.status === 'processing' && aiProcessingData?.memoryId !== memoryId) {
                              toast.info('Please wait for the current AI analysis to complete before starting a new one.');
                              return;
                            }

                            // Check if we have enough photos (minimum 3)
                            const photoCount = filteredAndSortedMediaItems.length;
                            if (photoCount < 3) {
                              const remaining = 3 - photoCount;
                              toast.error(`Please upload ${remaining} more photo${remaining > 1 ? 's' : ''} to use AI Memory Wizard (minimum 3 photos required)`);
                              return;
                            }

                            // Show results modal with static options - NO API calls yet
                            setIsAIResultsModalOpen(true);
                                  sidebarProgressStarted = true;
                                  // Show background processing toast when modal moves to sidebar
                                  toast.info('AI analysis is running in the background. You\'ll be notified when it\'s ready.', {
                                    duration: 5000
                                  });
                                }

                                // If more than 20 seconds and not yet moved to background (fallback)
                                if (elapsed > 20000 && !apiCompleted && !backgroundProcessingTriggered) {
                                  backgroundProcessingTriggered = true;
                                  // DON'T clear interval - keep it running for sidebar progress
                                  setIsAIWizardModalOpen(false);
                                }

                                setAiWizardProgress(prev => {
                                  let newProgress = prev;
                                  if (apiCompleted) {
                                    // API is done - jump to 100% immediately regardless of current progress
                                    clearInterval(progressInterval);
                                    newProgress = 100;
                                    console.log('✅ Progress complete! API is done, jumping to 100% from', prev);
                                  } else if (prev >= 95) {
                                    // Stop at 95% and wait for API
                                    newProgress = 95;
                                  } else if (prev >= 85) {
                                    // Very slow progress from 85-95%
                                    newProgress = prev + 0.1;
                                  } else if (prev >= 70) {
                                    // Slow progress from 70-85%
                                    newProgress = prev + 0.2;
                                  } else {
                                    // Normal progress 0-70% (0.25% every 500ms = 50% per 100 seconds)
                                    newProgress = prev + 0.25;
                                  }

                                  // Only update sidebar progress AFTER modal animation completes
                                  if (setAiProcessing && sidebarProgressStarted) {
                                    console.log('🔄 Updating sidebar progress:', Math.round(newProgress), 'Status: processing');
                                    // If progress is 100%, don't update here - let the API completion handler do it
                                    // This prevents setting status to 'processing' when it should be 'completed'
                                    if (newProgress < 100) {
                                      setAiProcessing({
                                        memoryId: memoryId,
                                        status: 'processing',
                                        startTime: startTime,
                                        progress: Math.round(newProgress)
                                      });
                                    }
                                  }

                                  return newProgress;
                                });
                              }, 500); // 500ms = 0.5 seconds delay between increments for smooth progress
                            };

                            startProgress();

                            try {
                              // Call the AI analysis API
                              const response = await dashboardAPI.analyzeUploadedPhotos(photoUrls);
                              console.log('🔍 AI Wizard API Full Response:', JSON.stringify(response, null, 2));
                              console.log('🔍 response.success:', response.success);
                              console.log('🔍 response.data:', response.data);
                              console.log('🔍 response.data type:', typeof response.data);
                              console.log('🔍 response.data keys:', response.data ? Object.keys(response.data) : 'null');

                              // Mark API as completed
                              apiCompleted = true;

                              if (response.success && response.data) {
                                // Check if data has nested structure (data.data)
                                let analysisData = response.data;

                                // If the API returns data wrapped in another 'data' object, unwrap it
                                if (response.data.data && response.data.data.summary) {
                                  analysisData = response.data.data;
                                  console.log('🔍 Using nested data.data structure');
                                }

                                console.log('🔍 Final Analysis Data:', JSON.stringify(analysisData, null, 2));
                                console.log('🔍 analysisData.summary:', analysisData.summary);
                                console.log('🔍 analysisData.clusters:', analysisData.clusters);
                                console.log('🔍 analysisData.clusters.faces:', analysisData.clusters?.faces ? `Array with ${analysisData.clusters.faces.length} items` : 'null');
                                console.log('🔍 analysisData.clusters.moments:', analysisData.clusters?.moments ? `Array with ${analysisData.clusters.moments.length} items` : 'null');
                                console.log('🔍 analysisData.clusters.objects:', analysisData.clusters?.objects ? `Array with ${analysisData.clusters.objects.length} items` : 'null');

                                if (analysisData.summary) {
                                  console.log('✅ Stored AI Analysis Data successfully');
                                  console.log('✅ Available keys:', Object.keys(analysisData));

                                  // Check if we moved to background processing
                                  if (backgroundProcessingTriggered) {
                                    // Update processing state with result
                                    console.log('🎉 Background processing completed! Setting status to completed');
                                    if (setAiProcessing) {
                                      setAiProcessing({
                                        memoryId: memoryId,
                                        status: 'completed',
                                        startTime: startTime,
                                        result: analysisData,
                                        progress: 100
                                      });
                                      console.log('✅ AI Processing state updated to completed with progress 100%');
                                    }
                                  } else {
                                    // Still in foreground, store data and show modal immediately
                                    setAiAnalysisData(analysisData);

                                    // Wait for progress to complete, then show results
                                    setTimeout(() => {
                                      setIsAIWizardModalOpen(false);
                                      setIsAIResultsModalOpen(true);
                                    }, 800);
                                  }
                                } else {
                                  clearInterval(progressInterval);
                                  setIsAIWizardModalOpen(false);
                                  if (backgroundProcessingTriggered && setAiProcessing) {
                                    setAiProcessing({
                                      memoryId: memoryId,
                                      status: 'failed',
                                      startTime: startTime
                                    });
                                  } else {
                                    toast.error("AI analysis response missing summary data");
                                  }
                                }
                              } else {
                                clearInterval(progressInterval);
                                setIsAIWizardModalOpen(false);
                                if (backgroundProcessingTriggered && setAiProcessing) {
                                  setAiProcessing({
                                    memoryId: memoryId,
                                    status: 'failed',
                                    startTime: startTime
                                  });
                                } else {
                                  toast.error(response.error || "AI analysis failed");
                                }
                              }
                            } catch (error) {
                              console.error('AI Wizard API error:', error);
                              clearInterval(progressInterval);
                              setIsAIWizardModalOpen(false);

                              if (backgroundProcessingTriggered && setAiProcessing) {
                                setAiProcessing({
                                  memoryId: memoryId,
                                  status: 'failed',
                                  startTime: startTime
                                });
                              } else {
                                toast.error("Failed to analyze photos. Please try again.");
                              }
                            }
                          }}
                          className="hidden lg:flex h-9 px-3 relative overflow-hidden items-center justify-center disabled:opacity-50 disabled:cursor-not-allowed"
                          style={
                            aiProcessingData?.status === 'processing' && aiProcessingData?.memoryId !== memoryId
                              ? {
                                  background: '#f3f4f6',
                                  border: '1px solid #e5e7eb'
                                }
                              : {
                                  background: 'linear-gradient(white, white) padding-box, linear-gradient(to right, #6C60FF, #EC4899) border-box',
                                  border: '1px solid transparent'
                                }
                          }
                        >
                          <Sparkles
                            className="w-4 h-4 mr-2 flex-shrink-0"
                            style={{
                              color: aiProcessingData?.status === 'processing' && aiProcessingData?.memoryId !== memoryId ? '#9ca3af' : '#6C60FF'
                            }}
                          />
                          <span style={
                            aiProcessingData?.status === 'processing' && aiProcessingData?.memoryId !== memoryId
                              ? {
                                  color: '#9ca3af',
                                  display: 'inline-block'
                                }
                              : {
                                  background: 'linear-gradient(to right, #6C60FF, #EC4899)',
                                  WebkitBackgroundClip: 'text',
                                  WebkitTextFillColor: 'transparent',
                                  backgroundClip: 'text',
                                  display: 'inline-block'
                                }
                          }>
                            AI Memory Wizard
                          </span>
                        </Button>
                        )}

                        {/* Simple Filter Bar */}
                        <div className="flex items-center gap-2">
                          <Select value={mediaSortBy} onValueChange={setMediaSortBy}>
                            <SelectTrigger className="w-24 h-9 bg-white border border-gray-200">
                              <SelectValue />
                            </SelectTrigger>
                            <SelectContent>
                              <SelectItem value="date">Date</SelectItem>
                              <SelectItem value="name">Name</SelectItem>
                              <SelectItem value="size">Size</SelectItem>
                            </SelectContent>
                          </Select>

                          <Button
                            variant="outline"
                            size="sm"
                            onClick={() => setMediaSortOrder(mediaSortOrder === 'asc' ? 'desc' : 'asc')}
                            className="h-9 w-9 p-0 border-gray-300"
                            title={`Sort ${mediaSortOrder === 'asc' ? 'ascending' : 'descending'}`}
                          >
                            {mediaSortOrder === 'asc' ?
                              <SortAsc className="w-4 h-4" /> :
                              <SortDesc className="w-4 h-4" />
                            }
                          </Button>

                          {!isSuggestedCategory && (
                            <Button
                              variant="outline"
                              size="sm"
                              onClick={() => setIsAddMomentModalOpen(true)}
                              className="hover:bg-gray-50 border-gray-300 disabled:opacity-50 disabled:cursor-not-allowed"
                              disabled={isAddMomentModalOpen}
                            >
                              <Upload className="w-4 h-4 mr-2" />
                              Upload Photos
                            </Button>
                          )}
                        </div>
                      </div>
                    </div>
                  </CardHeader>

                  {/* Bulk Actions - Only show when items are selected */}
                  {selectedItems.length > 0 && !isSuggestedCategory && (
                    <div className="mx-6 mb-4">
                      <BatchActions
                        selectedItems={selectedItems}
                        allItems={filteredAndSortedMediaItems}
                        onSelectionChange={setSelectedItems}
                        onDeleteItems={handleDeleteItems}
                        onMoveItems={handleMoveItems}
                        onAddToMemory={handleAddToMemory}
                        availableCategories={categories.map(cat => cat.name)}
                        memories={[
                          { id: 'mem_1', title: 'Cancun - Mexico', category: 'Personal' },
                          { id: 'mem_2', title: 'Friends are Forever', category: 'Shared with' },
                          { id: 'mem_3', title: 'Desert Sunset', category: 'Golf Trips' }
                        ]}
                      />
                    </div>
                  )}
                  <CardContent className="pt-0 px-3 md:px-6 hidden md:block">
                    {filteredAndSortedMediaItems.length > 0 ? (
                      <div className="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-2 sm:gap-3 md:gap-4">
                        {filteredAndSortedMediaItems.map((item) => {
                          const memoryOwnerId = apiMemoryData?.user_id?.toString()
                            || apiMemoryData?.user?.id?.toString()
                            || apiMemoryData?.owner_id?.toString()
                            || apiMemoryData?.created_by?.toString();

                          return (
                            <MemoryDetailsMediaItem
                              key={item.id}
                              item={item}
                              isSelected={selectedItems.includes(item.id)}
                              onToggleSelect={isSuggestedCategory ? undefined : () => handleMediaItemToggle(item.id)}
                              onView={() => handleMediaItemView(item)}
                              onViewImage={(src, alt, title, subtitle, imageId) => handleImageView(src, alt, title, subtitle, imageId)}
                              onUpdateItem={isSuggestedCategory ? undefined : handleUpdateItem}
                              onDeleteItem={isSuggestedCategory ? undefined : () => handleDeleteItem(item.id)}
                              memoryOwnerId={memoryOwnerId}
                              memoryTitle={apiMemoryData?.title}
                              memoryThumbnail={apiMemoryData?.last_update_img}
                              memoryCreatedDate={apiMemoryData?.created_at}
                              memoryImages={memoryImagesWithSubImages}
                            />
                          );
                        })}
                      </div>
                    ) : (
                      <div className="text-center py-12">
                        <ImageIcon className="w-12 h-12 text-gray-300 mx-auto mb-4" />
                        <h4 className="text-lg font-medium text-gray-900 mb-2">No photos yet</h4>
                        <p className="text-gray-600 mb-6">
                          Start capturing memories by adding your first photo to this memory.
                        </p>
                        <Button 
                          className="bg-[#6C60FF] hover:bg-[#5A52E6] text-white disabled:opacity-50 disabled:cursor-not-allowed"
                          onClick={() => setIsAddMomentModalOpen(true)}
                          disabled={isAddMomentModalOpen}
                        >
                          <ImageIcon className="w-4 h-4 mr-2" />
                          Add Photos
                        </Button>
                      </div>
                    )}
                  </CardContent>
                </Card>
              </div>
            </TabsContent>

            {/* Mobile Timeline Section - Only visible on mobile when Timeline tab is active */}
            <div className={`md:hidden ${activeTab === "overview" ? "block" : "hidden"}`}>
              <div className="border-t border-gray-200 bg-white">
                {/* Timeline Header */}
                <div className="p-4 border-b border-gray-100">
                  <div className="flex items-center justify-between">
                    <div>
                      <div className="flex items-center gap-2">
                        <h2 className="text-lg font-bold text-gray-900">Timeline</h2>
                        {currentUserRole === 'contributor' && (
                          <Badge className="bg-[#6C60FF] text-white text-xs px-2 py-0.5">
                            Contributor
                          </Badge>
                        )}
                        {currentUserRole === 'viewer' && (
                          <Badge className="bg-gray-500 text-white text-xs px-2 py-0.5">
                            Viewer
                          </Badge>
                        )}
                      </div>
                      <p className="text-sm text-gray-500">{sortedTimelinePosts.length} moments shared</p>
                    </div>

                    {/* Filter Dropdown */}
                    <Select value={timelineFilter} onValueChange={setTimelineFilter}>
                      <SelectTrigger className="w-32 h-9 text-xs bg-white border border-gray-200 hover:border-gray-300 focus:border-[#6C60FF] focus:ring-0 rounded-md">
                        <SelectValue />
                      </SelectTrigger>
                      <SelectContent className="bg-white border border-gray-200 shadow-xl rounded-lg">
                        <SelectItem value="latest" className="text-xs">Latest First</SelectItem>
                        <SelectItem value="oldest" className="text-xs">Oldest First</SelectItem>
                        <SelectItem value="most_comments" className="text-xs">Most Comments</SelectItem>
                        <SelectItem value="fewer_comments" className="text-xs">Fewer Comments</SelectItem>
                      </SelectContent>
                    </Select>
                  </div>
                </div>

                {/* Timeline Content */}
                <div className="p-4 space-y-4 bg-gray-50">
                  {isLoadingMemory ? (
                    <div className="text-center py-12">
                      <div className="w-6 h-6 border-2 border-[#6C60FF] border-t-transparent rounded-full animate-spin mx-auto mb-4"></div>
                      <p className="text-gray-500 text-sm">Loading timeline...</p>
                    </div>
                  ) : sortedTimelinePosts.length > 0 ? (
                    <>
                      {sortedTimelinePosts.map((post) => {
                        // Extract memory owner ID with multiple fallbacks
                        const memoryOwnerId = apiMemoryData?.user_id?.toString()
                          || apiMemoryData?.user?.id?.toString()
                          || apiMemoryData?.owner_id?.toString()
                          || apiMemoryData?.created_by?.toString();

                   // Calculate sub-image count for this post
                  const subImageCount = rawApiPosts?.filter((p: any) =>
                    p.parent_id?.toString() === post.id?.toString()
                  ).length || 0;

                  // Get sub-images array for this post, sorted so featured image appears first
                  const postSubImages = (rawApiPosts?.filter((p: any) =>
                    p.parent_id?.toString() === post.id?.toString()
                  ) || [])
                  .sort((a: any, b: any) => {
                    // Featured images come first
                    const aIsFeatured = a.is_featured === 1 || a.is_featured === true;
                    const bIsFeatured = b.is_featured === 1 || b.is_featured === true;
                    if (aIsFeatured && !bIsFeatured) return -1;
                    if (!aIsFeatured && bIsFeatured) return 1;
                    return 0; // Maintain original order for non-featured images
                  })
                  .map((p: any) => ({
                    id: p.id?.toString(),
                    src: p.image_link ? p.image_link.replace(/\\\//g, '/') : (p.image || p.image_url || ''),
                    alt: p.name || 'Sub-image',
                    name: p.name || '', // Keep name separate for comparison
                    title: p.title || '', // Only use actual title, don't fallback to name
                    description: p.description || '',
                    location: p.location || '',
                    dateTaken: p.capture_date || p.created_at || '',
                    is_featured: p.is_featured || 0
                  }));

                        return (
                          <PostCard
                            key={post.id}
                            post={post}
                            variant="card"
                            onContentUpdate={handlePostContentUpdate}
                            onImageClick={handleTimelineImageView}
                            memoryOwnerId={memoryOwnerId}
                            onPostDelete={handlePostDelete}
                            onUpdateItem={handleUpdateItem}
                            activeCollaborators={apiCollaborators.filter(c => c.status === 'active')}
                            subImageCount={subImageCount}
                            subImages={postSubImages}
                            memoryTitle={apiMemoryData?.title}
                            memoryThumbnail={apiMemoryData?.last_update_img}
                            memoryCreatedDate={apiMemoryData?.created_at}
                            memoryImages={memoryImagesWithSubImages}
                            memoryPublished={apiMemoryData?.published}
                            memoryId={memoryId}
                            onRefresh={async () => {
                          setApiMemoryData(null);
                          await fetchMemoryDetails(false);
                        }}
                          />
                        );
                      })}
                    </>
                  ) : (
                    <div className="text-center py-12">
                      <Activity className="w-12 h-12 text-gray-400 mx-auto mb-4" />
                      <h3 className="text-base font-medium text-gray-900 mb-2">No moments yet</h3>
                      <p className="text-sm text-gray-500 mb-4">
                        Start capturing memories by adding your first moment.
                      </p>
                      <Button
                        onClick={() => setIsAddMomentModalOpen(true)}
                        className="bg-[#6C60FF] hover:bg-[#5A52E6] text-white"
                        size="sm"
                      >
                        <ImageIcon className="w-4 h-4 mr-2" />
                        Add First Moment
                      </Button>
                    </div>
                  )}
                </div>
              </div>
            </div>

            {/* Moderation Tab Content - Only for Owner */}
            {isOwner && (
              <TabsContent value="moderation" className="m-0 p-6 relative" key={`moderation-${refreshTrigger}`}>
                {/* Loading Overlay */}
                {isRefreshingModeration && (
                  <div className="absolute inset-0 bg-white/80 backdrop-blur-sm z-50 flex items-center justify-center">
                    <div className="text-center">
                      <div className="w-8 h-8 border-2 border-[#6C60FF] border-t-transparent rounded-full animate-spin mx-auto mb-3"></div>
                      <p className="text-sm font-medium text-gray-700">Refreshing moderation data...</p>
                    </div>
                  </div>
                )}

                <div className="space-y-6">
                  {/* Header */}
                  <div>
                    <h2 className="text-2xl font-bold text-gray-900">Moment Moderation</h2>
                    <p className="text-gray-500 mt-1">Review and approve moments submitted by collaborators</p>
                  </div>

                  {/* Pending Posts List */}
                  {pendingPosts.length > 0 ? (
                    <div className="space-y-4">
                      {pendingPosts.map((post: any) => {
                        const postDate = post.created_at ? new Date(post.created_at) : new Date();
                        const formattedDate = postDate.toLocaleDateString('en-US', {
                          month: 'numeric',
                          day: 'numeric',
                          year: 'numeric'
                        });
                        const formattedTime = postDate.toLocaleTimeString('en-US', {
                          hour: 'numeric',
                          minute: '2-digit',
                          hour12: true
                        });

                        return (
                          <Card key={post.id} className="p-4 border border-gray-200">
                            <div className="flex gap-4">
                              {/* Thumbnail Image */}
                              <div className="flex-shrink-0">
                                <img
                                  src={post.image_link || 'https://via.placeholder.com/120x90'}
                                  alt="Moment"
                                  className="w-32 h-24 object-cover rounded-lg"
                                />
                              </div>

                              {/* Content */}
                              <div className="flex-1 space-y-2">
                                {/* User Info */}
                                <div className="flex items-center gap-2">
                                  <Avatar className="h-8 w-8">
                                    <AvatarImage src={post.user?.profile_image} />
                                    <AvatarFallback className="bg-indigo-100 text-indigo-600 text-xs">
                                      {post.user?.name?.charAt(0) || 'U'}
                                    </AvatarFallback>
                                  </Avatar>
                                  <div>
                                    <p className="text-sm font-medium text-gray-900">
                                      {post.user?.name || 'Unknown User'}
                                    </p>
                                    <p className="text-xs text-gray-500">
                                      {formattedDate}, {formattedTime}
                                    </p>
                                  </div>
                                </div>

                                {/* Parent Image Info - Show if this is a sub-image */}
                                {post.parent_id && (() => {
                                  // Find the parent post from rawApiPosts or sortedTimelinePosts
                                  const parentPost = rawApiPosts?.find((p: any) => p.id === post.parent_id) ||
                                                   sortedTimelinePosts.find((p: any) => p.id === post.parent_id);
                                  const parentImageName = parentPost?.name || parentPost?.title || parentPost?.description || 'Untitled Image';
                                  const memoryName = apiMemoryData?.title || uiMemory?.title || 'Memory';

                                  return (
                                    <span className="text-black font-medium" style={{ fontSize: '14px', fontWeight: 500 }}>
                                      {memoryName} / {parentImageName}
                                    </span>
                                  );
                                })()}

                                {/* Description */}
                                <p className="text-gray-700 text-sm">
                                  {post.description || 'No description provided.'}
                                </p>

                                {/* Location */}
                                {(post.location || post.city || post.country) && (
                                  <div className="flex items-center gap-1 text-xs text-gray-500">
                                    <MapPin className="w-3 h-3" />
                                    <span>
                                      {post.location || `${post.city || ''}${post.country ? ', ' + post.country : ''}`}
                                    </span>
                                  </div>
                                )}

                                {/* Action Buttons with Parent Selector */}
                                <div className="flex items-end gap-3 pt-2">
                                  {/* Parent Selector Dropdown - Only for sub-images */}
                                  {post.parent_id && (() => {
                                    // Get all parent images (posts without parent_id) from the memory
                                    // Explicitly check that parent_id is null/undefined/0/false (not just truthy)
                                    const allParentImages = (rawApiPosts || []).filter((p: any) =>
                                      (p.parent_id === null || p.parent_id === undefined || p.parent_id === 0 || p.parent_id === '' || p.parent_id === false) &&
                                      p.admin_approval === 1
                                    );

                                    // Sort by date (newest first)
                                    const sortedParents = allParentImages.sort((a: any, b: any) => {
                                      const dateA = new Date(a.created_at || a.capture_date || 0);
                                      const dateB = new Date(b.created_at || b.capture_date || 0);
                                      return dateB.getTime() - dateA.getTime();
                                    });

                                    const memoryName = apiMemoryData?.title || uiMemory?.title || 'Memory';

                                    // Find currently selected parent (or default to current parent)
                                    const currentSelectedParent = selectedParentIds[post.id] || post.parent_id?.toString();

                                    // Find in both parents and sub-images
                                    const allPosts = rawApiPosts || [];
                                    const selectedPost = allPosts.find((p: any) => p.id?.toString() === currentSelectedParent);

                                    // Get readable name
                                    const getDisplayName = (img: any, truncate = true) => {
                                      const name = img?.name || img?.title || `P${img?.id}`;
                                      return truncate && name.length > 20 ? name.substring(0, 20) + '...' : name;
                                    };

                                    // Format date like "Aug 2024"
                                    const formatMomentDate = (img: any) => {
                                      // Try multiple date fields in order of priority
                                      const dateStr = img?.capture_date || img?.date || img?.timestamp || img?.created_at;
                                      if (!dateStr) return '';

                                      const date = new Date(dateStr);
                                      if (isNaN(date.getTime())) return '';

                                      return date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
                                    };

                                    // Get memory date (latest post date)
                                    const memoryDate = sortedParents.length > 0 ? formatMomentDate(sortedParents[0]) : '';
                                    const totalMemoryCount = allPosts.filter((p: any) => p.admin_approval === 1).length;

                                    // Build list with parent images and their sub-images
                                    const treeItems: any[] = [];
                                    sortedParents.forEach((parent: any) => {
                                      // Find sub-images for this parent to get the count
                                      const subImages = allPosts.filter((p: any) =>
                                        p.parent_id?.toString() === parent.id?.toString() && p.admin_approval === 1
                                      );

                                      // Add parent with sub-image count
                                      treeItems.push({
                                        ...parent,
                                        isParent: true,
                                        subImageCount: subImages.length
                                      });

                                      // Add sub-images (will be shown but disabled)
                                      subImages.forEach((sub: any) => {
                                        treeItems.push({ ...sub, isParent: false, subImageCount: 0 });
                                      });
                                    });

                                    return (
                                      <div className="flex-1 max-w-xs">
                                        <Select
                                          value={currentSelectedParent}
                                          onValueChange={(value) => {
                                            setSelectedParentIds(prev => ({
                                              ...prev,
                                              [post.id]: value
                                            }));
                                          }}
                                        >
                                          <SelectTrigger className="w-full h-9 text-sm border-gray-300 focus:ring-0 focus:ring-offset-0 focus:border-gray-400">
                                            <SelectValue>
                                              <div className="flex items-center gap-2">
                                                {selectedPost?.image_link && (
                                                  <img
                                                    src={selectedPost.image_link}
                                                    alt=""
                                                    className="w-5 h-5 rounded object-cover"
                                                  />
                                                )}
                                                <span className="truncate">{getDisplayName(selectedPost)}</span>
                                              </div>
                                            </SelectValue>
                                          </SelectTrigger>
                                          <SelectContent className="max-h-[400px] max-w-[380px] bg-white border border-gray-200 shadow-lg rounded-lg overflow-hidden">
                                            {/* Memory Name Header - Format: "Memory Name · Count · Date" */}
                                            <div className="px-4 py-3 text-sm font-bold text-gray-900 bg-white border-b border-gray-100 sticky top-0 z-10">
                                              {memoryName} · {totalMemoryCount} · {memoryDate}
                                            </div>

                                            {/* Parent Images (selectable) and Sub-images (disabled) */}
                                            {treeItems.map((item: any) => {
                                              const displayName = getDisplayName(item, false);
                                              const dateStr = formatMomentDate(item);
                                              const isParent = item.isParent;
                                              const count = item.subImageCount || 0;

                                              return (
                                                <SelectItem
                                                  key={item.id}
                                                  value={item.id?.toString()}
                                                  disabled={!isParent}
                                                  className={`${!isParent ? 'opacity-50 cursor-not-allowed' : 'cursor-pointer hover:bg-gray-100 focus:bg-gray-100'} data-[state=checked]:bg-gray-100 border-none outline-none py-2 focus:ring-0`}
                                                >
                                                  <div className={`flex items-center gap-3 ${isParent ? 'pl-3' : 'pl-12'}`}>
                                                    {/* Thumbnail */}
                                                    <img
                                                      src={item.image_link || 'https://via.placeholder.com/40'}
                                                      alt={displayName}
                                                      className={`${isParent ? 'w-9 h-9' : 'w-8 h-8'} rounded object-cover flex-shrink-0`}
                                                      onError={(e) => {
                                                        e.currentTarget.src = 'https://via.placeholder.com/40';
                                                      }}
                                                    />

                                                    {/* Moment/Sub-image Info - Wrap text if too long */}
                                                    <div className="flex-1 min-w-0">
                                                      <div className={`${isParent ? 'font-semibold' : 'font-normal'} text-gray-900 text-sm break-words`}>
                                                        {displayName} · {count} · {dateStr}
                                                      </div>
                                                    </div>
                                                  </div>
                                                </SelectItem>
                                              );
                                            })}
                                          </SelectContent>
                                        </Select>
                                      </div>
                                    );
                                  })()}
                                  <Button
                                    onClick={() => handleApprovePost(post.id)}
                                    className="bg-indigo-500 hover:bg-indigo-600 text-white px-6"
                                    size="sm"
                                  >
                                    <CheckCircle className="w-4 h-4 mr-1" />
                                    Approve
                                  </Button>
                                  <Button
                                    onClick={() => handleDenyPost(post.id)}
                                    variant="outline"
                                    className="border-gray-300 text-gray-700 hover:bg-gray-50 px-6"
                                    size="sm"
                                  >
                                    <X className="w-4 h-4 mr-1" />
                                    Deny
                                  </Button>
                                </div>
                              </div>
                            </div>
                          </Card>
                        );
                      })}
                    </div>
                  ) : (
                    <div className="text-center py-12 bg-gray-50 rounded-lg">
                      <Shield className="w-12 h-12 text-gray-400 mx-auto mb-4" />
                      <h3 className="text-lg font-medium text-gray-900 mb-2">
                        No Pending Moments
                      </h3>
                      <p className="text-gray-500">
                        All moments from collaborators have been reviewed.
                      </p>
                    </div>
                  )}
                </div>
              </TabsContent>
            )}

            <TabsContent value="analytics" className="m-0 p-6">
              <div className="space-y-8">
                {/* Analytics Content */}
                <div className="flex items-center justify-between">
                  <div>
                    <h2 className="text-2xl font-bold text-gray-900">Memory Analytics</h2>
                    <p className="text-sm text-gray-500 mt-1">Performance insights for "{uiMemory.title}"</p>
                  </div>
                </div>
              </div>
            </TabsContent>

            <TabsContent value="collaborators" className="m-0 p-0">
              <div className="p-4">
                <div className="space-y-6">
                  {/* Header with Add Collaborator Button */}
                  <div className="md:flex items-center justify-between">
                    <div>
                      <div className="flex items-center gap-2">
                        <h3 className="text-2xl font-bold text-gray-900">Collaborators</h3>
                        
                      </div>
                      <p className="text-sm text-gray-600 mt-1">
                        Manage who can access and contribute to this memory
                      </p>
                    </div>
                    {/* Always show buttons in header - Hide for Suggested category */}
                    {!isLoadingCollaborators && !isSuggestedCategory && (
                      <div className="flex items-center gap-2 pt-2 md:pt-0">
                        <Button
                          size="sm"
                          variant="outline"
                          className="border-[#6C60FF] text-[#6C60FF] hover:bg-[#6C60FF] hover:text-white"
                          onClick={() => setIsGenerateQROpen(true)}
                        >
                          <QrCode className="w-4 h-4 mr-2" />
                          Generate QR
                        </Button>
                        <Button
                          size="sm"
                          className="bg-[#6C60FF] hover:bg-[#5A52E6] text-white"
                          onClick={() => setIsAddCollaboratorOpen(true)}
                        >
                          <Users className="w-4 h-4 mr-2" />
                          Add Collaborator
                        </Button>
                      </div>
                    )}
                  </div>

                  {/* Collaborators List */}
                  <div className="space-y-4">
                    {isLoadingCollaborators ? (
                      <div className="text-center py-12">
                        <div className="w-8 h-8 border-2 border-[#6C60FF] border-t-transparent rounded-full animate-spin mx-auto mb-4"></div>
                        <h4 className="text-lg font-medium text-gray-900 mb-2">Loading collaborators...</h4>
                        <p className="text-gray-600">Fetching collaborator data from server.</p>
                      </div>
                    ) : collaborators.length === 0 ? (
                      <div className="text-center py-12">
                        <Users className="w-12 h-12 text-gray-400 mx-auto mb-4" />
                        <h4 className="text-lg font-medium text-gray-900 mb-2">No collaborators yet</h4>
                        <p className="text-gray-500">
                          Start collaborating by inviting people to contribute to this memory.
                        </p>
                      </div>
                    ) : (
                      <div className="space-y-3">
                        {collaborators.map((collaborator) => (
                          <div
                            key={collaborator.id}
                            className="flex sm:flex-row sm:items-center justify-between px-1 py-3 md:p-3 sm:p-4 bg-gray-50 rounded-lg border border-gray-200 hover:border-gray-300 transition-colors gap-2"
                          >
                            <div className="flex items-center gap-2">
                              <Avatar className="w-10 h-10">
                                {collaborator.isNonUser ? (
                                  <>
                                    {/* For non-user collaborators, show initials from email */}
                                    <AvatarFallback className="bg-gradient-to-br from-[#6C60FF] to-purple-600 text-white font-medium">
                                      {collaborator.initials || generateInitialsFromEmail(collaborator.email)}
                                    </AvatarFallback>
                                  </>
                                ) : (
                                  <>
                                    {/* For normal collaborators, show profile image if available, otherwise show name initials */}
                                    {collaborator.avatar ? (
                                      <AvatarImage src={collaborator.avatar} alt={collaborator.name} />
                                    ) : null}
                                    <AvatarFallback 
                                      className={`text-white font-medium ${
                                        collaborator.profileColor 
                                          ? '' 
                                          : 'bg-gradient-to-br from-[#6C60FF] to-purple-600'
                                      }`}
                                      style={
                                        collaborator.profileColor 
                                          ? { backgroundColor: formatProfileColor(collaborator.profileColor) }
                                          : undefined
                                      }
                                    >
                                      {generateInitialsFromName(collaborator.name)}
                                    </AvatarFallback>
                                  </>
                                )}
                              </Avatar>
                              <div className="flex-1 min-w-0">
                                <div className="flex items-center gap-2 flex-wrap">
                                  <p className="font-medium text-gray-900 truncate">{collaborator.name}</p>
                                  <Badge className={`${getStatusColor(collaborator.status)} border text-xs px-2 py-0.5 shrink-0`}>
                                    {collaborator.status === 'active' ? 'Active' :
                                     collaborator.status === 'pending' ? 'Pending' :
                                     collaborator.status === 'invited' ? 'Invited' :
                                     collaborator.status}
                                  </Badge>
                                </div>
                                <p className="text-sm text-gray-600 truncate">
                                  {collaborator.email || collaborator.phone_number || 'No contact info'}
                                </p>
                                <p className="text-xs text-gray-500">
                                  Added {new Date(collaborator.addedDate).toLocaleDateString()}
                                </p>
                              </div>
                            </div>

                            {/* Action Buttons Container */}
                            <div className="flex items-center gap-2">
                              {/* Desktop View - Show all buttons */}
                              <div className="hidden md:flex items-center gap-2">
                              {/* Role Selector - Show as plain text for Suggested category */}
                              {isSuggestedCategory ? (
                                <div className={`flex items-center gap-1 px-2 py-1 rounded text-xs font-medium ${getRoleColor(collaborator.role)}`}>
                                  {getRoleIcon(collaborator.role)}
                                  <span className="capitalize">{collaborator.role}</span>
                                </div>
                              ) : (
                                <Select
                                  value={collaborator.role}
                                  onValueChange={(value: 'view' | 'edit' | 'admin') =>
                                    handleRoleChange(collaborator.id, value)
                                  }
                                >
                                <SelectTrigger 
                                  className="w-auto min-w-[80px] border-0 outline-none focus:outline-none focus-visible:outline-none ring-0 focus:ring-0 focus-visible:ring-0"
                                  style={{
                                    backgroundColor: 'transparent !important',
                                    outline: 'none !important',
                                    border: 'none !important'
                                  }}
                                  onFocus={(e) => {
                                    e.target.style.setProperty('outline', 'none', 'important');
                                    e.target.style.setProperty('box-shadow', 'none', 'important');
                                    e.target.style.setProperty('border', 'none', 'important');
                                  }}
                                  onBlur={(e) => {
                                    e.target.style.setProperty('outline', 'none', 'important');
                                    e.target.style.setProperty('box-shadow', 'none', 'important');
                                    e.target.style.setProperty('border', 'none', 'important');
                                  }}
                                >
                                  <div className={`flex items-center gap-1 px-2 py-1 rounded text-xs font-medium ${getRoleColor(collaborator.role)}`}>
                                    {getRoleIcon(collaborator.role)}
                                    <span className="capitalize">{collaborator.role}</span>
                                  </div>
                                </SelectTrigger>
                                <SelectContent 
                                  className="bg-white border border-gray-200 shadow-lg outline-none focus:outline-none focus-visible:outline-none [&_*[data-highlighted]]:!bg-gray-100 [&_*[data-state=checked]]:!bg-gray-100 [&_*]:!text-gray-900"
                                  style={{
                                    backgroundColor: 'white !important',
                                    color: '#374151 !important',
                                    outline: 'none !important'
                                  }}
                                >
                                  <SelectItem
                                    value="view"
                                    className="cursor-pointer outline-none focus:outline-none focus-visible:outline-none"
                                    style={{
                                      backgroundColor: 'white !important',
                                      color: '#374151 !important',
                                      outline: 'none !important'
                                    }}
                                    onMouseEnter={(e) => {
                                      (e.target as HTMLElement).style.setProperty('background-color', '#f3f4f6', 'important');
                                      (e.target as HTMLElement).style.setProperty('color', '#374151', 'important');
                                      (e.target as HTMLElement).style.setProperty('outline', 'none', 'important');
                                    }}
                                    onMouseLeave={(e) => {
                                      (e.target as HTMLElement).style.setProperty('background-color', 'white', 'important');
                                      (e.target as HTMLElement).style.setProperty('color', '#374151', 'important');
                                      (e.target as HTMLElement).style.setProperty('outline', 'none', 'important');
                                    }}
                                    onFocus={(e) => {
                                      (e.target as HTMLElement).style.setProperty('background-color', '#f3f4f6', 'important');
                                      (e.target as HTMLElement).style.setProperty('color', '#374151', 'important');
                                      (e.target as HTMLElement).style.setProperty('outline', 'none', 'important');
                                    }}
                                    onBlur={(e) => {
                                      e.target.style.setProperty('background-color', 'white', 'important');
                                      e.target.style.setProperty('color', '#374151', 'important');
                                      e.target.style.setProperty('outline', 'none', 'important');
                                    }}
                                  >
                                    <div className="flex items-center gap-2">
                                      <Eye className="w-3 h-3" />
                                      <span>Viewer</span>
                                    </div>
                                  </SelectItem>
                                  <SelectItem
                                    value="edit"
                                    className="cursor-pointer outline-none focus:outline-none focus-visible:outline-none"
                                    style={{
                                      backgroundColor: 'white !important',
                                      color: '#374151 !important',
                                      outline: 'none !important'
                                    }}
                                    onMouseEnter={(e) => {
                                      (e.target as HTMLElement).style.setProperty('background-color', '#f3f4f6', 'important');
                                      (e.target as HTMLElement).style.setProperty('color', '#374151', 'important');
                                      (e.target as HTMLElement).style.setProperty('outline', 'none', 'important');
                                    }}
                                    onMouseLeave={(e) => {
                                      (e.target as HTMLElement).style.setProperty('background-color', 'white', 'important');
                                      (e.target as HTMLElement).style.setProperty('color', '#374151', 'important');
                                      (e.target as HTMLElement).style.setProperty('outline', 'none', 'important');
                                    }}
                                    onFocus={(e) => {
                                      (e.target as HTMLElement).style.setProperty('background-color', '#f3f4f6', 'important');
                                      (e.target as HTMLElement).style.setProperty('color', '#374151', 'important');
                                      (e.target as HTMLElement).style.setProperty('outline', 'none', 'important');
                                    }}
                                    onBlur={(e) => {
                                      e.target.style.setProperty('background-color', 'white', 'important');
                                      e.target.style.setProperty('color', '#374151', 'important');
                                      e.target.style.setProperty('outline', 'none', 'important');
                                    }}
                                  >
                                    <div className="flex items-center gap-2">
                                      <Edit className="w-3 h-3" />
                                      <span>Contributor</span>
                                    </div>
                                  </SelectItem>
                                  <SelectItem 
                                    value="admin"
                                    className="cursor-pointer outline-none focus:outline-none focus-visible:outline-none"
                                    style={{
                                      backgroundColor: 'white !important',
                                      color: '#374151 !important',
                                      outline: 'none !important'
                                    }}
                                    onMouseEnter={(e) => {
                                      (e.target as HTMLElement).style.setProperty('background-color', '#f3f4f6', 'important');
                                      (e.target as HTMLElement).style.setProperty('color', '#374151', 'important');
                                      (e.target as HTMLElement).style.setProperty('outline', 'none', 'important');
                                    }}
                                    onMouseLeave={(e) => {
                                      (e.target as HTMLElement).style.setProperty('background-color', 'white', 'important');
                                      (e.target as HTMLElement).style.setProperty('color', '#374151', 'important');
                                      (e.target as HTMLElement).style.setProperty('outline', 'none', 'important');
                                    }}
                                    onFocus={(e) => {
                                      (e.target as HTMLElement).style.setProperty('background-color', '#f3f4f6', 'important');
                                      (e.target as HTMLElement).style.setProperty('color', '#374151', 'important');
                                      (e.target as HTMLElement).style.setProperty('outline', 'none', 'important');
                                    }}
                                    onBlur={(e) => {
                                      e.target.style.setProperty('background-color', 'white', 'important');
                                      e.target.style.setProperty('color', '#374151', 'important');
                                      e.target.style.setProperty('outline', 'none', 'important');
                                    }}
                                  >
                                    <div className="flex items-center gap-2">
                                      <Shield className="w-3 h-3" />
                                      <span>Admin</span>
                                    </div>
                                  </SelectItem>
                                </SelectContent>
                              </Select>
                              )}

                              {/* Resend Invite Button - Show for ALL pending/invited collaborators */}
                              {(() => {
                                // Show button for ALL pending/invited collaborators
                                // We can resend via: inviteId API, or re-invite by email/phone
                                const shouldShow = !isSuggestedCategory &&
                                  (collaborator.status === 'pending' || collaborator.status === 'invited');
                                console.log('🔘 Resend button check for', collaborator.name, {
                                  isSuggestedCategory,
                                  status: collaborator.status,
                                  inviteId: collaborator.inviteId,
                                  isNonUser: collaborator.isNonUser,
                                  email: collaborator.email,
                                  phone: collaborator.phone_number,
                                  shouldShow,
                                  fullCollaborator: collaborator
                                });
                                return shouldShow;
                              })() && (
                                <Button
                                  variant="ghost"
                                  size="sm"
                                  className="text-blue-600 hover:text-blue-700 hover:bg-blue-50 flex items-center justify-center"
                                  onClick={async (e) => {
                                    e.preventDefault();
                                    e.stopPropagation();

                                    console.log('🔄🔄🔄 RESEND BUTTON CLICKED 🔄🔄🔄');
                                    console.log('🔄 Resend button clicked for collaborator:', collaborator.name);
                                    console.log('Collaborator details:', {
                                      id: collaborator.id,
                                      inviteId: collaborator.inviteId,
                                      email: collaborator.email,
                                      phone: collaborator.phone_number,
                                      status: collaborator.status
                                    });

                                    if (collaborator.inviteId) {
                                      // Has inviteId - use the standard resend API
                                      console.log('✅ Using handleResendInvite with inviteId:', collaborator.inviteId);
                                      await handleResendInvite(collaborator.inviteId);
                                    } else {
                                      console.log('⚠️ No inviteId found, using fallback method');
                                      // No inviteId - resend by re-inviting via email or phone
                                      try {
                                        setResendingInviteId(-1); // Use -1 as a temporary ID for loading state

                                        let response;
                                        if (collaborator.email && collaborator.email.trim()) {
                                          // Resend via email (works for both users and non-users)
                                          console.log('📧 Resending invitation via email:', collaborator.email);
                                          response = await dashboardAPI.addMemoryCollaborator(memoryId, {
                                            emails: [collaborator.email],
                                            role: collaborator.role
                                          });
                                        } else if (collaborator.phone_number && collaborator.phone_number.trim()) {
                                          // Resend via phone (works for both users and non-users)
                                          console.log('📱 Resending invitation via phone:', collaborator.phone_number);
                                          response = await dashboardAPI.addMemoryCollaboratorByPhone(memoryId, {
                                            phones: [collaborator.phone_number],
                                            role: collaborator.role
                                          });
                                        } else {
                                          console.error('❌ No contact method available');
                                          toast.error("No email or phone number available for this collaborator");
                                          setResendingInviteId(null);
                                          return;
                                        }

                                        console.log('API Response:', response);
                                        if (response && response.success) {
                                          toast.success("Invitation resent successfully!");
                                          // Refresh to get updated invite data
                                          await fetchMemoryDetails();
                                        } else {
                                          toast.error(response?.error || "Failed to resend invitation");
                                        }
                                      } catch (error) {
                                        console.error('🔥 Error resending invitation:', error);
                                        toast.error("Failed to resend invitation");
                                      } finally {
                                        setResendingInviteId(null);
                                      }
                                    }
                                  }}
                                  disabled={resendingInviteId === collaborator.inviteId || resendingInviteId === -1}
                                  title="Resend invitation"
                                >
                                  {(resendingInviteId === collaborator.inviteId || resendingInviteId === -1) ? (
                                    <div className="w-4 h-4 border-2 border-blue-600 border-t-transparent rounded-full animate-spin" />
                                  ) : (
                                    <Send className="w-4 h-4" />
                                  )}
                                </Button>
                              )}

                              {/* Remove Button - Hide for Suggested category */}
                              {!isSuggestedCategory && (
                                <Button
                                  variant="ghost"
                                  size="sm"
                                  className="text-red-600 hover:text-red-700 hover:bg-red-50"
                                  onClick={() => handleRemoveCollaborator(collaborator.id)}
                                  disabled={removingCollaboratorId === collaborator.id}
                                >
                                  {removingCollaboratorId === collaborator.id ? (
                                    <div className="w-4 h-4 border-2 border-red-600 border-t-transparent rounded-full animate-spin" />
                                  ) : (
                                    <UserX className="w-4 h-4" />
                                  )}
                                </Button>
                              )}
                              </div>

                              {/* Mobile View - 3 Dot Menu */}
                              <div className="flex md:hidden items-center">
                              <DropdownMenu>
                                <DropdownMenuTrigger asChild>
                                  <Button variant="ghost" size="sm" className="h-8 w-8 p-0">
                                    <MoreVertical className="w-4 h-4" />
                                  </Button>
                                </DropdownMenuTrigger>
                                <DropdownMenuContent align="end" className="w-48 bg-white">
                                  {/* Role Options - Show only if not Suggested category */}
                                  {!isSuggestedCategory && (
                                    <>
                                      <DropdownMenuItem
                                        onClick={() => handleRoleChange(collaborator.id, 'view')}
                                        className={`flex items-center justify-between gap-2 ${(collaborator.role === 'view' || (collaborator.role as any) === 'viewer') ? 'bg-[#3B82F6] text-white hover:bg-[#3B82F6] hover:text-white' : ''}`}
                                      >
                                        <div className="flex items-center gap-2">
                                          <Eye className="w-4 h-4" />
                                          <span>Viewer</span>
                                        </div>
                                        {(collaborator.role === 'view' || (collaborator.role as any) === 'viewer') && <CheckCircle className="w-4 h-4" />}
                                      </DropdownMenuItem>
                                      <DropdownMenuItem
                                        onClick={() => handleRoleChange(collaborator.id, 'edit')}
                                        className={`flex items-center justify-between gap-2 ${(collaborator.role === 'edit' || (collaborator.role as any) === 'contributor') ? 'bg-[#3B82F6] text-white hover:bg-[#3B82F6] hover:text-white' : ''}`}
                                      >
                                        <div className="flex items-center gap-2">
                                          <Edit className="w-4 h-4" />
                                          <span>Contributor</span>
                                        </div>
                                        {(collaborator.role === 'edit' || (collaborator.role as any) === 'contributor') && <CheckCircle className="w-4 h-4" />}
                                      </DropdownMenuItem>
                                      <DropdownMenuItem
                                        onClick={() => handleRoleChange(collaborator.id, 'admin')}
                                        className={`flex items-center justify-between gap-2 ${collaborator.role === 'admin' ? 'bg-[#3B82F6] text-white hover:bg-[#3B82F6] hover:text-white' : ''}`}
                                      >
                                        <div className="flex items-center gap-2">
                                          <Shield className="w-4 h-4" />
                                          <span>Admin</span>
                                        </div>
                                        {collaborator.role === 'admin' && <CheckCircle className="w-4 h-4" />}
                                      </DropdownMenuItem>
                                    </>
                                  )}

                                  {/* Resend Invite - Show for pending/invited */}
                                  {!isSuggestedCategory && (collaborator.status === 'pending' || collaborator.status === 'invited') && (
                                    <DropdownMenuItem
                                      onClick={async (e) => {
                                        e.preventDefault();
                                        e.stopPropagation();

                                        if (collaborator.inviteId) {
                                          await handleResendInvite(collaborator.inviteId);
                                        } else {
                                          try {
                                            setResendingInviteId(-1);
                                            let response;
                                            if (collaborator.email && collaborator.email.trim()) {
                                              response = await dashboardAPI.addMemoryCollaborator(memoryId, {
                                                emails: [collaborator.email],
                                                role: collaborator.role
                                              });
                                            } else if (collaborator.phone_number && collaborator.phone_number.trim()) {
                                              response = await dashboardAPI.addMemoryCollaboratorByPhone(memoryId, {
                                                phones: [collaborator.phone_number],
                                                role: collaborator.role
                                              });
                                            } else {
                                              toast.error("No email or phone number available for this collaborator");
                                              setResendingInviteId(null);
                                              return;
                                            }
                                            if (response && response.success) {
                                              toast.success("Invitation resent successfully!");
                                              await fetchMemoryDetails();
                                            } else {
                                              toast.error(response?.error || "Failed to resend invitation");
                                            }
                                          } catch (error) {
                                            console.error('Error resending invitation:', error);
                                            toast.error("Failed to resend invitation");
                                          } finally {
                                            setResendingInviteId(null);
                                          }
                                        }
                                      }}
                                      disabled={resendingInviteId === collaborator.inviteId || resendingInviteId === -1}
                                      className="flex items-center gap-2 text-blue-600"
                                    >
                                      <Send className="w-4 h-4" />
                                      <span>Resend Invite</span>
                                    </DropdownMenuItem>
                                  )}

                                  {/* Remove Button - Hide for Suggested category */}
                                  {!isSuggestedCategory && (
                                    <DropdownMenuItem
                                      onClick={() => handleRemoveCollaborator(collaborator.id)}
                                      disabled={removingCollaboratorId === collaborator.id}
                                      className="flex items-center gap-2 text-red-600"
                                    >
                                      <UserX className="w-4 h-4" />
                                      <span>Remove</span>
                                    </DropdownMenuItem>
                                  )}
                                </DropdownMenuContent>
                              </DropdownMenu>
                              </div>
                            </div>
                          </div>
                        ))}
                      </div>
                    )}
                  </div>

                  {/* Collaborator Stats */}
                  {collaborators.length > 0 && (
                    <div className="pt-6 border-t border-gray-200">
                      <div className="grid grid-cols-4 gap-2 md:gap-6">
                        <div className="text-center">
                          <p className="text-2xl font-semibold text-gray-900">{collaborators.length}</p>
                          <p className="text-sm text-gray-600">Total Collaborators</p>
                        </div>
                        <div className="text-center">
                          <p className="text-2xl font-semibold text-gray-900">
                            {collaborators.filter(c => c.status === 'active').length}
                          </p>
                          <p className="text-sm text-gray-600">Active</p>
                        </div>
                        <div className="text-center">
                          <p className="text-2xl font-semibold text-gray-900">
                            {collaborators.filter(c => c.status === 'pending').length}
                          </p>
                          <p className="text-sm text-gray-600">Pending</p>
                        </div>
                        <div className="text-center">
                          <p className="text-2xl font-semibold text-gray-900">
                            {collaborators.filter(c => c.role === 'admin').length}
                          </p>
                          <p className="text-sm text-gray-600">Admins</p>
                        </div>
                      </div>
                    </div>
                  )}
                </div>
              </div>
            </TabsContent>
          </Tabs>
        </div>
      </div>

      {/* Timeline View Sidebar - Fixed Right Position */}
      <aside className="hidden lg:block fixed right-0 top-20 bottom-0 w-[28rem] bg-white border-l border-gray-200 shadow-lg z-10 overflow-y-auto">
        <div className="flex flex-col">
          {/* Timeline Header */}
          <div className="flex-shrink-0 p-6 border-b border-gray-100">
            <div className="flex items-center justify-between">
              <div className="flex items-center gap-3">
                <div className="w-10 h-10 bg-[#6C60FF]/10 rounded-lg flex items-center justify-center">
                  <Clock className="w-5 h-5 text-[#6C60FF]" />
                </div>
                <div>
                  <div className="flex items-center gap-2">
                    <h2 className="text-lg font-semibold text-gray-900">Timeline View</h2>
                    {currentUserRole === 'contributor' && (
                      <Badge className="bg-[#6C60FF] text-white text-xs px-2 py-0.5">
                        Contributor
                      </Badge>
                    )}
                    {currentUserRole === 'viewer' && (
                      <Badge className="bg-gray-500 text-white text-xs px-2 py-0.5">
                        Viewer
                      </Badge>
                    )}
                  </div>
                  <p className="text-sm text-gray-500">Captured moments</p>
                </div>
              </div>
              
              {/* Filter Dropdown */}
              <div className="flex items-center gap-2">
                <span className="text-xs text-gray-500">Sort by:</span>
                <Select value={timelineFilter} onValueChange={setTimelineFilter}>
                  <SelectTrigger className="w-28 h-8 text-xs bg-white border border-gray-200 hover:border-gray-300 focus:border-[#6C60FF] focus:ring-0 rounded-md transition-all duration-200">
                    <SelectValue />
                  </SelectTrigger>
                  <SelectContent className="bg-white border border-gray-200 shadow-xl rounded-lg p-0 min-w-[140px] animate-in slide-in-from-top-2 duration-200">
                    <SelectItem value="latest" className="text-xs py-2 px-3 rounded-none hover:bg-gray-50 focus:bg-[#6C60FF]/10 focus:text-[#6C60FF] cursor-pointer border-b border-gray-100">Latest</SelectItem>
                    <SelectItem value="oldest" className="text-xs py-2 px-3 rounded-none hover:bg-gray-50 focus:bg-[#6C60FF]/10 focus:text-[#6C60FF] cursor-pointer border-b border-gray-100">Oldest</SelectItem>
                    <SelectItem value="most_comments" className="text-xs py-2 px-3 rounded-none hover:bg-gray-50 focus:bg-[#6C60FF]/10 focus:text-[#6C60FF] cursor-pointer border-b border-gray-100">Most Comments</SelectItem>
                    <SelectItem value="fewer_comments" className="text-xs py-2 px-3 rounded-none hover:bg-gray-50 focus:bg-[#6C60FF]/10 focus:text-[#6C60FF] cursor-pointer">Fewer Comments</SelectItem>
                  </SelectContent>
                </Select>
              </div>
            </div>
          </div>

          {/* Timeline Content */}
          <div className="flex-1 p-6 space-y-4">
            {isLoadingMemory ? (
              <div className="text-center py-12">
                <div className="w-6 h-6 border-2 border-[#6C60FF] border-t-transparent rounded-full animate-spin mx-auto mb-4"></div>
                <p className="text-gray-500">Loading timeline...</p>
              </div>
            ) : sortedTimelinePosts.length > 0 ? (
              <>
                {sortedTimelinePosts.map((post) => {
                  // Extract memory owner ID with multiple fallbacks
                  const memoryOwnerId = apiMemoryData?.user_id?.toString()
                    || apiMemoryData?.user?.id?.toString()
                    || apiMemoryData?.owner_id?.toString()
                    || apiMemoryData?.created_by?.toString();

                  // Calculate sub-image count for this post
                  const subImageCount = rawApiPosts?.filter((p: any) =>
                    p.parent_id?.toString() === post.id?.toString()
                  ).length || 0;

                  // Get sub-images array for this post, sorted so featured image appears first
                  const postSubImages = (rawApiPosts?.filter((p: any) =>
                    p.parent_id?.toString() === post.id?.toString()
                  ) || [])
                  .sort((a: any, b: any) => {
                    // Featured images come first
                    const aIsFeatured = a.is_featured === 1 || a.is_featured === true;
                    const bIsFeatured = b.is_featured === 1 || b.is_featured === true;
                    if (aIsFeatured && !bIsFeatured) return -1;
                    if (!aIsFeatured && bIsFeatured) return 1;
                    return 0; // Maintain original order for non-featured images
                  })
                  .map((p: any) => ({
                    id: p.id?.toString(),
                    src: p.image_link ? p.image_link.replace(/\\\//g, '/') : (p.image || p.image_url || ''),
                    alt: p.name || 'Sub-image',
                    name: p.name || '', // Keep name separate for comparison
                    title: p.title || '', // Only use actual title, don't fallback to name
                    description: p.description || '',
                    location: p.location || '',
                    dateTaken: p.capture_date || p.created_at || '',
                    is_featured: p.is_featured || 0
                  }));

                  return (
                    <PostCard
                      key={post.id}
                      post={post}
                      variant="card"
                      onContentUpdate={handlePostContentUpdate}
                      onImageClick={handleTimelineImageView}
                      memoryOwnerId={memoryOwnerId}
                      onPostDelete={handlePostDelete}
                      onUpdateItem={handleUpdateItem}
                      activeCollaborators={apiCollaborators.filter(c => c.status === 'active')}
                      subImageCount={subImageCount}
                      subImages={postSubImages}
                      memoryTitle={apiMemoryData?.title}
                      memoryThumbnail={apiMemoryData?.last_update_img}
                      memoryCreatedDate={apiMemoryData?.created_at}
                      memoryImages={memoryImagesWithSubImages}
                      memoryPublished={apiMemoryData?.published}
                      memoryId={memoryId}
                      onRefresh={async () => {
                        setApiMemoryData(null);
                        await fetchMemoryDetails(false);
                      }}
                    />
                  );
                })}
              </>
            ) : (
              <div className="text-center py-12">
                <Activity className="w-12 h-12 text-gray-400 mx-auto mb-4" />
                <h3 className="text-lg font-medium text-gray-900 mb-2">
                  {apiMemoryData ? 'No posts in this memory' : 'No moments yet'}
                </h3>
                <p className="text-gray-500 mb-4">
                  {apiMemoryData 
                    ? 'This memory doesn\'t have any posts or timeline entries yet.' 
                    : 'Start capturing memories by adding your first moment.'
                  }
                </p>
                <Button 
                  onClick={() => setIsAddMomentModalOpen(true)}
                  className="bg-[#6C60FF] hover:bg-[#5A52E6] text-white disabled:opacity-50 disabled:cursor-not-allowed"
                  disabled={isAddMomentModalOpen}
                >
                  <ImageIcon className="w-4 h-4 mr-2" />
                  Add First Moment
                </Button>
              </div>
            )}
          </div>
        </div>
      </aside>

      {/* Add Moment Modal */}
      <AddMomentModal
        isOpen={isAddMomentModalOpen}
        onClose={() => {
          setIsAddMomentModalOpen(false);
          setSelectedMediaLibraryImagesForMoment([]);
          setParentImageIdForSubImage(undefined); // Clear parent image ID
          setCapturedFiles(null); // Clear captured files
          // Refresh page data when modal closes
          fetchMemoryDetails();
          fetchMemoryActivity();
          // NOTE: We do NOT call onRefreshMedia() here to avoid heavy reload
          // The media page will refresh when the user navigates to it
        }}
        memoryId={memoryId}
        memoryTitle={uiMemory.title}
        memoryThumbnail={apiMemoryData?.last_update_img || apiMemoryData?.thumbnail}
        memoryCreatedDate={apiMemoryData?.created_at}
        userRole={currentUserRole}
        parentImageId={parentImageIdForSubImage}
        capturedFiles={capturedFiles}
        memoryImages={memoryImagesWithSubImages}
        buttonRef={addMomentButtonRef}
        onOpenMediaLibrary={() => {
          console.log('🔍 onOpenMediaLibrary called - Opening media library');
          console.log('🔍 Current userRole:', currentUserRole);
          console.log('🔍 Setting isAddMomentSelectionMode: true');
          console.log('🔍 Setting isMediaLibraryOpen: true');
          setIsAddMomentSelectionMode(true);
          setIsMediaLibraryOpen(true);
          console.log('🔍 States updated');
        }}
        selectedMediaLibraryImages={selectedMediaLibraryImagesForMoment}
        onAddMoment={(momentData) => {
          console.log('Moment added:', momentData);
          // Close modal immediately
          setIsAddMomentModalOpen(false);
          setSelectedMediaLibraryImagesForMoment([]);
          setCapturedFiles(null); // Clear captured files
          // Refresh memory data instead of page reload
          fetchMemoryDetails();

          // Refresh memories list on parent page
          if (onRefresh) {
            onRefresh();
          }
          // NOTE: We do NOT call onRefreshMedia() here to avoid heavy reload
          // The media page will refresh when the user navigates to it
        }}
      />

      {/* Hidden Camera Input for Mobile - Owner View */}
      <input
        ref={cameraInputRef}
        type="file"
        accept="image/*"
        capture="environment"
        className="hidden"
        onChange={handleCameraCapture}
      />

      {/* Hidden Media Library Input for Mobile - Owner View */}
      <input
        ref={mediaLibraryInputRef}
        type="file"
        accept="image/*"
        className="hidden"
        onChange={handleMediaLibrarySelection}
      />

      {/* Camera Options Modal - Owner View */}
      {showCameraOptions && (
        <div
          className="fixed inset-0 bg-black/50 z-[60] flex items-end md:items-center md:justify-center"
          onClick={() => setShowCameraOptions(false)}
        >
          <div
            className="bg-white rounded-t-3xl md:rounded-2xl w-full md:max-w-md p-6 pb-8 md:pb-6 space-y-4"
            onClick={(e) => e.stopPropagation()}
          >
            <h3 className="text-lg font-semibold text-center text-gray-900 mb-4">Add Photo</h3>

            <button
              onClick={handleTakePhoto}
              className="w-full flex items-center gap-4 p-4 bg-[#6C60FF] hover:bg-[#5B4FE8] text-white rounded-xl transition-colors"
            >
              <Camera className="w-6 h-6" />
              <span className="text-base font-medium">Take Photo</span>
            </button>

            <button
              onClick={handleChooseFromLibrary}
              className="w-full flex items-center gap-4 p-4 bg-gray-100 hover:bg-gray-200 text-gray-900 rounded-xl transition-colors"
            >
              <ImageIcon className="w-6 h-6" />
              <span className="text-base font-medium">Choose from Library</span>
            </button>

            <button
              onClick={() => setShowCameraOptions(false)}
              className="w-full p-4 text-gray-600 hover:text-gray-900 font-medium transition-colors"
            >
              Cancel
            </button>
          </div>
        </div>
      )}

      {/* Camera Interface - Owner View */}
      <CameraInterface
        isOpen={showCameraInterface}
        onClose={() => setShowCameraInterface(false)}
        onCapture={handleCameraInterfaceCapture}
      />

      {/* Floating Camera Button - Mobile Only - Owner View */}
      <button
        onClick={handleCameraClick}
        className="md:hidden fixed bottom-[100px] left-1/2 -translate-x-1/2 z-50 w-24 h-24 bg-[#6C60FF] hover:bg-[#5B4FE8] rounded-full shadow-lg flex items-center justify-center transition-all active:scale-95"
        aria-label="Open Camera"
      >
        <Camera className="w-8 h-8 text-white" />
      </button>

      {/* Delete Confirmation Dialog */}
      <AlertDialog open={showDeleteDialog} onOpenChange={setShowDeleteDialog}>
        <AlertDialogContent className="bg-white border-0">
          <AlertDialogHeader>
            <AlertDialogTitle>Delete Memory</AlertDialogTitle>
            <AlertDialogDescription>
              Are you sure you want to delete this memory? This action cannot be undone and will permanently remove the memory and all its associated photos and moments.
              <br /><br />
              <strong>Memory to delete: {uiMemory?.title || 'this memory'}</strong>
            </AlertDialogDescription>
          </AlertDialogHeader>
          <AlertDialogFooter>
            <AlertDialogCancel disabled={isDeleting}>Cancel</AlertDialogCancel>
            <AlertDialogAction
              onClick={handleDeleteConfirm}
              disabled={isDeleting}
              className="bg-red-600 hover:bg-red-700 text-white"
            >
              {isDeleting ? 'Deleting...' : 'Delete Memory'}
            </AlertDialogAction>
          </AlertDialogFooter>
        </AlertDialogContent>
      </AlertDialog>

      {/* Delete Media Item Confirmation Dialog */}
      <AlertDialog open={showDeleteItemDialog} onOpenChange={setShowDeleteItemDialog}>
        <AlertDialogContent className="bg-white border-0">
          <AlertDialogHeader>
            <AlertDialogTitle>Delete Image</AlertDialogTitle>
            <AlertDialogDescription>
              Are you sure you want to delete this image? This action cannot be undone and will permanently remove the image from this memory.
              <br /><br />
              <strong>This image will be deleted permanently.</strong>
            </AlertDialogDescription>
          </AlertDialogHeader>
          <AlertDialogFooter>
            <AlertDialogCancel disabled={isDeletingItem}>Cancel</AlertDialogCancel>
            <AlertDialogAction
              onClick={handleDeleteItemConfirm}
              disabled={isDeletingItem}
              className="bg-red-600 hover:bg-red-700 text-white"
            >
              {isDeletingItem ? 'Deleting...' : 'Delete Image'}
            </AlertDialogAction>
          </AlertDialogFooter>
        </AlertDialogContent>
      </AlertDialog>

      {/* AI Memory Wizard Modal - Shows briefly then animates to bottom-left sidebar */}
      {isAIWizardModalOpen && (
        <div
          className={`fixed inset-0 z-50 flex items-center justify-center p-4 transition-all duration-700 ease-in-out ${
            aiWizardAnimatingOut ? 'bg-transparent' : 'bg-black/50 backdrop-blur-sm'
          }`}
        >
          <div
            className="bg-white rounded-2xl shadow-xl p-6 relative transition-all duration-700 ease-in-out"
            style={{
              maxWidth: aiWizardAnimatingOut ? '280px' : '32rem',
              width: '100%',
              transform: aiWizardAnimatingOut
                ? 'translate(-50vw, 40vh) scale(0.5)'
                : 'translate(0, 0) scale(1)',
              opacity: aiWizardAnimatingOut ? 0.3 : 1,
            }}
          >
            {/* Close button */}
            <button
              onClick={() => {
                setIsAIWizardModalOpen(false);
                setAiWizardAnimatingOut(false);
              }}
              className="absolute top-4 right-4 text-gray-400 hover:text-gray-600"
            >
              <X className="w-5 h-5" />
            </button>

            {/* Header */}
            <div className="flex items-start gap-3 mb-6">
              <div className="p-2 rounded-lg bg-gradient-to-br from-purple-100 to-pink-100">
                <Sparkles className="w-5 h-5" style={{ color: '#6C60FF' }} />
              </div>
              <div>
                <h2 className="text-lg font-semibold text-gray-900">Memory Wizard AI</h2>
                <p className="text-sm text-gray-500">{filteredAndSortedMediaItems.length} files uploaded • AI-powered organisation</p>
              </div>
            </div>

            {/* Loading Animation - Hide during animation */}
            {!aiWizardAnimatingOut && (
              <div className="flex justify-center my-8">
                <div className="relative">
                  <div className="w-24 h-24 rounded-full border-4 border-gray-200 animate-pulse"></div>
                  <div
                    className="absolute inset-0 w-24 h-24 rounded-full border-4 border-t-transparent animate-spin"
                    style={{ borderColor: '#6C60FF', borderTopColor: 'transparent' }}
                  ></div>
                  <div className="absolute inset-0 flex items-center justify-center">
                    <Sparkles className="w-10 h-10" style={{ color: '#EC4899' }} />
                  </div>
                </div>
              </div>
            )}

            {/* Content - Hide during animation */}
            {!aiWizardAnimatingOut && (
              <div className="text-center mb-6">
                <h3 className="text-xl font-semibold text-gray-900 mb-2">
                  Analyzing your photos with AI...
                </h3>
                <p className="text-gray-600 text-sm">
                  Detecting faces, objects, locations, and themes to suggest the best organization options.
                </p>
                <p className="text-xs text-gray-400 mt-2">
                  This will move to sidebar shortly...
                </p>
              </div>
            )}

            {/* Progress Bar */}
            <div className="space-y-2">
              <div className="w-full bg-gray-200 rounded-full h-2 overflow-hidden">
                <div
                  className="h-full rounded-full transition-all duration-300 ease-out"
                  style={{
                    width: `${aiWizardProgress}%`,
                    background: 'linear-gradient(to right, #6C60FF, #EC4899)'
                  }}
                />
              </div>
              <p className="text-sm text-center text-gray-600">
                {aiWizardAnimatingOut
                  ? `Processing... ${aiWizardProgress}%`
                  : `Processing ${filteredAndSortedMediaItems.length} files... ${aiWizardProgress}%`
                }
              </p>
            </div>
          </div>
        </div>
      )}

      {/* AI Memory Wizard Results Modal */}
      {isAIResultsModalOpen && (
        <div className="fixed inset-0 bg-black/50 backdrop-blur-sm z-50 flex items-center justify-center p-4">
          <div className="bg-white rounded-2xl shadow-xl max-w-2xl w-full max-h-[90vh] overflow-y-auto relative">
            {/* Close button */}
            <button
              onClick={() => {
                setIsAIResultsModalOpen(false);
                setSelectedAnalysisOption(null);
                setCustomPrompt('');
              }}
              className="absolute top-4 right-4 text-gray-400 hover:text-gray-600 z-10"
            >
              <X className="w-5 h-5" />
            </button>

            {/* Header */}
            <div className="p-6 border-b border-gray-100">
              <div className="flex items-start gap-3">
                <div className="p-2 rounded-lg bg-gradient-to-br from-purple-100 to-pink-100">
                  <Sparkles className="w-5 h-5" style={{ color: '#6C60FF' }} />
                </div>
                <div>
                  <h2 className="text-lg font-semibold text-gray-900">AI Memory Wizard</h2>
                  <p className="text-sm text-gray-600">
                    {filteredAndSortedMediaItems.length} files uploaded • AI-powered organisation
                  </p>
                </div>
              </div>
              <div className="mt-3">
                <p className="text-sm text-gray-500">Working on:</p>
                <p className="text-sm font-medium text-gray-900">{uiMemory?.title || 'Memory Analysis'}</p>
              </div>
            </div>

            {/* Tabs */}
            <div className="border-b border-gray-200">
              <div className="flex">
                <button
                  onClick={() => setAiActiveTab('suggestions')}
                  className={`flex-1 px-6 py-3 text-sm font-medium transition-colors flex items-center justify-center gap-2 ${
                    aiActiveTab === 'suggestions'
                      ? 'text-purple-600 border-b-2 border-purple-600'
                      : 'text-gray-500 hover:text-gray-700'
                  }`}
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" className="lucide lucide-sparkles w-4 h-4 mr-2 flex-shrink-0" style={{ color: 'rgb(108, 96, 255)' }}>
                    <path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"></path>
                    <path d="M20 3v4"></path>
                    <path d="M22 5h-4"></path>
                    <path d="M4 17v2"></path>
                    <path d="M5 18H3"></path>
                  </svg>
                  AI Suggestions
                </button>
                <button
                  onClick={() => setAiActiveTab('prompt')}
                  className={`flex-1 px-6 py-3 text-sm font-medium transition-colors ${
                    aiActiveTab === 'prompt'
                      ? 'text-purple-600 border-b-2 border-purple-600'
                      : 'text-gray-500 hover:text-gray-700'
                  }`}
                >
                  Write your own Prompt
                </button>
              </div>
            </div>

            {/* Content */}
            <div className="p-6">
              {aiActiveTab === 'suggestions' ? (
                <div className="space-y-4">
                  {(() => {
                    // Static options - always show these 3 options
                    const summaryItems = [
                      {
                        type: 'faces',
                        title: 'Faces Detected',
                        description: 'Found different people in your photos',
                        confidence: `${Math.floor(Math.random() * (98 - 85 + 1)) + 85}%`
                      },
                      {
                        type: 'moments',
                        title: 'Moments Detected',
                        description: 'Detected special moments or occasions',
                        confidence: `${Math.floor(Math.random() * (98 - 85 + 1)) + 85}%`
                      },
                      {
                        type: 'objects',
                        title: 'Objects Detected',
                        description: 'Found different types of objects',
                        confidence: `${Math.floor(Math.random() * (98 - 85 + 1)) + 85}%`
                      }
                    ];

                    return summaryItems.map((item: any, index: number) => {
                      const isSelected = selectedAnalysisOption === index;
                      const handleSelection = () => {
                        setSelectedAnalysisOption(isSelected ? null : index);
                      };

                      const getIcon = (type: string) => {
                        if (type === 'faces') return UserCircle;
                        if (type === 'moments') return Heart;
                        if (type === 'objects') return Package;
                        return Package;
                      };

                      const Icon = getIcon(item.type);

                      return (
                        <div
                          key={index}
                          onClick={handleSelection}
                          className={`bg-white rounded-xl p-4 cursor-pointer transition-all duration-200 ${
                            isSelected
                              ? 'border-2 border-purple-500 bg-purple-50'
                              : 'border border-gray-200 hover:border-gray-300'
                          }`}
                        >
                          <div className="flex items-start justify-between">
                            <div className="flex items-start gap-3">
                              <div className={`p-1.5 rounded-lg ${
                                isSelected ? 'bg-purple-100' : 'bg-gray-100'
                              }`}>
                                <Icon className={`w-4 h-4 ${
                                  isSelected ? 'text-purple-600' : 'text-gray-600'
                                }`} />
                              </div>
                              <div className="flex-1 min-w-0">
                                <h3 className={`font-medium ${
                                  isSelected ? 'text-purple-600' : 'text-gray-900'
                                }`}>
                                  {item.title}
                                </h3>
                                <p className="text-sm text-gray-600 mt-1 leading-relaxed whitespace-normal break-words">
                                  {item.description}
                                </p>
                              </div>
                            </div>
                            <span className={`text-sm font-medium ${
                              isSelected ? 'text-purple-600' : 'text-gray-600'
                            }`}>
                              {item.confidence} confident
                            </span>
                          </div>
                        </div>
                      );
                    });
                  })()}
                </div>
              ) : (
                <div className="space-y-4">
                  <div>
                    <h3 className="font-medium text-gray-900 mb-4">Custom Prompt</h3>
                    <div className="relative">
                      <textarea
                        className="w-full h-40 p-4 bg-gray-100 border-0 rounded-lg resize-none focus:outline-none focus:ring-2 focus:ring-purple-500 text-gray-700"
                        placeholder="Describe what you'd like the AI to help you with for this memory..."
                        maxLength={1000}
                        value={customPrompt}
                        onChange={(e) => setCustomPrompt(e.target.value)}
                      />
                      <div className="flex justify-between items-center mt-3">
                        <span className="text-sm text-gray-500">{customPrompt.length}/1000 characters</span>
                      </div>
                    </div>
                  </div>
                </div>
              )}
            </div>

            {/* Footer */}
            <div className="p-6 border-t border-gray-100 bg-gray-50">
              <div className="flex justify-between items-center">
                <span className="text-sm text-gray-500">
                  {selectedAnalysisOption !== null ? '1 task selected' : '0 tasks selected'}
                </span>
                <div className="flex gap-3">
                  <Button
                    variant="outline"
                    onClick={() => setIsAIResultsModalOpen(false)}
                    className="px-6 text-sm border-gray-300 hover:border-gray-300 focus:border-gray-300 focus:ring-0"
                  >
                    Skip for now
                  </Button>
                  <Button
                    onClick={async () => {
                      if (aiActiveTab === 'suggestions') {
                        if (selectedAnalysisOption !== null) {
                          // Convert summary object to array format (same as display logic)
                          const summaryItems = [];
                          const summary = aiAnalysisData.summary;

                          if (summary.faces) {
                            summaryItems.push({
                              type: 'faces',
                              title: 'Faces Detected',
                              description: summary.faces.description || 'Group people together based on facial recognition',
                              groups: summary.faces.total_groups || 0,
                              totalImages: summary.faces.total_images_with_faces || 0,
                              confidence: `${Math.floor(Math.random() * (98 - 85 + 1)) + 85}%`
                            });
                          }

                          if (summary.moments) {
                            summaryItems.push({
                              type: 'moments',
                              title: 'Moments Detected',
                              description: summary.moments.description || 'Organize photos by special moments and events',
                              groups: summary.moments.total_groups || 0,
                              totalImages: summary.moments.total_images || 0,
                              confidence: `${Math.floor(Math.random() * (98 - 85 + 1)) + 85}%`
                            });
                          }

                          if (summary.objects) {
                            summaryItems.push({
                              type: 'objects',
                              title: 'Objects Detected',
                              description: summary.objects.description || 'Categorize photos by detected objects and scenes',
                              groups: summary.objects.total_groups || 0,
                              totalImages: summary.objects.total_images || 0,
                              confidence: `${Math.floor(Math.random() * (98 - 85 + 1)) + 85}%`
                            });
                          }

                          const selectedTask = summaryItems[selectedAnalysisOption];

                          if (!selectedTask) {
                            toast.error("Selected task not found");
                            return;
                          }

                          // Use the type from the selected task
                          const type = selectedTask.type as 'faces' | 'moments' | 'objects';

                          console.log('🎯 Apply Task - Selected Type:', type);
                          console.log('🎯 Apply Task - aiAnalysisData:', JSON.stringify(aiAnalysisData, null, 2));
                          console.log('🎯 Apply Task - Available keys in aiAnalysisData:', Object.keys(aiAnalysisData || {}));
                          console.log('🎯 Apply Task - aiAnalysisData.summary:', aiAnalysisData?.summary);
                          console.log('🎯 Apply Task - aiAnalysisData.clusters:', aiAnalysisData?.clusters);

                          // Access the cluster data from clusters object
                          // The API response structure is: aiAnalysisData.clusters.faces/moments/objects
                          if (!aiAnalysisData?.clusters) {
                            console.error(`❌ No clusters object found in AI analysis`);
                            console.error(`❌ Available keys:`, Object.keys(aiAnalysisData || {}));
                            toast.error('No cluster data found in AI analysis');
                            return;
                          }

                          const groupData = aiAnalysisData.clusters[type];

                          console.log(`🎯 Apply Task - clusters.${type}:`, groupData);
                          console.log(`🎯 Apply Task - groupData type:`, typeof groupData);
                          console.log(`🎯 Apply Task - groupData is array:`, Array.isArray(groupData));

                          if (!groupData) {
                            console.error(`❌ No ${type} data found in clusters`);
                            console.error(`❌ Available cluster keys:`, Object.keys(aiAnalysisData.clusters || {}));
                            toast.error(`No ${type} data found in AI analysis`);
                            return;
                          }

                          if (!Array.isArray(groupData) || groupData.length === 0) {
                            console.error(`❌ ${type} data is not an array or is empty:`, groupData);
                            toast.error(`No ${type} clusters found in the analysis`);
                            return;
                          }

                          console.log(`✅ Using ${type} data with ${groupData.length} clusters`);
                          console.log(`✅ First cluster sample:`, groupData[0]);

                          setIsApplyingTask(true);

                          try {
                            console.log('Applying AI task:', { type, groupData });
                            console.log('Full AI analysis data:', aiAnalysisData);

                            // Call the API with only the specific group array
                            const response = await dashboardAPI.createMemoriesFromGroups(groupData, type);

                            if (response.success) {
                              toast.success(`Successfully created memories from ${type}!`);
                              setIsAIResultsModalOpen(false);
                              setSelectedAnalysisOption(null);

                              // Refresh memories data then navigate back to memories page
                              if (onRefresh) {
                                await onRefresh();
                              }
                              onBack();
                            } else {
                              toast.error(response.error || `Failed to create memories from ${type}`);
                            }
                          } catch (error) {
                            console.error('Error applying AI task:', error);
                            toast.error("Failed to apply AI suggestion. Please try again.");
                          } finally {
                            setIsApplyingTask(false);
                          }
                        } else {
                          toast.error("Please select a task to apply");
                        }
                      } else {
                        // Custom prompt tab
                        if (customPrompt.trim()) {
                          handleCustomPromptGeneration();
                        } else {
                          toast.error("Please enter a prompt first");
                        }
                      }
                    }}
                    disabled={
                      aiActiveTab === 'suggestions'
                        ? selectedAnalysisOption === null || isApplyingTask
                        : !customPrompt.trim() || isGeneratingFromPrompt
                    }
                    className={`px-6 text-sm text-white ${
                      (aiActiveTab === 'suggestions' ? selectedAnalysisOption !== null && !isApplyingTask : customPrompt.trim() && !isGeneratingFromPrompt)
                        ? 'bg-purple-600 hover:bg-purple-700'
                        : 'bg-gray-400 cursor-not-allowed'
                    }`}
                  >
                    {aiActiveTab === 'suggestions'
                      ? isApplyingTask
                        ? (
                          <>
                            <div className="w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin mr-2"></div>
                            Applying...
                          </>
                        )
                        : `Apply Task → ${selectedAnalysisOption !== null ? '(1)' : '(0)'}`
                      : isGeneratingFromPrompt
                        ? (
                          <>
                            <div className="w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin mr-2"></div>
                            Generating...
                          </>
                        )
                        : 'Generate →'
                    }
                  </Button>
                </div>
              </div>
            </div>
          </div>
        </div>
      )}

      {void console.log('🎨 RENDERING SECOND ImageViewer - isOpen:', imageViewer.isOpen, 'imageViewer.memoryId:', imageViewer.memoryId, 'imageViewer.imageId:', imageViewer.imageId)}
      {void console.log('🗑️ Passing handleDeleteSubImage to second ImageViewer:', typeof handleDeleteSubImage, handleDeleteSubImage)}
      <ImageViewer
        isOpen={imageViewer.isOpen}
        imageSrc={imageViewer.src}
        imageAlt={imageViewer.alt}
        title={imageViewer.title}
        subtitle={imageViewer.subtitle}
        filename={imageViewer.filename}
        dateTaken={imageViewer.dateTaken}
        location={imageViewer.location}
        images={imageViewer.images}
        largeSize={true}
        coverContentOnly={false}
        onClose={handleCloseImageViewer}
        currentImageIndex={imageViewer.currentIndex}
        onNextImage={handleNextImage}
        onPrevImage={handlePrevImage}
        isSelected={imageViewer.imageId ? selectedItems.includes(imageViewer.imageId) : false}
        onToggleSelection={handleToggleImageSelection}
        imageId={imageViewer.imageId}
        memoryId={imageViewer.memoryId}
        memoryTitle={apiMemoryData?.title || uiMemory.title}
        memoryThumbnail={apiMemoryData?.last_update_img || apiMemoryData?.thumbnail}
        memoryCreatedDate={apiMemoryData?.created_at}
        memoryImages={memoryImagesWithSubImages}
        userRole={currentUserRole}
        parentImageIsFeatured={imageViewer.parentImageIsFeatured}
        onSubImageAdded={async () => {
          // Refresh memory data when a sub-image is added
          await fetchMemoryDetails();
          await fetchMemoryActivity();
        }}
        onGetSubImages={(parentImageId) => {
          // Get all sub-images for the given parent image ID from raw API posts
          const allPosts = rawApiPosts || [];
          console.log('🔍 onGetSubImages called with parentImageId:', parentImageId);
          console.log('🔍 All posts count:', allPosts.length);
          console.log('🔍 Posts with parent_id:', allPosts.filter((p: any) => p.parent_id).map((p: any) => ({ id: p.id, parent_id: p.parent_id, image: p.image_link })));

          const subImages = allPosts
            .filter((post: any) => {
              // Convert both to strings for comparison to handle type mismatches
              const postParentId = post.parent_id?.toString();
              const searchParentId = parentImageId?.toString();
              const isSubImage = postParentId === searchParentId;

              // Only show approved sub-images (admin_approval !== 0)
              const isApproved = post.admin_approval === 1 || post.admin_approval === '1' || post.admin_approval === undefined || post.admin_approval === null;

              if (post.parent_id) {
                console.log(`🔍 Checking post ${post.id}: parent_id=${postParentId}, searching for=${searchParentId}, isSubImage=${isSubImage}, admin_approval=${post.admin_approval}, isApproved=${isApproved}`);
              }

              return isSubImage && isApproved;
            })
            .map((post: any) => ({
              id: post.id?.toString(),
              src: post.image_link ? post.image_link.replace(/\\\//g, '/') : (post.image || post.image_url || ''),
              alt: post.name || post.title || 'Sub-image',
              title: post.name || post.title,
              description: post.description || '',
              location: post.location || '',
              dateTaken: post.capture_date || post.created_at || '',
              filename: post.name || post.title || 'Sub-image',
              is_featured: post.is_featured || 0
            }));

          console.log(`📸 Found ${subImages.length} sub-images for parent ${parentImageId}:`, subImages);
          return subImages;
        }}
        initialSubImageId={(imageViewer as any).initialSubImageId}
        initialRotation={imageViewer.rotation_angle}
        onRefreshData={async () => {
          // Fetch the updated data and get the fresh memory data
          await fetchMemoryDetails();
          await fetchMemoryActivity();
        }}
        onFeaturedImageSet={async () => {
          // Refresh memory data when featured image is set
          console.log('🌟 Featured image set, refreshing memory details...');
          await fetchMemoryDetails();
          await fetchMemoryActivity();
        }}
        locationData={{
          address: imageViewer.location
        }}
        onLocationChange={(newLocation) => {
          // Update the imageViewer state immediately so it persists when modal reopens
          setImageViewer(prev => ({
            ...prev,
            location: newLocation
          }));
        }}
        onDescriptionUpdate={(imageId, newDescription) => {
          // Update the timeline immediately when description changes in modal
          setUpdatedPosts(prev => ({
            ...prev,
            [imageId]: newDescription
          }));
        }}
        onCommentCountChange={handleCommentCountChange}
        activeCollaborators={apiCollaborators.filter(c => c.status === 'active')}
        onDeleteSubImage={handleDeleteSubImage}
      />

      {/* Media Library Modal */}
      {void console.log('🎬 Rendering check - isMediaLibraryOpen:', isMediaLibraryOpen)}
      {isMediaLibraryOpen && (
        <div className="fixed inset-0 z-[100002] flex items-center justify-center">
          <div className="fixed inset-0 bg-black/50" onClick={() => {
            setIsMediaLibraryOpen(false);
            setIsCoverPhotoSelectionMode(false);
            setIsAddMomentSelectionMode(false);
            setMediaLibrarySelectedItems([]);
          }} />
          <div className="relative z-[100003] max-w-3xl max-h-[90vh] w-full mx-4 bg-white flex flex-col rounded-lg overflow-hidden border border-gray-200 shadow-xl">
          {/* Header */}
          <div className="flex items-center gap-3 px-6 py-4 border-b border-gray-200 bg-white">
            <div className="flex items-center justify-center w-10 h-10 bg-[#6C60FF]/10 rounded-lg">
              <ImageIcon className="w-5 h-5 text-[#6C60FF]" />
            </div>
            <div className="flex-1">
              <h2 className="text-lg font-semibold text-gray-900">
                {isCoverPhotoSelectionMode ? 'Select Cover Photo' : isAddMomentSelectionMode ? 'Add Moments from Library' : 'Media Library'}
              </h2>
              <p className="text-sm text-gray-500">
                {isCoverPhotoSelectionMode ? 'Choose one photo for your memory cover' : isAddMomentSelectionMode ? 'Select photos to add as moments' : 'Select photos to add to this memory'}
              </p>
            </div>
          </div>

          {/* Search and Filter */}
          <div className="flex items-center gap-3 px-6 py-4 border-b border-gray-200 bg-white">
            <div className="flex-1 relative">
              <MapPin className="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400" />
              <Input
                placeholder="Search your media library..."
                value={mediaLibrarySearchTerm}
                onChange={(e) => setMediaLibrarySearchTerm(e.target.value)}
                className="pl-10 border-gray-300 focus:border-gray-400 focus:ring-gray-400"
              />
            </div>
            <Select value={mediaLibraryCategory} onValueChange={setMediaLibraryCategory}>
              <SelectTrigger className="w-48 border-gray-300 focus:border-gray-400 focus:ring-gray-400">
                <SelectValue />
              </SelectTrigger>
              <SelectContent>
                <SelectItem value="All Categories">All Categories</SelectItem>
                {mediaLibraryCategories.map((cat) => (
                  <SelectItem key={cat} value={cat}>{cat}</SelectItem>
                ))}
              </SelectContent>
            </Select>
          </div>

          {/* Selection Info */}
          {!isCoverPhotoSelectionMode && isAddMomentSelectionMode && (
            <div className="flex items-center justify-between px-6 py-3 bg-gray-50 border-b border-gray-200">
              <div className="flex items-center gap-4">
                <span className="text-sm font-medium text-gray-700">
                  <span className="text-[#6C60FF]">{mediaLibrarySelectedItems.length} of</span> {filteredMediaLibraryImages.length} selected
                </span>
                <button
                  onClick={() => {
                    setMediaLibrarySelectedItems(filteredMediaLibraryImages.map(p => p.id));
                  }}
                  className="text-sm text-[#6C60FF] hover:text-[#5850E5] font-medium"
                >
                  Select All
                </button>
              </div>
              <button
                onClick={() => setMediaLibrarySelectedItems([])}
                className="flex items-center gap-1 text-sm text-gray-600 hover:text-gray-900"
              >
                <X className="w-4 h-4" />
                Clear Selection
              </button>
            </div>
          )}

          {/* Media Grid */}
          <div className="flex-1 overflow-y-auto px-6 py-4 bg-white">
            {isLoadingMediaLibrary ? (
              <div className="flex items-center justify-center py-12">
                <div className="animate-spin rounded-full h-8 w-8 border-b-2 border-[#6C60FF]"></div>
              </div>
            ) : filteredMediaLibraryImages.length === 0 ? (
              <div className="flex flex-col items-center justify-center py-12 text-center">
                <ImageIcon className="w-12 h-12 text-gray-300 mb-3" />
                <p className="text-gray-600 font-medium">No images found</p>
                <p className="text-sm text-gray-400 mt-1">
                  {mediaLibrarySearchTerm || mediaLibraryCategory !== "All Categories"
                    ? "Try adjusting your search or filters"
                    : "Upload some images to get started"}
                </p>
              </div>
            ) : (
              <div className="grid grid-cols-3 gap-4">
                {filteredMediaLibraryImages.map((post) => {
                  const isSelected = mediaLibrarySelectedItems.includes(post.id);
                  return (
                    <div
                      key={post.id}
                      className={`relative group cursor-pointer rounded-lg overflow-hidden border-2 transition-all shadow-sm hover:shadow-md ${
                        isSelected ? 'border-[#6C60FF] ring-2 ring-[#6C60FF]/20 shadow-lg' : 'border-gray-200 hover:border-gray-300'
                      }`}
                    onClick={() => {
                      if (isCoverPhotoSelectionMode) {
                        // In cover photo mode, only allow selecting one image
                        setMediaLibrarySelectedItems([post.id]);
                      } else {
                        // In normal and Add Moment modes, allow multiple selections
                        setMediaLibrarySelectedItems(prev =>
                          prev.includes(post.id)
                            ? prev.filter(id => id !== post.id)
                            : [...prev, post.id]
                        );
                      }
                    }}
                  >
                    {/* Checkbox */}
                    <div className="absolute top-2 left-2 z-10">
                      <div className={`w-5 h-5 rounded border-2 flex items-center justify-center transition-all ${
                        isSelected
                          ? 'bg-[#6C60FF] border-[#6C60FF]'
                          : 'bg-white border-gray-300 group-hover:border-gray-400'
                      }`}>
                        {isSelected && (
                          <svg className="w-3 h-3 text-white" viewBox="0 0 12 12" fill="none">
                            <path d="M10 3L4.5 8.5L2 6" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"/>
                          </svg>
                        )}
                      </div>
                    </div>

                    {/* Image */}
                    <div className="aspect-square bg-gray-100">
                      <img
                        src={post.image || ''}
                        alt={post.title}
                        className="w-full h-full object-cover"
                      />
                    </div>

                    {/* Info */}
                    <div className="p-3 bg-white">
                      <div className="flex items-center gap-2 mb-1">
                        <span className="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium text-white bg-[#6C60FF]">
                          {post.category || 'Travel'}
                        </span>
                      </div>
                      <p className="text-sm font-medium text-gray-900 truncate">{post.title}</p>
                      <div className="flex items-center gap-2 text-xs text-gray-500 mt-1">
                        <span>2.4 MB</span>
                        {post.date && !isNaN(new Date(post.date).getTime()) && (
                          <>
                            <span>•</span>
                            <span>{new Date(post.date).toLocaleDateString()}</span>
                          </>
                        )}
                      </div>
                    </div>
                  </div>
                );
              })}
              </div>
            )}
          </div>

          {/* Footer */}
          <div className="flex items-center justify-between px-6 py-4 border-t border-gray-200 bg-gray-50">
            <p className="text-sm text-gray-600">
              {isCoverPhotoSelectionMode
                ? 'Select a photo to set as cover'
                : isAddMomentSelectionMode
                ? `${mediaLibrarySelectedItems.length} ${mediaLibrarySelectedItems.length === 1 ? 'photo' : 'photos'} selected`
                : 'Ready to add to memory'}
            </p>
            <div className="flex items-center gap-3">
              <Button
                variant="outline"
                onClick={() => {
                  setIsMediaLibraryOpen(false);
                  setMediaLibrarySelectedItems([]);
                  setIsCoverPhotoSelectionMode(false);
                  setIsAddMomentSelectionMode(false);
                }}
              >
                Cancel
              </Button>
              <Button
                className="bg-[#6C60FF] hover:bg-[#5850E5] text-white"
                disabled={mediaLibrarySelectedItems.length === 0}
                onClick={async () => {
                  if (isCoverPhotoSelectionMode) {
                    // Cover photo mode: Get the selected image URL
                    const selectedImage = filteredMediaLibraryImages.find(img => img.id === mediaLibrarySelectedItems[0]);
                    if (selectedImage) {
                      await handleUpdateCoverPhotoFromLibrary(selectedImage.image);
                    }
                  } else if (isAddMomentSelectionMode) {
                    // Add moment mode: Pass selected images to AddMomentModal
                    const selectedImages = filteredMediaLibraryImages.filter(img =>
                      mediaLibrarySelectedItems.includes(img.id)
                    );
                    console.log('Passing moments to AddMomentModal:', selectedImages);

                    // Pass selected images to AddMomentModal
                    setSelectedMediaLibraryImagesForMoment(selectedImages);

                    // Close media library modal
                    setIsMediaLibraryOpen(false);
                    setMediaLibrarySelectedItems([]);
                    setIsAddMomentSelectionMode(false);
                  } else {
                    // Normal mode: TODO for future implementation
                    console.log('Adding items:', mediaLibrarySelectedItems);
                    setIsMediaLibraryOpen(false);
                    setMediaLibrarySelectedItems([]);
                  }
                }}
              >
                {isCoverPhotoSelectionMode
                  ? 'Set as Cover Photo'
                  : isAddMomentSelectionMode
                  ? `Add ${mediaLibrarySelectedItems.length} ${mediaLibrarySelectedItems.length === 1 ? 'Moment' : 'Moments'}`
                  : `Add ${mediaLibrarySelectedItems.length} ${mediaLibrarySelectedItems.length === 1 ? 'item' : 'items'}`}
              </Button>
            </div>
          </div>
        </div>
        </div>
      )}

      {/* Delete Progress Modal */}
      {isDeletingItems && (
        <div className="fixed inset-0 bg-black/50 flex items-center justify-center z-50">
          <div className="bg-white rounded-lg p-6 max-w-md w-full mx-4 shadow-xl">
            <div className="text-center">
              <div className="w-16 h-16 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-4">
                <Trash2 className="w-8 h-8 text-red-600" />
              </div>
              <h3 className="text-lg font-semibold text-gray-900 mb-2">Deleting Images</h3>
              <p className="text-sm text-gray-500 mb-4">Please wait while we delete your selected images...</p>

              {/* Progress Bar */}
              <div className="w-full bg-gray-200 rounded-full h-2 mb-2">
                <div
                  className="bg-red-600 h-2 rounded-full transition-all duration-300"
                  style={{ width: `${deleteProgress}%` }}
                ></div>
              </div>
              <p className="text-xs text-gray-500">{deleteProgress}%</p>
            </div>
          </div>
        </div>
      )}

      {/* Mobile Bottom Navigation */}
      <div className="fixed bottom-0 left-0 right-0 bg-white border-t border-gray-200 z-50 lg:hidden">
        <div className={`grid ${isOwner ? 'grid-cols-4' : 'grid-cols-3'} gap-0`}>
          {/* Timeline/Overview Tab */}
          <button
            type="button"
            onClick={(e) => { e.preventDefault(); setActiveTab("overview"); }}
            className={`relative flex flex-col items-center justify-center py-3 px-2 transition-all duration-300 overflow-hidden ${
              activeTab === "overview"
                ? 'text-[#6C60FF]'
                : 'text-gray-500'
            }`}
            style={{
              backgroundColor: activeTab === "overview" ? 'var(--color-grey-9356, rgba(217, 218, 255, 0.56))' : 'transparent',
              borderRadius: activeTab === "overview" ? '10px' : '0',
              margin: "10px"
            }}
          >
            <Clock className="w-8 h-8 mb-1 relative z-10" />
            <span className="text-xs font-medium relative z-10">Timeline</span>
          </button>

          {/* Moderation Tab - Only visible to owner */}
          {isOwner && (
            <button
              type="button"
              onClick={(e) => { e.preventDefault(); setActiveTab("moderation"); }}
              className={`relative flex flex-col items-center justify-center py-3 px-2 transition-all duration-300 overflow-hidden ${
                activeTab === "moderation"
                  ? 'text-[#6C60FF]'
                  : 'text-gray-500'
              }`}
              style={{
                backgroundColor: activeTab === "moderation" ? 'var(--color-grey-9356, rgba(217, 218, 255, 0.56))' : 'transparent',
                borderRadius: activeTab === "moderation" ? '10px' : '0',
                margin: "10px"
              }}
            >
              <Shield className="w-8 h-8 mb-1 relative z-10" />
              <span className="text-xs font-medium relative z-10">Moderation</span>
              {pendingPostsCount > 0 && (
                <div className="absolute top-1.5 right-1/4 bg-indigo-500 text-white text-[10px] font-bold rounded-full min-w-[18px] h-[18px] flex items-center justify-center px-1 z-20">
                  {pendingPostsCount}
                </div>
              )}
            </button>
          )}

          {/* Analytics Tab */}
          <button
            type="button"
            onClick={(e) => { e.preventDefault(); setActiveTab("analytics"); }}
            className={`relative flex flex-col items-center justify-center py-3 px-2 transition-all duration-300 overflow-hidden ${
              activeTab === "analytics"
                ? 'text-[#6C60FF]'
                : 'text-gray-500'
            }`}
            style={{
              backgroundColor: activeTab === "analytics" ? 'var(--color-grey-9356, rgba(217, 218, 255, 0.56))' : 'transparent',
              borderRadius: activeTab === "analytics" ? '10px' : '0',
              margin: "10px"
            }}
          >
            <BarChart3 className="w-8 h-8 mb-1 relative z-10" />
            <span className="text-xs font-medium relative z-10">Analytics</span>
          </button>

          {/* Collaborators Tab */}
          <button
            type="button"
            onClick={(e) => { e.preventDefault(); setActiveTab("collaborators"); }}
            className={`relative flex flex-col items-center justify-center py-3 px-2 transition-all duration-300 overflow-hidden ${
              activeTab === "collaborators"
                ? 'text-[#6C60FF]'
                : 'text-gray-500'
            }`}
            style={{
              backgroundColor: activeTab === "collaborators" ? 'var(--color-grey-9356, rgba(217, 218, 255, 0.56))' : 'transparent',
              borderRadius: activeTab === "collaborators" ? '10px' : '0',
              margin: "10px"
            }}
          >
            <Users className="w-8 h-8 mb-1 relative z-10" />
            <span className="text-xs font-medium relative z-10">Collaborators</span>
          </button>
        </div>
      </div>
    </div>
  );
}