  const handlePostDelete = async (postId: string) => {
    // Add to deletedPosts set for immediate UI update
    setDeletedPosts(prev => new Set(prev).add(postId));

    // Refresh memory details to ensure the post is permanently removed
    setTimeout(async () => {
      await fetchMemoryDetails();
      await fetchMemoryActivity();
    }, 500);
  };

  const handleDeleteSubImage = async (subImageId: string) => {
    console.log('🗑️ handleDeleteSubImage called with subImageId:', subImageId);
    try {
      console.log('🗑️ Attempting to delete sub-image:', subImageId);

      // Call the delete image API
      const response = await mediaAPI.deleteImage(subImageId);

      if (response.success) {
        console.log('✅ Sub-image deleted successfully');
        toast.success("Sub-image deleted successfully!");

        // Add to deletedPosts set for immediate UI update
        setDeletedPosts(prev => new Set(prev).add(subImageId));

        // Refresh memory details to update the viewer and timeline
        await fetchMemoryDetails();
        await fetchMemoryActivity();

        // Force re-render
        setRefreshTrigger(prev => prev + 1);
      } else {
        throw new Error('Failed to delete sub-image');
      }
    } catch (error) {
      console.error('❌ Error deleting sub-image:', error);
      toast.error("Failed to delete sub-image");
    }
  };

  // Moderation handlers
  const handleApprovePost = async (postId: string) => {
    try {
      console.log('🔵 Approving post:', postId);

      const getApiBaseUrl = () => {
        if (import.meta.env.VITE_API_BASE_URL) {
          return import.meta.env.VITE_API_BASE_URL;
        }
        if (import.meta.env.DEV) {
          return '/api/react';
        }
        return `${window.location.origin}/api/react`;
      };

      const apiBaseUrl = getApiBaseUrl();
      const apiUrl = `${apiBaseUrl}/memory-images/approve-image`;

      const token = tokenUtils.getToken();

      // Prepare payload - always send the sub-image ID being approved
      const payload: any = { image_id: postId };

      // If parent was changed in dropdown, include the new parent_id
      if (selectedParentIds[postId]) {
        payload.parent_id = selectedParentIds[postId];
        console.log('🔵 Approving sub-image:', postId, 'with NEW parent_id:', selectedParentIds[postId]);
      } else {
        console.log('🔵 Approving image:', postId, '(no parent change)');
      }

      // Make API call
      await fetch(apiUrl, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${token}`
        },
        body: JSON.stringify(payload)
      });

      // API call completed - refresh memory description page data
      console.log('✅ Approve API completed. Refreshing memory data...');
      toast.success("Moment approved!");

      // Wait 1 second for backend to process
      await new Promise(resolve => setTimeout(resolve, 1000));

      // Reload only the memory data
      await fetchMemoryDetails();
      await fetchMemoryActivity();

      // Force re-render
      setRefreshTrigger(prev => prev + 1);

    } catch (error) {
      console.error('❌ Error approving post:', error);
      toast.error("Failed to approve moment");
    }
  };

