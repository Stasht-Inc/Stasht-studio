          // Use email-based API
          console.log(`Non-user collaborator email: ${collaborator.email}`);
          console.log(`API URL: /memories/non-user-collaborator/${collaborator.email}`);
          response = await dashboardAPI.editNonUserCollaboratorRole(collaborator.email, memoryId, newRole);
        } else if (collaborator.phone_number) {
          // Use phone-based API
          console.log(`Non-user collaborator phone: ${collaborator.phone_number}`);
          console.log(`API URL: /memories/non-user-collaborator-by-phone/${encodeURIComponent(collaborator.phone_number)}`);
          response = await dashboardAPI.editNonUserCollaboratorRoleByPhone(collaborator.phone_number, memoryId, newRole);
        } else {
