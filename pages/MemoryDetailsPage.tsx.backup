  // Generate share link for QR code
  const generateShareLink = async (role: string) => {
    if (!memoryId) return;

    setIsGeneratingLink(true);

    try {
      console.log(`=== GENERATING SHARE LINK ===`);
      console.log(`Memory ID: ${memoryId}`);
      console.log(`Role: ${role}`);

      const response = await dashboardAPI.generateShareLink(memoryId, role);

      console.log('Share link response:', response);
      console.log('Response type:', typeof response);
      console.log('Response.data:', response.data);
      console.log('Response.data type:', typeof response.data);

      if (response.success) {
        // The API returns the URL directly as a string in response.data
        let link = '';

        if (!response.data) {
          console.error('No data in response');
          link = `https://stasht.app/join/mem_${memoryId}?role=${role}&invite=true`;
        }
        // Check if response.data is a string (direct URL)
        else if (typeof response.data === 'string') {
          link = response.data.trim();
          console.log('✅ Direct URL received:', link);
        }
        // Check if it's an object with nested data
        else if (typeof response.data === 'object') {
          link = response.data.shortLink || response.data.link || response.data.url || response.data.data || '';
          console.log('✅ URL from object:', link);

          if (!link) {
            console.warn('No URL found in object, using fallback');
            link = `https://stasht.app/join/mem_${memoryId}?role=${role}&invite=true`;
          }
        } else {
          link = String(response.data);
          console.log('✅ URL converted from:', typeof response.data, ':', link);
        }

        setGeneratedShareLink(link);
        console.log('✅ Final generated share link:', link);
      } else {
        console.error('❌ Failed to generate share link:', response.error);
        toast.error("Failed to generate share link");
        // Set a fallback link
        setGeneratedShareLink(`https://stasht.app/join/mem_${memoryId}?role=${role}&invite=true`);
      }
    } catch (error) {
      console.error('Error generating share link:', error);
      toast.error("Error generating share link");
      // Set a fallback link
      setGeneratedShareLink(`https://stasht.app/join/mem_${memoryId}?role=${role}&invite=true`);
    } finally {
      setIsGeneratingLink(false);
    }
  };

  const handleRoleChange = async (collaboratorId: string, newRole: 'view' | 'edit' | 'admin') => {
    try {
      // Find the collaborator to get the correct user ID
      const collaborator = collaborators.find(c => c.id === collaboratorId);
      
      console.log(`=== UPDATING COLLABORATOR ROLE ===`);
