  const handleAddCollaborator = async (newCollaborator: Collaborator) => {
    try {
      // The API call is already made in AddCollaboratorDialog component
      // This function is called after successful API response to refresh the UI
      console.log('Refreshing collaborators after adding:', newCollaborator);

      // Refresh memory details to get the latest collaborators data from API
      await fetchMemoryDetails();

    } catch (error) {
      console.error('Error refreshing collaborators:', error);
    }
  };

  const handleRemoveCollaborator = async (collaboratorId: string) => {
    // Prevent double calls - check if already removing this collaborator
    if (removingCollaboratorId === collaboratorId) {
      console.log(`⚠️ Already removing collaborator ${collaboratorId}, skipping duplicate call`);
      return;
    }

    try {
      // Set loading state to prevent duplicate calls
      setRemovingCollaboratorId(collaboratorId);

      // Find the collaborator to get the correct user ID
      const collaborator = collaborators.find(c => c.id === collaboratorId);

      console.log(`=== REMOVING COLLABORATOR ===`);
      console.log(`Memory ID: ${memoryId}`);
      console.log(`Collaborator ID: ${collaboratorId}`);
      console.log(`Collaborator object:`, collaborator);
      console.log(`Is Non-User Collaborator:`, collaborator?.isNonUser);

      let response;

      if (collaborator?.isNonUser) {
        // For non-user collaborators, check if they have email or phone
        if (collaborator.email) {
          // Use email-based API
          console.log(`Non-user collaborator email to remove: ${collaborator.email}`);
          console.log(`API URL: /memories/non-user-collaborator/${collaborator.email}`);
          response = await dashboardAPI.removeNonUserCollaborator(collaborator.email, memoryId);
        } else if (collaborator.phone_number) {
          // Use phone-based API
          console.log(`Non-user collaborator phone to remove: ${collaborator.phone_number}`);
          console.log(`API URL: /memories/non-user-collaborator-by-phone/${encodeURIComponent(collaborator.phone_number)}`);
          response = await dashboardAPI.removeNonUserCollaboratorByPhone(collaborator.phone_number, memoryId);
        } else {
          console.error('Non-user collaborator has neither email nor phone');
          toast.error("Cannot remove collaborator: missing contact information");
          setRemovingCollaboratorId(null);
          return;
        }
      } else {
        // For regular user collaborators
        const userIdToRemove = collaborator?.userId || collaboratorId;
        console.log(`User ID to remove: ${userIdToRemove}`);
        console.log(`API URL: /memories/${memoryId}/remove-collaborators`);

        // Use the existing removeMemoryCollaborators API
        response = await dashboardAPI.removeMemoryCollaborators(memoryId, [userIdToRemove]);
      }

      if (response.success) {
        // Update local state immediately for better UX
        setApiCollaborators(prev => prev.filter(c => c.id !== collaboratorId));
        toast.success("Collaborator removed successfully");
        console.log(`✅ Collaborator ${collaboratorId} removed successfully`);
      } else {
        console.error(`❌ Failed to remove collaborator:`, response.error);
        toast.error(response.error || "Failed to remove collaborator");
      }
    } catch (error) {
      console.error('🔥 Error removing collaborator:', error);
      toast.error("Failed to remove collaborator");
    } finally {
      // Clear loading state
      setRemovingCollaboratorId(null);
      console.log(`=== END REMOVING COLLABORATOR ===`);
    }
  };

  const handleResendInvite = async (inviteId: number) => {
