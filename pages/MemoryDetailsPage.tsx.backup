import { useState, useEffect, useRef, useMemo } from "react";
import { Helmet } from 'react-helmet-async';
import { ArrowLeft, Calendar, MapPin, Eye, Heart, Edit, Globe, ImageIcon, Clock, MessageSquare, BarChart3, Users, Activity, X, Save, Link, Mail, Copy, Twitter, Facebook, CheckCircle, Shield, UserX, FileText, Plus, Upload, SortAsc, SortDesc, Trash2, Sparkles, UserCircle, Zap, Package, QrCode, Download, Lock, Share2, Linkedin, Code, Send, MoreVertical, Camera } from "lucide-react";
import { useAuth } from "../contexts/AuthContext";
import WeeklyEngCard from "../imports/WeeklyEngCard";
import { Button } from "../components/ui/button";
import { Badge } from "../components/ui/badge";
import { Tabs, TabsContent, TabsList, TabsTrigger } from "../components/ui/tabs";
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "../components/ui/card";
import { Avatar, AvatarFallback, AvatarImage } from "../components/ui/avatar";
import { ImageWithFallback } from "../components/figma/ImageWithFallback";
import { toast } from "sonner";
import { mockPosts } from "../data/mockPosts";
import { getMemoryDetails } from "../data/memoryData";
import { getCategoryColorHex, getCategoryIcon, formatDate } from "../utils/memoryUtils";
import { getCategoryColor } from "../constants/mediaConstants";
import { triggerMemoryCountsRefresh } from '../hooks/useMemoryCounts';
import { useMemoryLimit, recheckMemoryLimit } from '../hooks/useMemoryLimit';
import { dashboardAPI, tokenUtils } from "../utils/authUtils";
import mediaAPI from "../services/mediaAPI";
import { DateRangePicker } from "../components/DateRangePicker";
import PostCard from "../components/PostCard";
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from "../components/ui/select";
import { Popover, PopoverContent, PopoverTrigger } from "../components/ui/popover";
import { HoverCard, HoverCardContent, HoverCardTrigger } from "../components/ui/hover-card";
import { DropdownMenu, DropdownMenuContent, DropdownMenuItem, DropdownMenuTrigger } from "../components/ui/dropdown-menu";
import { Input } from "../components/ui/input";
import { Textarea } from "../components/ui/textarea";
import GooglePlacesInput from "../components/ui/google-places-input";
import { Dialog, DialogContent, DialogDescription, DialogHeader, DialogTitle } from "../components/ui/dialog";
import {
  AlertDialog,
  AlertDialogAction,
  AlertDialogCancel,
  AlertDialogContent,
  AlertDialogDescription,
  AlertDialogFooter,
  AlertDialogHeader,
  AlertDialogTitle,
} from "../components/ui/alert-dialog";
import { Progress } from "../components/ui/progress";
import { QRCodeSVG } from "qrcode.react";
import { labelsData } from "../constants/appData";
import AddCollaboratorDialog from "../components/AddCollaboratorDialog";
import BatchActions from "../components/BatchActions";
import MemoryDetailsMediaItem from "../components/MemoryDetailsMediaItem";
import { ImageViewer } from "../components/ImageViewer";
import { AddMomentModal } from "../components/AddMomentModal";
import { CameraInterface } from "../components/CameraInterface";
const samanthaAvatar = 'https://images.unsplash.com/photo-1494790108755-2616b612b5bc?w=100&h=100&fit=crop';

interface Collaborator {
  id: string;
  userId?: string;  // The actual user ID needed for API calls
  name: string;
  email: string;
  phone_number?: string; // Phone number for collaborators added by phone
  avatar?: string;
  profileColor?: string; // User's profile color for initials background
  role: 'view' | 'edit' | 'admin';
  status: 'active' | 'pending' | 'invited';
  addedDate: string;
  isNonUser?: boolean; // Flag to identify non-user collaborators
  initials?: string; // Store initials for non-user collaborators
  inviteId?: number; // Invite ID for pending invitations
}

interface MemoryDetailsProps {
  memoryId: string;
  onBack: () => void;
  categories?: Array<{
    name: string;
    count: number;
    isUserCreated?: boolean;
    color?: string;
  }>;
  onRefresh?: () => void;
  onRefreshMedia?: () => void;
  shouldOpenAddMoments?: boolean;
  setShouldOpenAddMoments?: (value: boolean) => void;
  shouldOpenEdit?: boolean;
  setShouldOpenEdit?: (value: boolean) => void;
  shouldOpenAIResults?: boolean;
  setShouldOpenAIResults?: (value: boolean) => void;
  shouldOpenComments?: boolean;
  setShouldOpenComments?: (value: boolean) => void;
  commentId?: string;
  shouldOpenImageModal?: boolean;
  setShouldOpenImageModal?: (value: boolean) => void;
  imageId?: string;
  shouldOpenModerationTab?: boolean;
  setShouldOpenModerationTab?: (value: boolean) => void;
  shouldOpenCollaboratorsTab?: boolean;
  setShouldOpenCollaboratorsTab?: (value: boolean) => void;
  aiProcessingData?: {
    memoryId: string;
    status: 'processing' | 'completed' | 'failed';
    startTime: number;
    result?: any;
  } | null;
  setAiProcessing?: (value: any) => void;
}

export default function MemoryDetailsPage({ memoryId, onBack, categories = [], onRefresh, onRefreshMedia, shouldOpenAddMoments, setShouldOpenAddMoments, shouldOpenEdit, setShouldOpenEdit, shouldOpenAIResults, setShouldOpenAIResults, shouldOpenComments, setShouldOpenComments, commentId, shouldOpenImageModal, setShouldOpenImageModal, imageId, shouldOpenModerationTab, setShouldOpenModerationTab, shouldOpenCollaboratorsTab, setShouldOpenCollaboratorsTab, aiProcessingData, setAiProcessing }: MemoryDetailsProps) {
  console.log('🔔 MemoryDetailsPage props:', {
    memoryId,
    memoryIdType: typeof memoryId,
    shouldOpenImageModal,
    imageId,
    shouldOpenComments,
    commentId
  });
  console.log('🔔 Is memoryId truthy?', !!memoryId);

  // Auth hook to get current user
  const { user } = useAuth();

  // Memory limit hook
  const { checkLimit } = useMemoryLimit();

  // API data state
  const [apiMemoryData, setApiMemoryData] = useState<any>(null);
  const [isLoadingMemory, setIsLoadingMemory] = useState(false);
  const [apiError, setApiError] = useState<string | null>(null);
  const [refreshTrigger, setRefreshTrigger] = useState(0); // Counter to force refresh
  const [isRefreshingModeration, setIsRefreshingModeration] = useState(false); // Loading state for moderation refresh

  // Pull-to-refresh state
  const [isPulling, setIsPulling] = useState(false);
  const [pullDistance, setPullDistance] = useState(0);
  const [isRefreshing, setIsRefreshing] = useState(false);
  const [touchStartY, setTouchStartY] = useState(0);
  const pullThreshold = 80; // Distance needed to trigger refresh

  // Collaborators API state
  const [apiCollaborators, setApiCollaborators] = useState<Collaborator[]>([]);
  const [isLoadingCollaborators, setIsLoadingCollaborators] = useState(false);
  const [removingCollaboratorId, setRemovingCollaboratorId] = useState<string | null>(null);
  const [resendingInviteId, setResendingInviteId] = useState<number | null>(null);

  // Activity API state
  const [apiActivity, setApiActivity] = useState<any[]>([]);
  const [isLoadingActivity, setIsLoadingActivity] = useState(false);
  
  // UI state
  const [copiedLink, setCopiedLink] = useState(false);
  const [activeTab, setActiveTab] = useState("overview");
  const [timelineFilter, setTimelineFilter] = useState("latest");

  // Check if there's a post_id in the URL for dynamic meta tags
  const urlParams = useMemo(() => new URLSearchParams(window.location.search), []);
  const postIdFromUrl = urlParams.get('post_id');
  const [isEditPopoverOpen, setIsEditPopoverOpen] = useState(false);
  const [updatedPosts, setUpdatedPosts] = useState<{[key: string]: string}>({});
  const [updatedCommentCounts, setUpdatedCommentCounts] = useState<{[key: string]: number}>({});
  const [deletedPosts, setDeletedPosts] = useState<Set<string>>(new Set());
  const [apiLabels, setApiLabels] = useState<any[]>([]);
  const [apiCategories, setApiCategories] = useState<any[]>([]);
  const [localMemoryUpdates, setLocalMemoryUpdates] = useState<any>(null);
  const [isPublishing, setIsPublishing] = useState(false);
  const [publishProgress, setPublishProgress] = useState(0);
  const [isPublishModalOpen, setIsPublishModalOpen] = useState(false);
  const [publishedUrl, setPublishedUrl] = useState("");
  const [copiedPublishLink, setCopiedPublishLink] = useState(false);
  const [isPublishOptionsModalOpen, setIsPublishOptionsModalOpen] = useState(false);
  const [selectedPublishOption, setSelectedPublishOption] = useState<'view-only' | 'public' | 'private' | null>(null);
  const [isHeaderShrunk, setIsHeaderShrunk] = useState(false);
  const [isSharePopoverOpen, setIsSharePopoverOpen] = useState(false);
  const [isQRPopoverOpen, setIsQRPopoverOpen] = useState(false);
  const shareMenuRef = useRef<HTMLDivElement>(null);

  // Image viewer state - MOVED HERE before useEffects that use it
  const [imageViewer, setImageViewer] = useState<{
    isOpen: boolean;
    src: string;
    alt: string;
    title?: string;
    subtitle?: string;
    filename?: string;
    dateTaken?: string;
    location?: string;
    images: Array<{
      src: string;
      alt: string;
      title: string;
      subtitle: string;
      id: string;
    }>;
    currentIndex: number;
    imageId?: string;
    memoryId?: string;
    rotation_angle?: number;
    initialSubImageId?: string;
    parentImageIsFeatured?: boolean;
  }>({
    isOpen: false,
    src: '',
    alt: '',
    title: '',
    subtitle: '',
    filename: '',
    dateTaken: '',
    location: '',
    images: [],
    currentIndex: 0,
    imageId: '',
    memoryId: undefined,
    rotation_angle: 0,
    initialSubImageId: undefined,
    parentImageIsFeatured: false
  });

  const [editData, setEditData] = useState({
    title: "",
    category: "",
    label: "",
    dateRange: "",
    location: ""
  });
  const [isAddCollaboratorOpen, setIsAddCollaboratorOpen] = useState(false);
  const [parentImageIdForSubImage, setParentImageIdForSubImage] = useState<string | undefined>(undefined);

  // Compute actual memory ID directly - always use memoryId prop if available, otherwise fallback to API data
  const actualMemoryId = memoryId || apiMemoryData?.id?.toString();

  // Store in ref for latest value
  const memoryIdRef = useRef(actualMemoryId);
  memoryIdRef.current = actualMemoryId;

  // Debug: Log every render
  console.log('🆔 MemoryDetailsPage render - actualMemoryId:', actualMemoryId, 'memoryId prop:', memoryId, 'ref:', memoryIdRef.current);

  // Generate QR modal state
  const [isGenerateQROpen, setIsGenerateQROpen] = useState(false);
  const [selectedRole, setSelectedRole] = useState<'view' | 'edit' | 'contributor'>('view');
  const [copiedQRLink, setCopiedQRLink] = useState(false);

  // Edit Cover Photo menu and modal state
  const [isCoverPhotoMenuOpen, setIsCoverPhotoMenuOpen] = useState(false);
  const [isMediaLibraryOpen, setIsMediaLibraryOpen] = useState(false);
  const [mediaLibrarySearchTerm, setMediaLibrarySearchTerm] = useState("");
  const [mediaLibraryCategory, setMediaLibraryCategory] = useState("All Categories");
  const [mediaLibrarySelectedItems, setMediaLibrarySelectedItems] = useState<string[]>([]);
  const [allMediaLibraryImages, setAllMediaLibraryImages] = useState<any[]>([]);
  const [isLoadingMediaLibrary, setIsLoadingMediaLibrary] = useState(false);
  const [mediaLibraryCategories, setMediaLibraryCategories] = useState<string[]>([]);
  const [isCoverPhotoSelectionMode, setIsCoverPhotoSelectionMode] = useState(false);
  const [isAddMomentSelectionMode, setIsAddMomentSelectionMode] = useState(false);
  const [selectedMediaLibraryImagesForMoment, setSelectedMediaLibraryImagesForMoment] = useState<any[]>([]);

  // Delete progress state
  const [isDeletingItems, setIsDeletingItems] = useState(false);
  const [deleteProgress, setDeleteProgress] = useState(0);

  // Moderation: Track selected parent for each sub-image
  const [selectedParentIds, setSelectedParentIds] = useState<{[postId: string]: string}>({});

  // Close share menu when clicking outside
  useEffect(() => {
    const handleClickOutside = (event: MouseEvent) => {
      if (shareMenuRef.current && !shareMenuRef.current.contains(event.target as Node)) {
        setIsSharePopoverOpen(false);
      }
    };

    if (isSharePopoverOpen) {
      document.addEventListener("mousedown", handleClickOutside);
    }

    return () => {
      document.removeEventListener("mousedown", handleClickOutside);
    };
  }, [isSharePopoverOpen]);

  // Scroll detection for header shrinking
  useEffect(() => {
    const handleScroll = () => {
      const scrollPosition = window.scrollY;
      
      setIsHeaderShrunk(scrollPosition > 10);
    };

    window.addEventListener('scroll', handleScroll);

    return () => {
      window.removeEventListener('scroll', handleScroll);
    };
  }, []);

  // Fetch all media library images when modal opens
  useEffect(() => {
    if (isMediaLibraryOpen && allMediaLibraryImages.length === 0) {
      fetchAllMediaLibraryImages();
    }
  }, [isMediaLibraryOpen]);

  const fetchAllMediaLibraryImages = async () => {
    setIsLoadingMediaLibrary(true);
    try {
      const response = await mediaAPI.getMemoryImages();
      if (response?.success && response.data) {
        // Transform the API response to flat array of images
        const allImages: any[] = [];
        const categoriesSet = new Set<string>();

        // Extract from categories_media
        if (response.data.categories_media) {
          Object.keys(response.data.categories_media).forEach(categoryName => {
            categoriesSet.add(categoryName);
            const categoryItems = response.data.categories_media![categoryName];
            if (Array.isArray(categoryItems)) {
              categoryItems.forEach((item: any) => {
                if (item.media_id && item.media_url) {
                  allImages.push({
                    id: item.media_id.toString(),
                    image: item.media_url,
                    title: item.name || `IMG_${item.media_id}`,
                    category: categoryName,
                    date: item.capture_date || item.created_at,
                    location: item.location,
                    content: item.description || ''
                  });
                }
              });
            }
          });
        }

        // Extract from unassigned_media
        if (response.data.unassigned_media && Array.isArray(response.data.unassigned_media)) {
          categoriesSet.add('Unassigned');
          response.data.unassigned_media.forEach((item: any) => {
            if (item.media_id && item.media_url) {
              allImages.push({
                id: item.media_id.toString(),
                image: item.media_url,
                title: item.name || `IMG_${item.media_id}`,
                category: 'Unassigned',
                date: item.capture_date || item.created_at,
                location: item.location,
                content: item.description || ''
              });
            }
          });
        }

        setAllMediaLibraryImages(allImages);
        setMediaLibraryCategories(Array.from(categoriesSet).sort());
        console.log('Fetched all media library images:', allImages.length);
      }
    } catch (error) {
      console.error('Error fetching media library images:', error);
    } finally {
      setIsLoadingMediaLibrary(false);
    }
  };

  // Check if current user is a collaborator and get their role
  const currentUserRole = useMemo(() => {
    if (!user || !apiMemoryData) {
      console.log('❌ currentUserRole: No user or apiMemoryData', { hasUser: !!user, hasApiMemoryData: !!apiMemoryData });
      return null;
    }

    // Get the actual user ID - use external_user_id if available, otherwise use id
    const currentUserId = (user as any).external_user_id?.toString() || user.id?.toString();

    console.log('🔍 Checking currentUserRole for user:', {
      adminId: user.id,
      externalUserId: (user as any).external_user_id,
      actualUserId: currentUserId,
      email: user.email
    });
    console.log('🔍 Memory data:', {
      memoryId: apiMemoryData.id,
      ownerId: apiMemoryData.user_id,
      hasCollaborators: !!apiMemoryData.collaborator,
      collaboratorsCount: apiMemoryData.collaborator?.length
    });

    // Check if user is the memory owner
    const memoryOwnerId = apiMemoryData.user_id?.toString() || apiMemoryData.user?.id?.toString();
    if (memoryOwnerId === currentUserId) {
      console.log('✅ User is memory owner');
      return 'owner';
    }

    // Check if memory has collaborators array
    if (!apiMemoryData.collaborator || !Array.isArray(apiMemoryData.collaborator)) {
      console.log('❌ No collaborators array found');
      return null;
    }

    console.log('🔍 Searching in collaborators:', apiMemoryData.collaborator.map((c: any) => ({
      userId: c.user_id,
      status: c.status,
      role: c.role,
      email: c.user?.email
    })));

    // Check if user is in collaborators list with status = 1 (accepted)
    const collaborator = apiMemoryData.collaborator.find(
      (collab: any) => {
        const match = collab.user_id?.toString() === currentUserId && collab.status === 1;
        console.log(`🔍 Checking collaborator ${collab.user_id} vs user ${currentUserId}: ${match}`, {
          collabUserId: collab.user_id,
          collabStatus: collab.status,
          currentUserId: currentUserId,
          match
        });
        return match;
      }
    );

    if (collaborator) {
      const role = collaborator.role || collaborator.access_role || 'view';
      console.log('✅ User is collaborator with role:', role);
      return role; // 'admin', 'edit', 'contributor', 'view', or 'viewer'
    }

    console.log('❌ User is not a collaborator');
    return null;
  }, [user, apiMemoryData]);

  // Log currentUserRole whenever it changes
  useEffect(() => {
    console.log('📊 Current User Role:', currentUserRole);
  }, [currentUserRole]);

  // Filter media library images based on search and category
  const filteredMediaLibraryImages = useMemo(() => {
    let filtered = allMediaLibraryImages;

    // Filter by category
    if (mediaLibraryCategory !== "All Categories") {
      filtered = filtered.filter(img => img.category === mediaLibraryCategory);
    }

    // Filter by search term
    if (mediaLibrarySearchTerm.trim()) {
      const searchLower = mediaLibrarySearchTerm.toLowerCase().trim();
      filtered = filtered.filter(img =>
        img.title?.toLowerCase().includes(searchLower) ||
        img.content?.toLowerCase().includes(searchLower) ||
        img.location?.toLowerCase().includes(searchLower) ||
        img.category?.toLowerCase().includes(searchLower)
      );
    }

    return filtered;
  }, [allMediaLibraryImages, mediaLibraryCategory, mediaLibrarySearchTerm]);

  const [generatedShareLink, setGeneratedShareLink] = useState<string>('');
  const [isGeneratingLink, setIsGeneratingLink] = useState(false);

  // Memory deletion state
  const [showDeleteDialog, setShowDeleteDialog] = useState(false);
  const [isDeleting, setIsDeleting] = useState(false);
  
  // Media item deletion state
  const [showDeleteItemDialog, setShowDeleteItemDialog] = useState(false);
  const [isDeletingItem, setIsDeletingItem] = useState(false);
  const [itemToDelete, setItemToDelete] = useState<string | null>(null);
  
  // Memory update loading state
  const [isUpdatingMemory, setIsUpdatingMemory] = useState(false);
  
  // Add Moment modal state
  const [isAddMomentModalOpen, setIsAddMomentModalOpen] = useState(false);
  const addMomentButtonRef = useRef<HTMLButtonElement>(null);

  // Camera input ref for mobile
  const cameraInputRef = useRef<HTMLInputElement>(null);
  const mediaLibraryInputRef = useRef<HTMLInputElement>(null);
  const [showCameraOptions, setShowCameraOptions] = useState(false);
  const [showCameraInterface, setShowCameraInterface] = useState(false);
  const [capturedFiles, setCapturedFiles] = useState<FileList | null>(null);

  // AI Memory Wizard Modal State
  const [isAIWizardModalOpen, setIsAIWizardModalOpen] = useState(false);
  const [aiWizardAnimatingOut, setAiWizardAnimatingOut] = useState(false);
  const [aiWizardProgress, setAiWizardProgress] = useState(0);
  const [isAIResultsModalOpen, setIsAIResultsModalOpen] = useState(false);
  const [aiActiveTab, setAiActiveTab] = useState<'suggestions' | 'prompt'>('suggestions');
  const [aiAnalysisData, setAiAnalysisData] = useState<any>(null);
  const [selectedAnalysisOption, setSelectedAnalysisOption] = useState<number | null>(null);
  const [customPrompt, setCustomPrompt] = useState('');
  const [isGeneratingFromPrompt, setIsGeneratingFromPrompt] = useState(false);
  const [aiResponseData, setAiResponseData] = useState<any>(null);
  const [isApplyingTask, setIsApplyingTask] = useState(false);

  // Auto-animate AI Wizard modal to bottom-left after 2 seconds, then close
  useEffect(() => {
    if (isAIWizardModalOpen && !aiWizardAnimatingOut) {
      // After 2 seconds, start the slide-out animation
      const animateTimer = setTimeout(() => {
        setAiWizardAnimatingOut(true);
      }, 2000);

      return () => clearTimeout(animateTimer);
    }
  }, [isAIWizardModalOpen, aiWizardAnimatingOut]);

  // Close modal after animation completes
  useEffect(() => {
    if (aiWizardAnimatingOut) {
      const closeTimer = setTimeout(() => {
        setIsAIWizardModalOpen(false);
        setAiWizardAnimatingOut(false);
      }, 700); // Animation duration

      return () => clearTimeout(closeTimer);
    }
  }, [aiWizardAnimatingOut]);

  // Open Add Moments modal if shouldOpenAddMoments is true
  useEffect(() => {
    if (shouldOpenAddMoments) {
      setIsAddMomentModalOpen(true);
      // Reset the flag after opening
      if (setShouldOpenAddMoments) {
        setShouldOpenAddMoments(false);
      }
    }
  }, [shouldOpenAddMoments, setShouldOpenAddMoments]);

  // Open Edit modal if shouldOpenEdit is true
  useEffect(() => {
    if (shouldOpenEdit) {
      // Need to fetch categories and labels first, then open edit modal
      const openEditModal = async () => {
        await fetchCategoriesAndLabels();
        setIsEditPopoverOpen(true);
      };
      openEditModal();

      // Reset the flag after opening
      if (setShouldOpenEdit) {
        setShouldOpenEdit(false);
      }
    }
  }, [shouldOpenEdit, setShouldOpenEdit]);

  // Open AI Results modal if shouldOpenAIResults is true
  useEffect(() => {
    if (shouldOpenAIResults && aiProcessingData?.result) {
      console.log('🎯 Auto-opening AI Results modal with data:', aiProcessingData.result);

      // Set the AI analysis data
      setAiAnalysisData(aiProcessingData.result);

      // Open the results modal
      setIsAIResultsModalOpen(true);

      // Reset the flags
      if (setShouldOpenAIResults) {
        setShouldOpenAIResults(false);
      }

      // Clear the processing state after opening modal
      if (setAiProcessing) {
        setTimeout(() => {
          setAiProcessing(null);
        }, 500); // Small delay to ensure modal opens first
      }
    }
  }, [shouldOpenAIResults, aiProcessingData, setShouldOpenAIResults, setAiProcessing]);

  // Open Comments tab if shouldOpenComments is true
  useEffect(() => {
    if (shouldOpenComments) {
      console.log('🔔 Auto-opening comments tab');
      setActiveTab('overview'); // Switch to overview tab where comments are

      // Reset the flag after opening
      if (setShouldOpenComments) {
        setShouldOpenComments(false);
      }

      // TODO: If commentId is provided, scroll to that specific comment
      if (commentId) {
        console.log('🔔 Should scroll to comment:', commentId);
        // Implement comment scrolling logic here if needed
      }
    }
  }, [shouldOpenComments, setShouldOpenComments, commentId]);

  // Open Moderation tab if shouldOpenModerationTab is true
  useEffect(() => {
    if (shouldOpenModerationTab) {
      console.log('🔔 Auto-opening Moderation tab for moment notification');
      setActiveTab('moderation'); // Switch to moderation tab

      // Reset the flag after opening
      if (setShouldOpenModerationTab) {
        setShouldOpenModerationTab(false);
      }
    }
  }, [shouldOpenModerationTab, setShouldOpenModerationTab]);

  // Open Collaborators tab if shouldOpenCollaboratorsTab is true
  useEffect(() => {
    if (shouldOpenCollaboratorsTab) {
      console.log('🔔 Auto-opening Collaborators tab for full access request notification');
      setActiveTab('collaborators'); // Switch to collaborators tab

      // Reset the flag after opening
      if (setShouldOpenCollaboratorsTab) {
        setShouldOpenCollaboratorsTab(false);
      }
    }
  }, [shouldOpenCollaboratorsTab, setShouldOpenCollaboratorsTab]);

  // Open Image Modal if shouldOpenImageModal is true
  useEffect(() => {
    console.log('🔔 Image Modal useEffect triggered:', {
      shouldOpenImageModal,
      imageId,
      hasApiMemoryData: !!apiMemoryData,
      imagesCount: apiMemoryData?.images?.length || 0
    });

    if (shouldOpenImageModal && imageId) {
      if (!apiMemoryData) {
        console.log('🔔 Waiting for apiMemoryData to load...');
        return; // Wait for next render when apiMemoryData is loaded
      }

      console.log('🔔 Auto-opening image modal for imageId:', imageId);
      console.log('🔔 API Memory Data structure:', {
        hasImages: !!apiMemoryData.images,
        hasPosts: !!apiMemoryData.posts,
        imagesCount: apiMemoryData.images?.length || 0,
        postsCount: apiMemoryData.posts?.length || 0
      });

      // The imageId corresponds to a post ID, not an image ID
      // Find the image in the posts array
      const allImages = apiMemoryData.posts || apiMemoryData.images || [];
      console.log('🔔 Searching in posts array:', allImages.map((img: any) => ({ id: img.id, type: typeof img.id })));

      const imageIndex = allImages.findIndex((img: any) => img.id.toString() === imageId.toString());

      console.log('🔔 Image search result:', {
        searchingFor: imageId,
        searchingForType: typeof imageId,
        imageIndex,
        totalImages: allImages.length,
        foundPost: imageIndex !== -1 ? allImages[imageIndex] : null
      });

      if (imageIndex !== -1) {
        console.log('🔔 Found image at index:', imageIndex);
        console.log('🔔 Opening image viewer with:', {
          isOpen: true,
          imagesCount: allImages.length,
          currentIndex: imageIndex
        });

        // Small delay to ensure the page is fully rendered
        setTimeout(() => {
          console.log('🔔 Actually setting imageViewer state now');

          const currentPost = allImages[imageIndex];
          console.log('🔔 Current post data:', currentPost);

          // Map posts to image viewer format
          // Use image_link from raw API data (posts are not yet transformed here)
          const mappedImages = allImages.map((post: any) => ({
            src: post.image_link || post.image_url || post.image || post.thumbnail || '',
            alt: post.description || post.title || post.name || 'Image',
            title: post.description || post.title || post.name || 'Image',
            subtitle: `${post.user?.name || post.author?.name || 'Unknown'} • ${post.created_at ? new Date(post.created_at).toLocaleDateString() : ''}`,
            id: post.id?.toString() || ''
          }));

          console.log('🔔 Mapped images for viewer:', mappedImages);

          setImageViewer({
            isOpen: true,
            src: currentPost.image_link || currentPost.image_url || currentPost.image || currentPost.thumbnail || '',
            alt: currentPost.description || currentPost.title || currentPost.name || 'Image',
            title: currentPost.description || currentPost.title || currentPost.name || 'Image',
            subtitle: `${currentPost.user?.name || currentPost.author?.name || 'Unknown'} • ${currentPost.created_at ? new Date(currentPost.created_at).toLocaleDateString() : ''}`,
            filename: currentPost.name || 'image.jpg',
            dateTaken: currentPost.created_at ? new Date(currentPost.created_at).toLocaleDateString() : '',
            location: currentPost.location || '',
            images: mappedImages,
            currentIndex: imageIndex,
            imageId: currentPost.id?.toString() || '',
            memoryId: memoryId,
            rotation_angle: currentPost.rotation_angle || 0
          });

          // Reset the flag after opening
          if (setShouldOpenImageModal) {
            console.log('🔔 Resetting shouldOpenImageModal flag');
            setShouldOpenImageModal(false);
          }
        }, 100);
      } else {
        console.log('🔔 Image not found in memory data, trying to open first image');
        // If image not found, just open the first image (fallback)
        if (allImages.length > 0) {
          console.log('🔔 Opening first image as fallback');
          setTimeout(() => {
            const firstPost = allImages[0];

            // Map posts to image viewer format
            // Use image_link from raw API data (posts are not yet transformed here)
            const mappedImages = allImages.map((post: any) => ({
              src: post.image_link || post.image_url || post.image || post.thumbnail || '',
              alt: post.description || post.title || post.name || 'Image',
              title: post.description || post.title || post.name || 'Image',
              subtitle: `${post.user?.name || post.author?.name || 'Unknown'} • ${post.created_at ? new Date(post.created_at).toLocaleDateString() : ''}`,
              id: post.id?.toString() || ''
            }));

            setImageViewer({
              isOpen: true,
              src: firstPost.image_link || firstPost.image_url || firstPost.image || firstPost.thumbnail || '',
              alt: firstPost.description || firstPost.title || firstPost.name || 'Image',
              title: firstPost.description || firstPost.title || firstPost.name || 'Image',
              subtitle: `${firstPost.user?.name || firstPost.author?.name || 'Unknown'} • ${firstPost.created_at ? new Date(firstPost.created_at).toLocaleDateString() : ''}`,
              filename: firstPost.name || 'image.jpg',
              dateTaken: firstPost.created_at ? new Date(firstPost.created_at).toLocaleDateString() : '',
              location: firstPost.location || '',
              images: mappedImages,
              currentIndex: 0,
              imageId: firstPost.id?.toString() || '',
              memoryId: memoryId,
              rotation_angle: firstPost.rotation_angle || 0
            });

            if (setShouldOpenImageModal) {
              setShouldOpenImageModal(false);
            }
          }, 100);
        } else {
          console.log('🔔 No images available to open');
          if (setShouldOpenImageModal) {
            setShouldOpenImageModal(false);
          }
        }
      }
    } else {
      if (!shouldOpenImageModal) console.log('🔔 shouldOpenImageModal is false');
      if (!imageId) console.log('🔔 imageId is missing');
    }
  }, [shouldOpenImageModal, imageId, apiMemoryData, setShouldOpenImageModal]);

  // Media section state
  const [mediaSortBy, setMediaSortBy] = useState("date");
  const [mediaSortOrder, setMediaSortOrder] = useState<'asc' | 'desc'>('desc');
  const [selectedItems, setSelectedItems] = useState<string[]>([]);
  
  // Use API collaborators only (no fallback dummy data)
  const collaborators = apiCollaborators;

  // Fetch categories and labels for edit form
  const fetchCategoriesAndLabels = async () => {
    try {
      const response = await dashboardAPI.getCategoriesLabels();
      if (response.success && response.data?.data) {
        // Set categories with IDs
        if (response.data.data.categories?.items) {
          setApiCategories(response.data.data.categories.items);
          console.log('Fetched categories with IDs:', response.data.data.categories.items);
        }
        // Set labels with IDs  
        if (response.data.data.labels?.items) {
          setApiLabels(response.data.data.labels.items);
          console.log('Fetched labels with IDs:', response.data.data.labels.items);
        }
      }
    } catch (error) {
      console.error('Error fetching categories and labels:', error);
    }
  };

  // Utility function to generate initials from email
  const generateInitialsFromEmail = (email: string): string => {
    if (!email) return 'U';
    const parts = email.split('@')[0].split('.');
    if (parts.length >= 2) {
      return (parts[0].charAt(0) + parts[1].charAt(0)).toUpperCase();
    }
    return email.slice(0, 2).toUpperCase();
  };

  // Utility function to generate initials from name (first 2 characters)
  const generateInitialsFromName = (name: string): string => {
    if (!name) return 'U';
    const words = name.trim().split(/\s+/);
    if (words.length >= 2) {
      // Take first letter of first two words
      return (words[0].charAt(0) + words[1].charAt(0)).toUpperCase();
    }
    // If only one word, take first 2 characters
    return name.slice(0, 2).toUpperCase();
  };

  // Utility function to format profile color for CSS
  const formatProfileColor = (profileColor?: string): string => {
    if (!profileColor) return '';
    // If it's already a valid hex color, add # prefix if missing
    if (profileColor.match(/^[0-9a-fA-F]{6}$/)) {
      return `#${profileColor}`;
    }
    // If it already has # prefix, return as is
    if (profileColor.startsWith('#')) {
      return profileColor;
    }
    // Default fallback
    return '';
  };

  // Function to extract and transform collaborators from memory detail API response
  const extractCollaboratorsFromMemoryData = (memoryData: any) => {
    console.log('=== EXTRACTING COLLABORATORS FROM MEMORY DATA ===');
    console.log('Memory Data:', memoryData);

    // The collaborators are in memory.collaborator (singular!)
    const collaboratorsData = memoryData?.collaborator || [];
    // Also get non-user collaborators
    const nonUserCollaboratorsData = memoryData?.non_user_collaborators || [];
    // Get invites data
    const invitesData = memoryData?.invites || [];

    console.log('Found collaborators data:', collaboratorsData);
    console.log('Found non-user collaborators data:', nonUserCollaboratorsData);
    console.log('Found invites data:', invitesData);
    console.log('Invites details:', invitesData.map((inv: any) => ({
      id: inv.id,
      email: inv.email,
      phone_number: inv.phone_number,
      user_id: inv.user_id,
      accept_reject: inv.accept_reject,
      memory_id: inv.memory_id
    })));
    console.log('Current memoryId:', memoryId);
    
    let allTransformedCollaborators: Collaborator[] = [];
    
    // Process regular user collaborators
    if (Array.isArray(collaboratorsData) && collaboratorsData.length > 0) {
      const transformedCollaborators: Collaborator[] = collaboratorsData.map((collab: any) => {
        console.log('Processing collaborator:', collab);
        console.log('Collaborator structure:', {
          id: collab.id,
          user_id: collab.user_id,
          user: collab.user,
          user_id_from_user: collab.user?.id,
          name: collab.name,
          email: collab.email,
          role: collab.role,
          status: collab.status
        });

        // Map status: 0 = pending, 1 = active
        const status = collab.status === 1 ? 'active' :
                      collab.status === 0 ? 'pending' :
                      'pending'; // Default to pending if unknown

        // Extract user data from nested user object
        const userData = collab.user || {};

        // Find matching invite for this collaborator
        // Try multiple matching strategies:
        // 1. Match by user_id with pending status (accept_reject = "0" or 0 or null)
        // 2. Match by email if user_id match fails
        const matchingInvite = invitesData.find((inv: any) => {
          // Strategy 1: Match by user_id
          if (inv.user_id && collab.user_id && inv.user_id === collab.user_id) {
            // Check if pending or not yet accepted
            if (inv.accept_reject === "0" || inv.accept_reject === 0 || inv.accept_reject === null) {
              return true;
            }
          }
          // Strategy 2: Match by email if user has email
          if (inv.email && userData.email && inv.email.toLowerCase() === userData.email.toLowerCase()) {
            // Check if pending
            if (inv.accept_reject === "0" || inv.accept_reject === 0 || inv.accept_reject === null) {
              return true;
            }
          }
          return false;
        });

        console.log('🔍 Looking for invite for user collaborator:', {
          user_id: collab.user_id,
          user_email: userData.email,
          allInvitesForUser: invitesData.filter((inv: any) => inv.user_id === collab.user_id),
          allInvitesForEmail: invitesData.filter((inv: any) => inv.email && userData.email && inv.email.toLowerCase() === userData.email.toLowerCase()),
          foundInvite: matchingInvite,
          inviteId: matchingInvite?.id,
          status: status
        });

        const transformedCollab = {
          id: collab.id?.toString() || collab.user_id?.toString() || `collab_${Date.now()}`,
          userId: collab.user_id?.toString() || userData.id?.toString() || collab.id?.toString(),
          name: userData.name || collab.name || 'Unknown User',
          email: userData.email || collab.email || '',
          phone_number: userData.phone_number || collab.phone_number,
          avatar: userData.profile_image || collab.profile_image,
          profileColor: userData.profile_color || collab.profile_color,
          role: collab.role || collab.access_role || 'view',
          status: status as 'active' | 'pending' | 'invited',
          addedDate: collab.created_at || collab.added_date || new Date().toISOString(),
          inviteId: matchingInvite?.id, // Add invite ID if exists
          linkedin_url: userData.linkedin_url || collab.linkedin_url || null,
          facebook_url: userData.facebook_url || collab.facebook_url || null
        };

        console.log('Transformed collaborator:', transformedCollab);
        return transformedCollab;
      });

      allTransformedCollaborators = [...transformedCollaborators];
    }
    
    // Process non-user collaborators
    if (Array.isArray(nonUserCollaboratorsData) && nonUserCollaboratorsData.length > 0) {
      const transformedNonUserCollaborators: Collaborator[] = nonUserCollaboratorsData.map((nonUserCollab: any) => {
        console.log('Processing non-user collaborator:', nonUserCollab);

        // For non-user collaborators, we can have email or phone and role
        // We need to generate initials from email or phone for the avatar
        const contactInfo = nonUserCollab.email || nonUserCollab.phone_number || '';
        const emailInitials = nonUserCollab.email ? generateInitialsFromEmail(nonUserCollab.email) : (nonUserCollab.phone_number ? nonUserCollab.phone_number.slice(-2) : 'U');

        // Find matching invite for this non-user collaborator
        // Match by email or phone, with pending status
        const matchingInvite = invitesData.find((inv: any) => {
          // Check if pending or null
          const isPending = inv.accept_reject === "0" || inv.accept_reject === 0 || inv.accept_reject === null;
          if (!isPending) return false;

          // Match by email (case insensitive)
          if (nonUserCollab.email && inv.email) {
            if (inv.email.toLowerCase() === nonUserCollab.email.toLowerCase()) {
              // Can have user_id null OR undefined
              return inv.user_id === null || inv.user_id === undefined;
            }
          }

          // Match by phone (exact match)
          if (nonUserCollab.phone_number && inv.phone_number) {
            if (inv.phone_number === nonUserCollab.phone_number) {
              // Can have user_id null OR undefined
              return inv.user_id === null || inv.user_id === undefined;
            }
          }

          return false;
        });

        console.log('🔍 Looking for invite for non-user collaborator:', {
          email: nonUserCollab.email,
          phone: nonUserCollab.phone_number,
          allInvitesForEmail: invitesData.filter((inv: any) => inv.email && nonUserCollab.email && inv.email.toLowerCase() === nonUserCollab.email.toLowerCase()),
          allInvitesForPhone: invitesData.filter((inv: any) => inv.phone_number === nonUserCollab.phone_number),
          foundInvite: matchingInvite,
          inviteId: matchingInvite?.id
        });

        const transformedNonUserCollab = {
          id: `non_user_${nonUserCollab.id}` || `non_user_collab_${Date.now()}`,
          userId: null, // No user ID for non-user collaborators
          name: nonUserCollab.email ? nonUserCollab.email.split('@')[0] : nonUserCollab.phone_number || 'Unknown', // Use email username or phone as name
          email: nonUserCollab.email || '',
          phone_number: nonUserCollab.phone_number,
          avatar: null, // No avatar, will use initials fallback
          role: nonUserCollab.role || 'view',
          status: 'pending' as 'active' | 'pending' | 'invited', // Non-user collaborators are typically pending
          addedDate: nonUserCollab.created_at || new Date().toISOString(),
          isNonUser: true, // Flag to identify non-user collaborators
          initials: emailInitials, // Store initials for display
          inviteId: matchingInvite?.id // Add invite ID if exists
        };

        console.log('✅ Transformed non-user collaborator:', transformedNonUserCollab);
        return transformedNonUserCollab;
      });

      allTransformedCollaborators = [...allTransformedCollaborators, ...transformedNonUserCollaborators];
    }
    
    if (allTransformedCollaborators.length > 0) {
      setApiCollaborators(allTransformedCollaborators);
      console.log('=== ALL COLLABORATORS SUCCESSFULLY EXTRACTED ===');
      console.log('All Transformed Collaborators:', allTransformedCollaborators);
    } else {
      console.log('No collaborators found in memory data');
      setApiCollaborators([]);
    }
    
    setIsLoadingCollaborators(false);
  };

  // Function to fetch memory activity from API
  const fetchMemoryActivity = async (skipLoadingState = false) => {
    if (!memoryId) return;

    if (!skipLoadingState) {
      setIsLoadingActivity(true);
    }

    try {
      console.log(`=== MEMORY ACTIVITY API CALL ===`);
      console.log(`Fetching memory activity for ID: ${memoryId}`);
      console.log(`API URL: /memories/${memoryId}/activity`);

      const response = await dashboardAPI.getMemoryActivity(memoryId);
      console.log('=== DETAILED ACTIVITY RESPONSE ANALYSIS ===');
      console.log('Full Raw Response:', response);
      console.log('Response Type:', typeof response);
      console.log('Response Keys:', Object.keys(response || {}));
      console.log('Response.data:', response?.data);
      console.log('=== END DETAILED ACTIVITY RESPONSE ANALYSIS ===');

      if (response.success && response.data) {
        // Extract the activities from the nested structure - handle multiple possible structures
        const activityData = response.data.data?.activities || response.data.activities || [];
        console.log('✅ UPDATING ACTIVITY DATA:', {
          activityCount: activityData.length,
          skipLoadingState,
          isPullToRefresh: skipLoadingState
        });
        setApiActivity(activityData);

        console.log('=== MEMORY ACTIVITY API RESPONSE ===');
        console.log('Full API Response:', JSON.stringify(response, null, 2));
        console.log('Response.data.data:', response.data.data);
        console.log('Response.data.data.activities:', response.data.data?.activities);
        console.log('Final Activity Data:', JSON.stringify(activityData, null, 2));
        console.log('Activity Count:', activityData.length);
        console.log('=== END MEMORY ACTIVITY API RESPONSE ===');
      } else {
        console.error('Failed to fetch memory activity:', response.error);
        setApiActivity([]);
      }
    } catch (error) {
      console.error('Error fetching memory activity:', error);
      setApiActivity([]);
    } finally {
      if (!skipLoadingState) {
        setIsLoadingActivity(false);
      }
      console.log(`=== END MEMORY ACTIVITY API CALL ===`);
    }
  };

  // Function to fetch memory details from API
  const fetchMemoryDetails = async (skipLoadingState = false) => {
    if (!memoryId) return;

      if (!skipLoadingState) {
        setIsLoadingMemory(true);
      }
      setApiError(null);

      try {
        console.log(`=== MEMORY DETAILS API CALL ===`);
        console.log(`Fetching memory details for ID: ${memoryId}`);
        console.log(`API URL: /memories/${memoryId}`);

        const response = await dashboardAPI.getMemoryDetails(memoryId);
        console.log('=== DETAILED MEMORY RESPONSE ANALYSIS ===');
        console.log('Full Raw Response:', response);
        console.log('Response Type:', typeof response);
        console.log('Response Keys:', Object.keys(response || {}));
        console.log('Response.data:', response?.data);
        console.log('Response.data Type:', typeof response?.data);
        console.log('Response.data Keys:', Object.keys(response?.data || {}));
        console.log('=== END DETAILED MEMORY RESPONSE ANALYSIS ===');

        if (response.success && response.data) {
          // Extract the correct memory data from the nested structure
          const memoryData = response.data.data?.memory || response.data.memory || response.data.data || response.data;
          console.log('✅ UPDATING MEMORY DATA:', {
            title: memoryData?.title,
            lastUpdateImg: memoryData?.last_update_img,
            skipLoadingState,
            isPullToRefresh: skipLoadingState
          });
          setApiMemoryData(memoryData);

          // Try to find the actual user_id field
          const finalMemoryOwnerId = memoryData.user_id?.toString()
            || memoryData.user?.id?.toString()
            || memoryData.owner_id?.toString()
            || memoryData.created_by?.toString();

          // Extract collaborators from the memory data (collaborator field is in memory object)
          extractCollaboratorsFromMemoryData(memoryData);

          // Initialize edit data with API data
          if (memoryData) {
            setEditData({
              title: memoryData.title || "",
              category: memoryData.category?.name || "",
              label: memoryData.sub_category?.name || "",
              dateRange: memoryData.dates?.formatted_range || "",
              location: memoryData.location || ""
            });
          }
        } else {
          setApiError(response.error || 'Failed to fetch memory details');
        }
      } catch (error) {
        console.error('Error fetching memory details:', error);
        setApiError('Network error while fetching memory details');
      } finally {
        if (!skipLoadingState) {
          setIsLoadingMemory(false);
        }
        console.log(`=== END MEMORY DETAILS API CALL ===`);
      }
    };

  // Fetch memory details and activity on component mount and memoryId change
  // Collaborators are now extracted from the memory detail response
  useEffect(() => {
    fetchMemoryDetails();
    fetchMemoryActivity();
  }, [memoryId]);

  // Generate share link when modal opens or role changes
  useEffect(() => {
    if (isGenerateQROpen && memoryId) {
      generateShareLink(selectedRole);
    }
  }, [isGenerateQROpen, selectedRole, memoryId]);

  // Pull-to-refresh handlers
  const handleTouchStart = (e: React.TouchEvent) => {
    if (isRefreshing) return;

    const scrollTop = (e.currentTarget as HTMLElement).scrollTop;
    if (scrollTop === 0) {
      setTouchStartY(e.touches[0].clientY);
    }
  };

  const handleTouchMove = (e: React.TouchEvent) => {
    if (isRefreshing || touchStartY === 0) return;

    const scrollTop = (e.currentTarget as HTMLElement).scrollTop;
    if (scrollTop > 0) {
      setIsPulling(false);
      setPullDistance(0);
      setTouchStartY(0);
      return;
    }

    const currentY = e.touches[0].clientY;
    const distance = currentY - touchStartY;

    if (distance > 0) {
      setIsPulling(true);
      setPullDistance(Math.min(distance, pullThreshold * 1.5));
    }
  };

  const handleTouchEnd = async () => {
    if (isRefreshing) return;

    setTouchStartY(0);

    if (pullDistance >= pullThreshold) {
      console.log('🔄 PULL-TO-REFRESH: Starting refresh...');
      setIsRefreshing(true);
      setIsPulling(false);

      try {
        await Promise.all([
          fetchMemoryDetails(true), // Skip loading state for pull-to-refresh
          fetchMemoryActivity(true) // Skip loading state for pull-to-refresh
        ]);
        console.log('✅ PULL-TO-REFRESH: Data refreshed successfully');
        // toast.success("Moment added! It will appear on the timeline after admin review.");
      } catch (error) {
        console.error('❌ PULL-TO-REFRESH: Error refreshing memory:', error);
      } finally {
        setTimeout(() => {
          setIsRefreshing(false);
          setPullDistance(0);
          console.log('🏁 PULL-TO-REFRESH: Complete');
        }, 500);
      }
    } else {
      setIsPulling(false);
      setPullDistance(0);
    }
  };

  // Handle camera button click - directly open camera interface
  const handleCameraClick = () => {
    setShowCameraInterface(true);
  };

  // Handle take photo option
  const handleTakePhoto = () => {
    setShowCameraOptions(false);
    setShowCameraInterface(true);
  };

  // Handle choose from library option
  const handleChooseFromLibrary = () => {
    setShowCameraOptions(false);
    if (mediaLibraryInputRef.current) {
      mediaLibraryInputRef.current.click();
    }
  };

  // Handle camera interface capture
  const handleCameraInterfaceCapture = (files: File[]) => {
    if (files && files.length > 0) {
      // Convert files array to FileList-like object
      const dataTransfer = new DataTransfer();
      files.forEach(file => dataTransfer.items.add(file));
      const fileList = dataTransfer.files;

      // Store captured files and open Add Moment modal
      setCapturedFiles(fileList);
      setShowCameraInterface(false);
      setIsAddMomentModalOpen(true);
      console.log('📷 Camera captured:', files[0].name);
    }
  };

  // Handle camera capture
  const handleCameraCapture = (event: React.ChangeEvent<HTMLInputElement>) => {
    const files = event.target.files;
    if (files && files.length > 0) {
      // Store captured files and open Add Moment modal
      setCapturedFiles(files);
      setIsAddMomentModalOpen(true);
      console.log('📷 Camera captured:', files[0].name);
    }

    // Reset input value to allow capturing the same file again
    if (event.target) {
      event.target.value = '';
    }
  };

  // Handle media library selection
  const handleMediaLibrarySelection = (event: React.ChangeEvent<HTMLInputElement>) => {
    const files = event.target.files;
    if (files && files.length > 0) {
      // Store selected files and open Add Moment modal
      setCapturedFiles(files);
      setIsAddMomentModalOpen(true);
      console.log('📁 Media library selected:', files[0].name);
    }

    // Reset input value to allow selecting the same file again
    if (event.target) {
      event.target.value = '';
    }
  };

  // Fallback to mock data if API data is not available
  const fallbackMemory = getMemoryDetails(memoryId);
  const memory = apiMemoryData || fallbackMemory;

  // Show loading state
  if (isLoadingMemory) {
    return (
      <div className="w-full space-y-8">
        <div className="flex items-center gap-4">
          <Button variant="ghost" size="sm" onClick={onBack}>
            <ArrowLeft className="w-4 h-4 mr-2" />
            Back
          </Button>
        </div>
        <div className="text-center py-12">
          <div className="w-8 h-8 border-2 border-[#6C60FF] border-t-transparent rounded-full animate-spin mx-auto mb-4"></div>
          <h2 className="text-xl font-semibold text-gray-900 mb-2">Loading memory...</h2>
          <p className="text-gray-600">Fetching memory details from server.</p>
        </div>
      </div>
    );
  }

  // Show error state
  if (apiError) {
    return (
      <div className="w-full space-y-8">
        <div className="flex items-center gap-4">
          <Button variant="ghost" size="sm" onClick={onBack}>
            <ArrowLeft className="w-4 h-4 mr-2" />
            Back
          </Button>
        </div>
        <div className="text-center py-12">
          <h2 className="text-xl font-semibold text-gray-900 mb-2">Error loading memory</h2>
          <p className="text-gray-600 mb-4">{apiError}</p>
          <Button onClick={() => window.location.reload()} className="bg-[#6C60FF] hover:bg-[#5B4FE8] text-white">
            Try Again
          </Button>
        </div>
      </div>
    );
  }

  // Show not found state
  if (!memory) {
    return (
      <div className="w-full space-y-8">
        <div className="flex items-center gap-4">
          <Button variant="ghost" size="sm" onClick={onBack}>
            <ArrowLeft className="w-4 h-4 mr-2" />
            Back
          </Button>
        </div>
        <div className="text-center py-12">
          <h2 className="text-xl font-semibold text-gray-900 mb-2">Memory not found</h2>
          <p className="text-gray-600">The memory you're looking for doesn't exist or has been deleted.</p>
        </div>
      </div>
    );
  }

  // Map API data to UI-expected format with local updates applied
  const uiMemory = apiMemoryData ? {
    id: apiMemoryData.id,
    title: localMemoryUpdates?.title || apiMemoryData.title,
    category: localMemoryUpdates?.category || apiMemoryData.category?.name || 'Personal',
    thumbnail: (apiMemoryData.last_update_img || apiMemoryData.user?.profile_image || 'https://images.unsplash.com/photo-1507525428034-b723cf961d3e?w=400&h=300&fit=crop').replace(/\\\//g, '/'),
    dateRange: localMemoryUpdates?.dateRange || apiMemoryData.dates?.formatted_range || `${apiMemoryData.min_uploaded_img_date || 'Unknown'}`,
    location: {
      primary: localMemoryUpdates?.location || apiMemoryData.location || null
    },
    tags: (localMemoryUpdates?.label ? [localMemoryUpdates.label] : (apiMemoryData.sub_category?.name ? [apiMemoryData.sub_category.name] : [])),
    isPublic: apiMemoryData.published === 1 || false,
    createdDate: apiMemoryData.created_at,
    description: apiMemoryData.description
  } : {
    ...memory,
    tags: []
  };

  // Check if memory has "Suggested" category - make it read-only
  const isSuggestedCategory = uiMemory.category === 'Suggested';

  // Check if viewing as collaborator (for pull-to-refresh)
  const isCollaboratorView = currentUserRole === 'contributor' || currentUserRole === 'viewer' || currentUserRole === 'edit' || currentUserRole === 'view';

  // Check if current user is a collaborator (memory is shared with them)
  const isSharedMemory = apiMemoryData?.collaborator?.some((collab: any) => {
    // Check if current user's email or ID matches any collaborator
    if (!user) return false;

    const collabUser = collab.user;
    if (!collabUser) return false;

    // Match by email or user ID
    return (user.email && collabUser.email === user.email) ||
           (user.id && String(collabUser.id) === String(user.id));
  });

  const CategoryIcon = getCategoryIcon(uiMemory.category);
  const categoryColorHex = isSharedMemory
    ? '#EF4444' // Red color for shared memories
    : getCategoryColor(uiMemory.category, apiCategories.length > 0 ? apiCategories : categories);

  // Transform API posts to match UI expected format with enhanced filtering support
  const transformApiPosts = (apiPosts: any[]) => {
    if (!apiPosts || !Array.isArray(apiPosts)) return [];

    return apiPosts.map((post: any, index: number) => {
      // Debug log for rotation angle
      console.log(`🔄 Post ${post.id}: rotation_angle = ${post.rotation_angle}`);
      // Debug log for title field from API
      console.log(`📝 Post ${post.id}: title from API = "${post.title}", name from API = "${post.name}"`);

      return {
      id: post.id?.toString() || `post_${index}`,
      memoryId: uiMemory.id,
      name: post.name || null, // Preserve the name field from API
      title: post.title || '', // Only use actual title, don't fallback to name
      author: {
        name: post.user?.name || 'Unknown User',
        avatar: post.user?.profile_image ? post.user.profile_image.replace(/\\\//g, '/') : (post.user?.avatar ? post.user.avatar.replace(/\\\//g, '/') : null),
        id: post.user?.id?.toString() || post.user_id?.toString() || null,
        email: post.user?.email || null
      },
      content: post.description || '',
      image: post.image_link ? post.image_link.replace(/\\\//g, '/') : null,
      date: post.capture_date || new Date().toISOString(),
      likes: post.likes_count || 0,
      likes_count: post.likes_count || 0,
      comments: post.comments_count || 0,
      isLiked: post.is_liked || false,
      is_liked: post.is_liked || false,
      shares_count: post.shares_count || 0,
      location: post.location || null,
      tags: Array.isArray(post.tags) ? post.tags : [],
      // Enhanced filtering properties based on actual API structure
      type: post.type || 'image', // image, video, text, etc.
      visibility: post.visibility || 'public',
      category: post.category || null,
      subcategory: post.subcategory || null,
      reactions: post.reactions || [],
      timestamp: post.created_at || post.capture_date || new Date().toISOString(),
      // Additional metadata for filtering
      media_type: post.type || (post.image_link ? 'image' : 'text'),
      has_location: !!(post.location),
      word_count: post.description ? post.description.split(' ').length : 0,
      size: post.file_size || post.size || 0, // Extract file size from API
      capture_time: post.capture_time || null,
      capture_date: post.capture_date || post.created_at || new Date().toISOString(),
      dimensions: post.dimensions || post.image_dimensions || null, // Extract dimensions
      width: post.width || post.image_width || null,
      height: post.height || post.image_height || null,
      city: post.city || null,
      country: post.country || null,
      coordinates: post.coordinates || post.lat_lng || null,
      description: post.description || '', // Explicit description field
      rotation_angle: post.rotation_angle || 0, // Add rotation angle from API
      admin_approval: post.admin_approval, // Preserve admin_approval field for moderation
      parent_id: post.parent_id || null, // Preserve parent_id field for sub-images
      is_featured: post.is_featured || 0 ,// Preserve is_featured field (0 or 1) for featured images
      crop_data: post.crop_data || null, // Preserve crop_data if available
      is_claim: post.is_claim || null, // Preserve is_claim field for claim status
      claim_user_id: post.claim_user_id || null // Preserve claim_user_id field
      };
    });
  };

  // Get posts from API data - now properly extracted from memory object
  const rawApiPosts = apiMemoryData?.posts;
  
  console.log('=== POST DATA EXTRACTION ===');
  console.log('API Memory Data Keys:', Object.keys(apiMemoryData || {}));
  console.log('Raw API Posts Found:', rawApiPosts);
  console.log('Posts Array Length:', Array.isArray(rawApiPosts) ? rawApiPosts.length : 'Not an array');
  console.log('First Post Sample:', rawApiPosts?.[0]);
  console.log('Posts with parent_id:', rawApiPosts?.filter((p: any) => p.parent_id).map((p: any) => ({ id: p.id, parent_id: p.parent_id })));
  console.log('=== END POST DATA EXTRACTION ===');

  const apiPosts = rawApiPosts ? transformApiPosts(rawApiPosts) : [];

  console.log('=== TRANSFORMED POSTS ===');
  console.log('Transformed posts with parent_id:', apiPosts.filter(p => p.parent_id).map(p => ({ id: p.id, parent_id: p.parent_id })));
  console.log('=== END TRANSFORMED POSTS ===');

  console.log('=== ADMIN APPROVAL FILTERING ===');
  apiPosts.forEach(post => {
    console.log(`Post ID: ${post.id}, admin_approval: ${post.admin_approval}`);
  });

  // Filter pending posts for moderation (admin_approval = 0) - these should only appear in moderation tab
  const pendingPosts = rawApiPosts ? rawApiPosts.filter((post: any) => post.admin_approval === 0 || post.admin_approval === '0') : [];
  const pendingPostsCount = pendingPosts.length;

  // Filter out posts with admin_approval = 0 from regular display (media section)
  // Now showing sub-images in media section (not hiding them anymore)
  // Only show approved posts (admin_approval = 1 or undefined/null for backward compatibility)
  const approvedApiPosts = apiPosts.filter(post => {
    const adminApproval = post.admin_approval;
    const parentId = post.parent_id;

    // Show posts that are approved (1) or don't have the field (undefined/null for backward compatibility)
    // Exclude posts with admin_approval = 0 (pending approval)
    if (adminApproval === 0 || adminApproval === '0') {
      console.log(`🚫 Filtering out post ${post.id} - admin_approval = ${adminApproval}`);
      return false; // Hide pending posts from media section
    }

    console.log(`✅ Keeping post ${post.id} - admin_approval = ${adminApproval}, parent_id = ${parentId}`);
    return adminApproval === 1 || adminApproval === '1' || adminApproval === undefined || adminApproval === null;
  });
  console.log('=== END ADMIN APPROVAL FILTERING ===');

  const basePosts = approvedApiPosts;

  // Apply local content and comment count updates
  const memoryPosts = basePosts.map(post => ({
    ...post,
    content: updatedPosts[post.id] || post.content,
    comments: updatedCommentCounts[post.id] !== undefined ? updatedCommentCounts[post.id] : post.comments
  }));

  // Organize images with their sub-images for AddMomentModal
  const memoryImagesWithSubImages = memoryPosts
    .filter(post => !post.parent_id) // Only parent images
    .map(parentPost => {
      // Find all sub-images for this parent
      const subImages = memoryPosts
        .filter(post => post.parent_id?.toString() === parentPost.id?.toString())
        .map(subPost => ({
          id: subPost.id,
          src: subPost.image || '',
          title: subPost.title || subPost.name || 'Untitled'
        }));

      return {
        id: parentPost.id,
        src: parentPost.image || '',
        title: parentPost.title || parentPost.name || 'Untitled',
        subImages: subImages
      };
    });

  console.log('=== MEMORY POSTS ANALYSIS ===');
  console.log('Raw API Posts:', rawApiPosts);
  console.log('Transformed API Posts:', apiPosts);
  console.log('Pending Posts for Moderation (admin_approval=0):', pendingPosts);
  console.log('Pending Posts Count:', pendingPostsCount);
  console.log('Approved Posts (admin_approval=1 or null):', approvedApiPosts);
  console.log('Approved Posts Count:', approvedApiPosts.length);
  console.log('Memory Images with Sub-images:', memoryImagesWithSubImages);
  console.log('Memory posts data:', {
    hasApiPosts: !!rawApiPosts,
    apiPostsCount: apiPosts.length,
    totalPostsCount: memoryPosts.length,
    posts: memoryPosts,
    samplePost: memoryPosts[0],
    postsWithFiltering: memoryPosts.map(post => ({
      id: post.id,
      hasMedia: !!(post.image || post.media_type === 'image'),
      hasLocation: !!(post.location || post.has_location),
      type: post.type || 'unknown',
      media_type: post.media_type,
      likes: post.likes,
      likes_count: post.likes_count,
      comments: post.comments,
      is_liked: post.is_liked,
      shares_count: post.shares_count,
      timestamp: post.timestamp
    }))
  });
  console.log('=== END MEMORY POSTS ANALYSIS ===');

  // Check if current user is the memory owner
  const memoryOwnerId = apiMemoryData?.user_id?.toString()
    || apiMemoryData?.user?.id?.toString()
    || apiMemoryData?.owner_id?.toString()
    || apiMemoryData?.created_by?.toString();
  const currentUserId = (user as any)?.external_user_id?.toString() || user?.id?.toString();
  const isOwner = memoryOwnerId === currentUserId;

  console.log('=== OWNER CHECK ===');
  console.log('Memory Owner ID:', memoryOwnerId);
  console.log('Current User ID:', currentUserId);
  console.log('Is Owner:', isOwner);
  console.log('=== END OWNER CHECK ===');

  // Enhanced filtering and sorting for posts based on timeline filter
  const getFilteredAndSortedPosts = () => {
    // First, apply any updates from updatedPosts state and filter out deleted posts and sub-images
    let filteredPosts = memoryPosts
      .filter(post => !deletedPosts.has(post.id)) // Filter out deleted posts
      .filter(post => !post.parent_id) // Filter out sub-images - only show parent posts on timeline
      .map(post => {
        // Check if this post has an update in updatedPosts
        if (updatedPosts[post.id] !== undefined) {
          return {
            ...post,
            content: updatedPosts[post.id]
          };
        }
        return post;
      });

    // Apply any additional filters here (can be expanded based on API response structure)
    // For example, filter by media type, visibility, etc.

    // Sort posts based on timeline filter
    return filteredPosts.sort((a, b) => {
      // Check if either post has a featured sub-image
      const aHasFeaturedSubImage = memoryPosts.some(p =>
        p.parent_id?.toString() === a.id?.toString() && (p.is_featured === 1 || p.is_featured === true)
      );
      const bHasFeaturedSubImage = memoryPosts.some(p =>
        p.parent_id?.toString() === b.id?.toString() && (p.is_featured === 1 || p.is_featured === true)
      );

      // Posts with featured sub-images come first
      if (aHasFeaturedSubImage && !bHasFeaturedSubImage) return -1;
      if (!aHasFeaturedSubImage && bHasFeaturedSubImage) return 1;

      // Apply normal sorting
      switch (timelineFilter) {
        case "latest":
          // Sort by capture_date (newest first)
          const aTime = new Date(a.capture_date || a.date || a.timestamp).getTime();
          const bTime = new Date(b.capture_date || b.date || b.timestamp).getTime();
          return bTime - aTime;
        case "oldest":
          // Sort by capture_date (oldest first)
          const aTimeOld = new Date(a.capture_date || a.date || a.timestamp).getTime();
          const bTimeOld = new Date(b.capture_date || b.date || b.timestamp).getTime();
          return aTimeOld - bTimeOld;
        case "fewer_comments":
          // Sort by fewer comments first
          return (a.comments || 0) - (b.comments || 0);
        case "most_comments":
          // Sort by most comments first
          return (b.comments || 0) - (a.comments || 0);
        default:
          return 0;
      }
    });
  };

  const sortedTimelinePosts = getFilteredAndSortedPosts();

  // Helper function to extract filename from URL or generate one
  const getFileNameFromPost = (post: any) => {
    // First priority: Check if posts array has a name field
    if (post.name && post.name.trim()) {
      return post.name;
    }
    
    // Second priority: Extract from image_link if available
    if (post.image) {
      // Try to extract filename from URL
      const urlParts = post.image.split('/');
      const filename = urlParts[urlParts.length - 1];
      
      // If filename has proper extension, use it
      if (filename && (filename.includes('.jpg') || filename.includes('.jpeg') || filename.includes('.png') || filename.includes('.gif'))) {
        return filename;
      }
      
      // Otherwise generate filename from author and date
      const dateStr = (post.capture_date || post.date || new Date().toISOString()).split('T')[0];
      return `${post.author.name.replace(/\s+/g, '_')}_${dateStr}.jpg`;
    }
    
    // For text posts
    return `Text_Post_${post.id}.txt`;
  };

  // Helper function to format file size
  const formatFileSize = (bytes: number | string): string => {
    const size = typeof bytes === 'string' ? parseInt(bytes) || 0 : bytes;
    if (size === 0) return '2.4 MB'; // Default size if not provided
    
    const k = 1024;
    const sizes = ['B', 'KB', 'MB', 'GB'];
    const i = Math.floor(Math.log(size) / Math.log(k));
    return parseFloat((size / Math.pow(k, i)).toFixed(1)) + ' ' + sizes[i];
  };

  // Helper function to extract or estimate image dimensions
  const getImageDimensions = (post: any): string => {
    // Check if dimensions are provided in the API
    if (post.dimensions) return post.dimensions;
    if (post.width && post.height) return `${post.width}×${post.height}`;
    
    // Default dimensions based on type
    if (post.media_type === 'video') return '1920×1080';
    if (post.image) return '4032×3024'; // Common phone camera dimensions
    
    return undefined;
  };

  // Transform posts to media items for the media section
  const transformPostsToMediaItems = (posts: any[]) => {
    return posts.map((post) => {
      // Get the type from the post - this could be 'fb', 'facebook', 'instagram', 'image', 'video', 'text'
      const rawType = post.type || 'image';
      let mediaType: 'image' | 'video' | 'text' = 'image';
      let sourcePlatform: string | null = null;

      // Check if type indicates a platform (fb, facebook, instagram, etc.)
      if (rawType.toLowerCase() === 'fb' || rawType.toLowerCase() === 'facebook') {
        mediaType = 'image'; // It's an image from Facebook
        sourcePlatform = 'facebook'; // Use 'facebook' as the source
      } else if (rawType.toLowerCase() === 'instagram') {
        mediaType = 'image';
        sourcePlatform = 'instagram';
      } else if (['image', 'video', 'text'].includes(rawType.toLowerCase())) {
        mediaType = rawType.toLowerCase() as 'image' | 'video' | 'text';
        sourcePlatform = null; // No platform source
      } else {
        // Unknown type, treat as platform source
        mediaType = 'image';
        sourcePlatform = rawType;
      }

      const imageUrl = post.image_link || post.image || null;

      // Get the file name, and if this is a sub-image, prepend parent image name for display
      let itemName = getFileNameFromPost(post);
      const originalName = itemName; // Store original name without parent prefix

      // Check if this post has a parent_id (meaning it's a sub-image)
      if (post.parent_id) {
        // Find the parent post
        const parentPost = posts.find(p => p.id?.toString() === post.parent_id?.toString());
        if (parentPost) {
          const parentName = getFileNameFromPost(parentPost);
          // Truncate parent name to max 10 chars to ensure "/" is visible on card
          const truncatedParentName = parentName.length > 10 ? parentName.substring(0, 10) + '...' : parentName;
          itemName = `${truncatedParentName} / ${itemName}`; // Display name with parent prefix
          console.log(`📎 Sub-image detected: ${post.id}, parent: ${post.parent_id}, name: ${itemName}`);
        }
      }

      const mediaItem = {
        id: post.id,
        name: itemName, // Display name (with parent prefix for sub-images)
        originalName: originalName, // Original name without prefix
        title: post.title || '', // Post title from API
        thumbnail: imageUrl,
        image: imageUrl,
        type: mediaType,
        size: formatFileSize(post.size || (imageUrl ? 2515456 : 1024)),
        date: post.capture_date || post.timestamp || post.date || new Date().toISOString(),
        location: post.location ? {
          displayName: post.location,
          city: post.city,
          country: post.country,
          coordinates: post.coordinates || { lat: 0, lng: 0 }
        } : undefined,
        author: {
          name: (post.user || post.author)?.name || 'Unknown',
          avatar: (post.user || post.author)?.avatar || (post.user || post.author)?.profile_image || '',
          id: (post.user || post.author)?.id?.toString() || (post.user || post.author)?.user_id?.toString()
        },
        content: post.content,
        description: post.description || post.content || '',
        dimensions: getImageDimensions(post),
        labels: post.tags || [],
        rotation_angle: post.rotation_angle || 0,
        source: sourcePlatform,
        parent_id: post.parent_id, // Include parent_id so we can detect sub-images
        is_featured: post.is_featured || 0 // Include is_featured for sorting
      };

      console.log(`🖼️ Media Item ${post.id}: type="${post.type}" -> source="${sourcePlatform}"`);

      return mediaItem;
    });
  };

  const mediaItems = transformPostsToMediaItems(memoryPosts);

  // Sort media items
  const sortMediaItems = (items: any[], sortBy: string, order: 'asc' | 'desc') => {
    return [...items].sort((a, b) => {
      // Featured images always come first
      const aIsFeatured = a.is_featured === 1 || a.is_featured === true;
      const bIsFeatured = b.is_featured === 1 || b.is_featured === true;

      if (aIsFeatured && !bIsFeatured) return -1;
      if (!aIsFeatured && bIsFeatured) return 1;

      // If both or neither are featured, apply normal sorting
      let comparison = 0;

      switch (sortBy) {
        case 'date':
          comparison = new Date(a.date).getTime() - new Date(b.date).getTime();
          break;
        case 'name':
          comparison = a.name.localeCompare(b.name);
          break;
        case 'size':
          const aSize = typeof a.size === 'string' ? parseInt(a.size) : a.size;
          const bSize = typeof b.size === 'string' ? parseInt(b.size) : b.size;
          comparison = aSize - bSize;
          break;
        default:
          return 0;
      }

      return order === 'asc' ? comparison : -comparison;
    });
  };

  const filteredAndSortedMediaItems = sortMediaItems(mediaItems, mediaSortBy, mediaSortOrder);

  const handleCopyLink = async () => {
    try {
      await navigator.clipboard.writeText(`https://stasht.app/memory/${uiMemory.id}`);
      setCopiedLink(true);
      toast.success("Link copied to clipboard");
      setTimeout(() => setCopiedLink(false), 2000);
    } catch (err) {
      toast.error("Failed to copy link");
    }
  };

  const handleEdit = async () => {
    await fetchCategoriesAndLabels();
    setIsEditPopoverOpen(true);
  };

  const handleEditSave = async () => {
    try {
      setIsUpdatingMemory(true);
      
      // Find category ID from API categories
      const foundCategory = apiCategories.find(cat => cat.name === editData.category);
      const categoryId = foundCategory?.id || null;
      console.log('Selected category:', editData.category, 'Found category:', foundCategory, 'Category ID:', categoryId);

      // Normalize date range format to "M d, Y" (e.g., "Oct 9, 2025")
      const normalizeDateRange = (dateRange: string): string => {
        if (!dateRange) return dateRange;

        // Parse and reformat the date range
        const rangeMatch = dateRange.match(/(.+?)\s*-\s*(.+)/);

        if (rangeMatch) {
          const startStr = rangeMatch[1].trim();
          const endStr = rangeMatch[2].trim();

          // If end is "Present" or "Ongoing", keep it as-is
          if (endStr.toLowerCase().includes("present") || endStr.toLowerCase().includes("ongoing")) {
            const startDate = new Date(startStr);
            if (!isNaN(startDate.getTime())) {
              return `${startDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })} - Present`;
            }
          } else {
            // Parse both dates and reformat
            const startDate = new Date(startStr);
            const endDate = new Date(endStr);

            if (!isNaN(startDate.getTime()) && !isNaN(endDate.getTime())) {
              const formatDate = (date: Date) =>
                date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });

              return `${formatDate(startDate)} - ${formatDate(endDate)}`;
            }
          }
        } else {
          // Single date
          const singleDate = new Date(dateRange);
          if (!isNaN(singleDate.getTime())) {
            return singleDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
          }
        }

        // Return original if parsing fails
        return dateRange;
      };

      // Prepare data for API call
      const updateData = {
        title: editData.title,
        category_id: categoryId,
        sub_category_id: apiLabels.find(label => label.name === editData.label)?.id || null,
        date_range: normalizeDateRange(editData.dateRange),
        location: editData.location
      };

      console.log('Updating memory with data:', updateData);
      
      const response = await dashboardAPI.updateMemory(memoryId, updateData);
      
      if (response.success) {
        toast.success("Memory updated successfully!");
        setIsEditPopoverOpen(false);
        
        // Trigger memory counts refresh since updating memory may affect counts
        await triggerMemoryCountsRefresh();
        
        // Refresh the full memory details page
        await fetchMemoryDetails();
        
        // Also refresh related data
        if (onRefresh) {
          onRefresh();
        }
      } else {
        toast.error(response.error || "Failed to update memory");
      }
    } catch (error) {
      console.error('Error updating memory:', error);
      toast.error("Failed to update memory");
    } finally {
      setIsUpdatingMemory(false);
    }
  };

  const handleEditCancel = () => {
    // Reset to original values from API data
    if (apiMemoryData) {
      setEditData({
        title: apiMemoryData.title || "",
        category: apiMemoryData.category?.name || "",
        label: apiMemoryData.sub_category?.name || "",
        dateRange: apiMemoryData.dates?.formatted_range || "",
        location: apiMemoryData.location || ""
      });
    }
    setIsEditPopoverOpen(false);
  };

  const handleDeleteConfirm = async () => {
    setIsDeleting(true);
    try {
      console.log(`Deleting memory ${memoryId}...`);
      const response = await dashboardAPI.deleteMemory(memoryId);
      
      if (response.success) {
        console.log('Memory deleted successfully');
        setShowDeleteDialog(false);
        toast.success("Memory deleted successfully!");

        // Recheck memory limit and refresh page
        await recheckMemoryLimit();

        // Trigger memory counts refresh
        await triggerMemoryCountsRefresh();

        // Refresh the parent component if handler provided BEFORE navigating back
        if (onRefresh) {
          console.log('🔄 Calling onRefresh after memory deletion from details page');
          await onRefresh();
          console.log('✅ Memory details page refresh completed');
        } else {
          console.warn('⚠️ onRefresh function not available');
        }

        // Force immediate secondary refresh for real-time updates
        console.log('🔄 Secondary refresh attempt for real-time updates from details page');
        await checkLimit();
        if (onRefresh) {
          await onRefresh();
        }

        // Navigate back to memories list
        onBack();
      } else {
        console.error('Failed to delete memory:', response.error);
        toast.error(`Failed to delete memory: ${response.error || 'Unknown error'}`);
      }
    } catch (error) {
      console.error('Error deleting memory:', error);
      toast.error('An error occurred while deleting the memory');
    } finally {
      setIsDeleting(false);
    }
  };

  const handlePublish = async (roleOverride?: number) => {
    // Check if memory is published (published can be 1, 2, or 3)
    const isCurrentlyPublished = apiMemoryData?.published && (apiMemoryData.published === 1 || apiMemoryData.published === 2 || apiMemoryData.published === 3);
    setIsPublishing(true);
    setPublishProgress(0);
    
    try {
      if (isCurrentlyPublished) {
        // Unpublish the memory
        console.log(`=== UNPUBLISH MEMORY ===`);
        console.log(`Unpublishing memory ID: ${memoryId}`);
        
        // Call the API to unpublish the memory
        const response = await mediaAPI.unpublishMemory(memoryId);
        
        if (response.success) {
          // Update local memory data to reflect unpublished status
          if (apiMemoryData) {
            const updatedMemoryData = {
              ...apiMemoryData,
              published: null, // or 0, depending on your API
              published_url: null
            };
            setApiMemoryData(updatedMemoryData);
          }
          
          // Trigger memory counts refresh since unpublishing affects published memory count
          await triggerMemoryCountsRefresh();
          
          setIsPublishing(false);
          toast.success("Memory unpublished successfully!");
        } else {
          setIsPublishing(false);
          toast.error(`Failed to unpublish memory: ${response.error || 'Unknown error'}`);
        }
      } else {
        // Publish the memory
        // Show progress steps
        const progressSteps = [
          { step: 25, message: "Preparing memory..." },
          { step: 50, message: "Uploading to server..." },
          { step: 75, message: "Setting up sharing..." }
        ];
        
        for (const { step, message } of progressSteps) {
          await new Promise(resolve => setTimeout(resolve, 300));
          setPublishProgress(step);
          toast.info(message);
        }
        
        // Make the actual API call
        console.log(`=== PUBLISH MEMORY API CALL ===`);
        console.log(`Publishing memory ID: ${memoryId}`);
        console.log(`API URL: /memories/${memoryId}/publish`);

        // Use roleOverride if provided, otherwise map from selectedPublishOption
        // view-only = 2, public = 1, private = 3
        let role = roleOverride;
        if (!role) {
          role = 1; // default to public
          if (selectedPublishOption === 'view-only') {
            role = 2;
          } else if (selectedPublishOption === 'public') {
            role = 1;
          } else if (selectedPublishOption === 'private') {
            role = 3;
          }
        }

        console.log(`Publishing with role: ${role} (selectedPublishOption: ${selectedPublishOption}, roleOverride: ${roleOverride})`);

        const response = await dashboardAPI.publishMemory(memoryId, role);
        console.log('Publish API Response:', response);

        if (response.success) {
          setPublishProgress(100);

          // Get the published URL from API response
          // Priority: API response link > published_url > generated URL from slug
          let publishedLink;

          if (response.data?.link) {
            // Use the link directly from API response
            publishedLink = response.data.link;
            console.log('Using link from API response:', publishedLink);
          } else if (response.data?.published_url) {
            // Use the published_url from API response as fallback
            publishedLink = response.data.published_url;
            console.log('Using published_url from API response:', publishedLink);
          } else {
            // Generate published URL from slug as last resort
            const memorySlug = response.data?.slug || apiMemoryData?.slug || memoryId;
            const baseUrl = window.location.origin;
            publishedLink = `${baseUrl}/published-memory/${memorySlug}`;
            console.log('Generated published URL from slug:', publishedLink);
          }

          setPublishedUrl(publishedLink);

          // Immediately update apiMemoryData with the published status and URL
          // This ensures the share buttons have access to the data right away
          if (apiMemoryData) {
            const updatedMemoryData = {
              ...apiMemoryData,
              published: role,
              published_url: publishedLink
            };
            setApiMemoryData(updatedMemoryData);
            console.log('Updated apiMemoryData with published_url:', publishedLink);
          }

          // Refresh memory details to get the latest data
          await fetchMemoryDetails();

          // Trigger memory counts refresh since publishing affects published memory count
          await triggerMemoryCountsRefresh();

          setIsPublishing(false);
          setIsPublishModalOpen(true);
          toast.success("Memory published successfully!");
        } else {
          throw new Error(response.error || 'Failed to publish memory');
        }
      }
    } catch (error) {
      console.error('Error publishing/unpublishing memory:', error);
      setIsPublishing(false);
      setPublishProgress(0);
      toast.error(isCurrentlyPublished ? "Failed to unpublish memory. Please try again." : "Failed to publish memory. Please try again.");
    }
  };

  const handleCopyPublishLink = async () => {
    try {
      await navigator.clipboard.writeText(publishedUrl);
      setCopiedPublishLink(true);
      toast.success("Link copied to clipboard");
      setTimeout(() => setCopiedPublishLink(false), 2000);
    } catch (err) {
      toast.error("Failed to copy link");
    }
  };

  const handleEmailShare = () => {
    const authorName = apiMemoryData?.user?.name || 'Unknown';
    const subject = encodeURIComponent(`${uiMemory.title} by ${authorName}`);
    const body = encodeURIComponent(`${uiMemory.title}\n\nShared by ${authorName}\n\nCheck it out: ${publishedUrl}`);
    window.open(`mailto:?subject=${subject}&body=${body}`, '_blank');
  };

  const handleTwitterShare = () => {
    const authorName = apiMemoryData?.user?.name || 'Unknown';
    const description = uiMemory.description ? `\n\n${uiMemory.description.substring(0, 100)}` : '';
    const postText = `${uiMemory.title}\n\nShared by ${authorName}${description}`;
    window.open(`https://twitter.com/intent/tweet?text=${encodeURIComponent(postText)}&url=${encodeURIComponent(publishedUrl)}`, '_blank');
  };

  const handleFacebookShare = () => {
    const authorName = apiMemoryData?.user?.name || 'Unknown';
    const postText = `${uiMemory.title}\n\nShared by ${authorName}${uiMemory.description ? `\n\n${uiMemory.description.substring(0, 150)}` : ''}\n\n${publishedUrl}`;
    // Copy to clipboard since Facebook doesn't allow pre-filling post text
    navigator.clipboard.writeText(postText).then(() => {
      // Show alert so user knows content is copied before Facebook opens
      alert("Memory details copied to clipboard!\n\nPress Ctrl+V (or Cmd+V) to paste in your Facebook post.");
      // Open Facebook after user dismisses alert
      window.open(`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(publishedUrl)}`, '_blank');
    }).catch(() => {
      window.open(`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(publishedUrl)}`, '_blank');
    });
  };

  const handleUploadFromDesktop = () => {
    console.log('🖼️ Upload from Desktop clicked');
    setIsCoverPhotoMenuOpen(false);

    // Create a hidden file input element
    const fileInput = document.createElement('input');
    fileInput.type = 'file';
    fileInput.accept = 'image/*';
    fileInput.style.display = 'none';

    fileInput.onchange = async (e: Event) => {
      console.log('📁 File input changed');
      const target = e.target as HTMLInputElement;
      const file = target.files?.[0];

      if (!file) {
        console.log('❌ No file selected');
        return;
      }

      console.log('✅ File selected:', file.name, file.size, file.type);

      // Validate file type
      if (!file.type.startsWith('image/')) {
        toast.error('Please select an image file');
        return;
      }

      // Validate file size (max 10MB)
      const maxSize = 10 * 1024 * 1024; // 10MB
      if (file.size > maxSize) {
        toast.error('Image size must be less than 10MB');
        return;
      }

      try {
        console.log('🚀 Starting cover photo upload...');
        console.log('Memory ID:', memoryId);
        toast.loading('Uploading cover photo...');

        // Create FormData for multipart upload
        const formData = new FormData();
        formData.append('_method', 'PUT'); // Laravel method override
        formData.append('last_update_img', file);

        console.log('📦 FormData created with:');
        for (let [key, value] of formData.entries()) {
          if (value instanceof File) {
            console.log(`  ${key}:`, value.name, value.size, value.type);
          } else {
            console.log(`  ${key}:`, value);
          }
        }

        // Get auth token
        const token = tokenUtils.getToken();
        console.log('🔑 Token exists:', !!token);

        const headers: Record<string, string> = {};
        if (token) {
          headers.Authorization = `Bearer ${token}`;
        }

        // Get API base URL
        const getApiBaseUrl = () => {
          if (import.meta.env.VITE_API_BASE_URL) {
            return import.meta.env.VITE_API_BASE_URL;
          }
          if (import.meta.env.DEV) {
            return '/api/react';
          }
          return `${window.location.origin}/api/react`;
        };

        const apiBaseUrl = getApiBaseUrl();
        const apiUrl = `${apiBaseUrl}/memories/${memoryId}`;

        console.log('🌐 API URL:', apiUrl);
        console.log('📤 Request headers:', headers);
        console.log('📤 Request method: POST (with _method=PUT)');

        // Call the PUT /memories/{id} API
        const response = await fetch(apiUrl, {
          method: 'POST', // Use POST with _method=PUT for FormData
          headers: headers,
          body: formData,
        });

        console.log('📨 Response status:', response.status);
        console.log('📨 Response ok:', response.ok);

        const data = await response.json();
        console.log('📨 Response data:', data);

        if (response.ok && data.success) {
          toast.dismiss();
          toast.success('Cover photo updated successfully!');

          // Refresh memory details to show new cover photo
          console.log('🔄 Refreshing memory details...');
          await fetchMemoryDetails();

          // Refresh memories list on parent page
          console.log('🔄 Refreshing memories list...');
          if (onRefresh) {
            await onRefresh();
          }
        } else {
          toast.dismiss();
          toast.error(data.message || data.error || 'Failed to update cover photo');
        }
      } catch (error) {
        console.error('❌ Error uploading cover photo:', error);
        toast.dismiss();
        toast.error('Failed to upload cover photo. Please try again.');
      }
    };

    // Append to body temporarily to ensure it works
    document.body.appendChild(fileInput);

    // Trigger file selection
    console.log('🖱️ Triggering file input click...');
    fileInput.click();

    // Remove from body after a short delay
    setTimeout(() => {
      document.body.removeChild(fileInput);
    }, 1000);
  };

